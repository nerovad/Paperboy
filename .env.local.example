# .env.local -- settings that belong to this machine or to you.
#
# Copy to .env.local and uncomment what you need. It is gitignored, bin/env-pull
# never writes it, and anything set here wins over the same name in .env, which
# is a verbatim copy of LockBox/Paperboy.env.
#
# If a value is the same for everyone, it belongs in LockBox, not here.

# This machine's own application database. LockBox names Paperboy_Dev.
# PAPERBOY_DATABASE=Paperboy_Local

# Scratch base for rake test. Never Paperboy_Dev, staging or production.
# PAPERBOY_TEST_DATABASE=Paperboy_TestLocal

# When GSASQL16 cannot be resolved.
# GSABSS_HOST=10.135.204.161

# Where development mail is intercepted to.
# DEV_EMAIL=you@example.com

# The address this machine answers on.
# APP_HOST=https://localhost

# Kerberos ticket cache for SQL Server auth.
# KRB5CCNAME=FILE:/tmp/krb5cc_1000

# DAM roots and watch folders on this machine.
# PAPERBOY_DAM_ROOTS=

# Personal Gitea token for bin/new-issue, bin/worktree and bin/status-report.
# GITEA_TOKEN=

# Written by bin/tag-master-commit.
# PAPERBOY_VERSION=
