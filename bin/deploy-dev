#!/bin/bash
set -e

APP_DIR="/home/matthew/gitea/Paperboy"
BRANCH="${1:-master}"
cd "$APP_DIR"

echo "==> Fetching and checking out branch: $BRANCH ..."
git fetch origin
git checkout "$BRANCH"
git pull origin "$BRANCH"

echo "==> Installing gems (including development/test)..."
bundle install

# development.rb sets config.assets.debug = true, so Sprockets resolves assets
# live from source and never reads a precompiled manifest. Precompiling here
# would be dead weight -- and the stale manifest it leaves behind is what used
# to force an assets:clobber before CSS edits became visible. Dart Sass output
# is gitignored, so it does still need to be built once after a checkout.
echo "==> Building CSS with Dart Sass..."
RAILS_ENV=development bundle exec rails dartsass:build

echo "==> Restarting Puma..."
sudo systemctl restart paperboy-dev

echo "==> Restarting Sidekiq..."
sudo systemctl restart paperboy-dev-sidekiq

echo "==> Dev deploy complete!"
