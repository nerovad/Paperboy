#!/bin/bash
set -e

APP_DIR="/home/matthew/gitea/Paperboy"
BRANCH="${1:-master}"
cd "$APP_DIR"

# Installs a unit file unless /etc/systemd/system already symlinks straight at
# the repo copy, where git pull has updated it already and cp would fail with
# "are the same file" — aborting the deploy under set -e, after the migrations
# have run but before anything restarts.
sync_unit() {
  local src="$APP_DIR/config/systemd/$1"
  local dst="/etc/systemd/system/$1"
  if [ "$(readlink -f "$src")" = "$(readlink -f "$dst")" ]; then
    echo "    $1 already links to the repo copy"
  else
    sudo cp "$src" "$dst"
  fi
}

echo "==> Fetching and checking out branch: $BRANCH ..."
git fetch origin
git checkout "$BRANCH"
git pull origin "$BRANCH"

echo "==> Installing gems (including development/test)..."
bundle install

# Runs the suite before anything on this box changes: a red run stops the
# deploy ahead of the migrations, the ACL push and the restart.
#
# .env names a PAPERBOY_TEST_DATABASE this box's login cannot open, so the
# suite gets a scratch base of its own, created on first use and kept for the
# next deploy. It only anchors the run -- test_helper.rb creates and drops a
# schema-loaded database per worker beside it. Never point it at Paperboy_Dev:
# the suite loads the schema into its target. dotenv never overrides a
# variable already set, so this name wins over the one in .env.
#
# The default name carries the SQL login, because a base another login created
# is one this login cannot open: on 2026-09-22 GSAETL created a shared
# Paperboy_DeployTest first, and every later deploy here died on "not able to
# access the database". A named base that exists but will not open aborts here,
# with the owner, rather than inside rake test.
#
#   NO_TESTS=1                  skip the suite
#   DEPLOY_TEST_DATABASE=name   use a different scratch base
if [ -n "$NO_TESTS" ]; then
  echo "==> Skipping test suite (NO_TESTS set)"
else
  echo "==> Ensuring scratch test database exists..."
  DEPLOY_TEST_DATABASE="$(
    set -o pipefail
    DEPLOY_TEST_DATABASE="$DEPLOY_TEST_DATABASE" RAILS_ENV=development bundle exec rails runner '
      conn = ActiveRecord::Base.connection
      name = ENV["DEPLOY_TEST_DATABASE"].presence ||
             "Paperboy_DeployTest_#{conn.select_value("SELECT SUSER_SNAME()").gsub(/\W+/, "_")}"
      conn.execute(<<~SQL)
        IF DB_ID(#{conn.quote(name)}) IS NULL
          CREATE DATABASE #{conn.quote_table_name(name)} COLLATE SQL_Latin1_General_CP1_CI_AS
      SQL
      unless conn.select_value("SELECT HAS_DBACCESS(#{conn.quote(name)})") == 1
        owner = conn.select_value("SELECT SUSER_SNAME(owner_sid) FROM sys.databases WHERE name = #{conn.quote(name)}")
        abort "!!! #{name} exists but is owned by #{owner}, and this login cannot open it.\n" \
              "!!! Set DEPLOY_TEST_DATABASE to another name, or have #{owner} drop it."
      end
      puts name
    ' | tail -n1
  )"
  echo "    using $DEPLOY_TEST_DATABASE"

  echo "==> Running test suite..."
  PAPERBOY_TEST_DATABASE="$DEPLOY_TEST_DATABASE" bundle exec rake test
fi

# dotenv-rails loads .env for every rails command below. .env names
# Paperboy_Dev, which is also what database.yml defaults development to.
#
# Rails runs every development db task against the test config as well, which
# names Paperboy_Test -- a database this box's login cannot open and a deploy
# has no business touching. SKIP_TEST_DATABASE turns that off.
echo "==> Preparing application and Solid adapter databases..."
SKIP_TEST_DATABASE=1 RAILS_ENV=development bundle exec rails db:prepare

# Each environment keeps uploads under its own storage/ root. Copies the files
# this database references out of the shared pre-split folder; idempotent.
# See lib/tasks/storage.rake.
echo "==> Adopting pre-split Active Storage files..."
RAILS_ENV=development bundle exec rails storage:adopt_legacy

# Dev is the source of truth for the ACL: groups, their permission grants, the
# org-level grants and who is in which group. None of it travels between the
# three databases on its own — Groups, Group_Permissions, org_permissions and
# Employee_Groups all live in each Paperboy_* database — so a group built on the
# dev ACL screen reaches stage and prod only by riding in db/acl.yml, which
# bin/deploy-stage and bin/deploy apply with `rails acl:sync`. This block is the
# dump half: it unions dev's ACL into the file and pushes it, so the next
# stage/prod deploy picks it up. See lib/tasks/acl.rake.
#
# Form definitions ride along in db/forms.yml for exactly the same reason: the
# form builder writes .erb views, which travel through git, and form_templates,
# form_fields and workflow rows (statuses, routing, emails), which travel
# nowhere on their own. The two files are
# dumped and committed together so a form and the ACL that opens it cannot land
# in stage or prod one deploy apart. See lib/tasks/forms.rake.
#
#   NO_ACL=1   skip the block entirely (both files)
#   ACL_YES=1  do not pause for confirmation when new org grants appear
if [ -n "$NO_ACL" ]; then
  echo "==> Skipping ACL dump (NO_ACL set)"
else
  echo "==> Dumping ACL and form definitions to db/acl.yml and db/forms.yml..."

  # A commit needs an author. Fail here rather than three commands later.
  if [ -z "$(git config user.email)" ]; then
    echo "!!! git user.email is not set on this box — cannot commit db/acl.yml" >&2
    exit 1
  fi

  # Anything already staged would be swept into the commit below, which commits
  # by path. Refuse rather than author a commit nobody meant to make.
  if ! git diff --cached --quiet; then
    echo "!!! staged changes present — commit or reset them before deploying" >&2
    exit 1
  fi

  # Counted before the dump, while the file still lacks them. org grants are the
  # broadest thing in the ACL — one row can open a form to a whole agency — so
  # they get a second look before being pushed toward production.
  NEW_ORG="$(RAILS_ENV=development bundle exec rails acl:org_delta |
             grep -m1 'org grants' | cut -d' ' -f1 || true)"

  RAILS_ENV=development bundle exec rails acl:dump MERGE=1
  RAILS_ENV=development bundle exec rails forms:dump MERGE=1

  if git diff --quiet -- db/acl.yml db/forms.yml; then
    echo "    db/acl.yml and db/forms.yml already match this database — nothing to push"
  else
    echo "==> db/acl.yml and db/forms.yml diff:"
    git --no-pager diff -- db/acl.yml db/forms.yml

    if [ "${NEW_ORG:-0}" != "0" ] && [ -z "$ACL_YES" ] && [ -t 0 ]; then
      echo
      echo "    ^ $NEW_ORG org grant(s) above are new and will reach production."
      read -r -p "    Commit and push db/acl.yml and db/forms.yml? [y/N] " reply
      case "$reply" in
        [yY]*) ACL_PUSH=1 ;;
        *) ACL_PUSH=""
           git checkout -- db/acl.yml db/forms.yml
           echo "!!! ACL and form dump discarded — stage and prod will not see them." >&2
           echo "!!! Continuing with the dev deploy." >&2 ;;
      esac
    fi

    if [ "${ACL_PUSH-1}" = "1" ]; then
      git commit -q -m "Sync ACL and form definitions from dev" -- db/acl.yml db/forms.yml
      # A rejected push is not fatal: dev deploys off this checkout either way
      # and the commit is sitting here to be pushed by hand. But stage and prod
      # stay unaware of these grants until it lands, so say so loudly.
      if git push origin "$BRANCH"; then
        echo "    db/acl.yml and db/forms.yml pushed — bin/deploy-stage and bin/deploy will sync them"
      else
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >&2
        echo "!!! db/acl.yml and db/forms.yml are COMMITTED BUT NOT PUSHED to $BRANCH." >&2
        echo "!!! Stage and prod will not receive these changes until they are." >&2
        echo "!!! Resolve and run: git push origin $BRANCH" >&2
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >&2
      fi
    fi
  fi
fi

# nginx serves /assets/ straight from disk on this box (see
# config/nginx/dev-gsa-forms) and never falls back to Rails, so the digested
# files have to exist in public/assets or every stylesheet and script 404s.
# assets:precompile runs dartsass:build first, and assets:clobber runs
# dartsass:clobber, so the Dart Sass output is covered by both.
echo "==> Clobbering old assets..."
RAILS_ENV=development bundle exec rails assets:clobber

echo "==> Precompiling assets..."
RAILS_ENV=development bundle exec rails assets:precompile

echo "==> Syncing systemd units..."
sync_unit paperboy-dev.service
sync_unit paperboy-dev-jobs.service
sudo systemctl daemon-reload

echo "==> Restarting Puma..."
sudo systemctl restart paperboy-dev

echo "==> Restarting Solid Queue..."
sudo systemctl disable --now paperboy-dev-sidekiq 2>/dev/null || true
sudo systemctl enable paperboy-dev-jobs
sudo systemctl restart paperboy-dev-jobs

echo "==> Dev deploy complete!"
