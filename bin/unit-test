#!/usr/bin/env bash

set -o pipefail

test_target="${1:-test}"
summary_file="$(mktemp)"
trap 'rm -f "$summary_file"' EXIT

status=0

{
  # A linked worktree lives under worktrees/, which the main checkout
  # excludes. RuboCop merges that parent Exclude and would inspect nothing.
  bundle exec rubocop --ignore-parent-exclusion || status=$?
  bundle exec brakeman || status=$?
  bundle exec bundle-audit check || status=$?
  bundle exec rails test "$test_target" || status=$?
} > error.log 2>&1

rg -i -N '(\(Finished|runs|assertions|failures|errors|offenses?|warnings?|vulnerabilit(y|ies)|insecure|error)' error.log > "$summary_file"
cat "$summary_file" >> error.log

exit "$status"
