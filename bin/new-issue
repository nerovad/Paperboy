#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "${script_dir}/.." && pwd -P)"
# shellcheck disable=SC1091
source "${script_dir}/gitea-common"

issue_type=''
title=''
body=''
body_file=''
answers_file=''
milestone_title=''
project_title=''
no_milestone=false
no_project=false
create_worktree=false
show_fields=false
default_project='Powerpuff Girls'
extra_labels=()

# --type owns bug, feature, chore, and infrastructure.
refuse_extra_type_labels() {
  local label_name refused=false
  for label_name in "${extra_labels[@]+"${extra_labels[@]}"}"; do
    case "${label_name}" in
      bug|feature|chore|infrastructure)
        echo "Type labels come from --type: ${label_name}" >&2
        refused=true
        ;;
    esac
  done
  [[ "${refused}" == false ]] || exit 2
}

issue_template() {
  command -v ruby >/dev/null 2>&1 || {
    echo 'Required command not found: ruby' >&2
    return 1
  }
  ruby "${repo_root}/lib/paperboy/gitea/issue_template.rb" "$@"
}

validate_body() {
  local draft
  draft="$(mktemp)"
  printf '%s' "${body}" >"${draft}"
  if ! issue_template validate-body --type "${issue_type}" --body-file "${draft}"; then
    rm -f "${draft}"
    exit 2
  fi
  rm -f "${draft}"
}

usage() {
  cat <<EOF
Usage: bin/new-issue [OPTIONS]

Create a Paperboy Gitea issue. Missing required values are prompted when
stdin is a terminal. The body must follow the issue template for --type.
Pass --answers-file, --body, or --body-file. --fields prints the section ids.

Options:
  --type TYPE          bug, feature, chore, or infrastructure
  --title TITLE        Issue title
  --answers-file PATH  JSON answers keyed by the template section ids
  --body TEXT          Complete Markdown issue body
  --body-file PATH     Read the Markdown body from PATH
  --fields             Print the template fields and exit
  --label NAME         Add a label other than the type label (repeatable)
  --milestone TITLE    Assign a milestone
  --no-milestone       Do not prompt for a milestone
  --project TITLE      Assign a project (default: ${default_project})
  --no-project         Do not assign a project
  --worktree           Create the issue worktree after creation
  --url URL            Override the Gitea base URL
  --owner NAME         Override the repository owner
  --repository NAME    Override the repository name
  -h, --help           Show this help

The type label comes from --type. --label refuses bug, feature, chore,
and infrastructure. The issue is created in one request after every
label, milestone, and project name has been resolved. After creation,
use the suggested issue-linked branch with bin/wt.
EOF
}

while (($#)); do
  case "$1" in
    --type) issue_type="$2"; shift 2 ;;
    --title) title="$2"; shift 2 ;;
    --answers-file) answers_file="$2"; shift 2 ;;
    --body) body="$2"; shift 2 ;;
    --body-file) body_file="$2"; shift 2 ;;
    --fields) show_fields=true; shift ;;
    --label) extra_labels+=("$2"); shift 2 ;;
    --milestone) milestone_title="$2"; shift 2 ;;
    --no-milestone) no_milestone=true; shift ;;
    --project) project_title="$2"; shift 2 ;;
    --no-project) no_project=true; shift ;;
    --worktree) create_worktree=true; shift ;;
    --url) GITEA_URL="$2"; shift 2 ;;
    --owner) GITEA_OWNER="$2"; shift 2 ;;
    --repository) GITEA_REPOSITORY="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

refuse_extra_type_labels

if [[ "${show_fields}" == true ]]; then
  [[ -n "${issue_type}" ]] || { echo 'Type is required' >&2; exit 2; }
  issue_template summary --type "${issue_type}"
  exit 0
fi

if [[ "${no_project}" == true && -n "${project_title}" ]]; then
  echo 'Use only one of --project or --no-project' >&2
  exit 2
fi

body_sources=0
[[ -n "${body}" ]] && body_sources=$((body_sources + 1))
[[ -n "${body_file}" ]] && body_sources=$((body_sources + 1))
[[ -n "${answers_file}" ]] && body_sources=$((body_sources + 1))
if ((body_sources > 1)); then
  echo 'Use only one of --body, --body-file, or --answers-file' >&2
  exit 2
fi

gitea_require_commands
gitea_load_config

if [[ -z "${issue_type}" ]]; then
  if [[ -t 0 ]]; then
    type_keys="$(issue_template keys)"
    read -r -p "Type (${type_keys}): " issue_type
  else
    echo 'Type is required' >&2
    exit 2
  fi
fi

if [[ -z "${title}" ]]; then
  if [[ -t 0 ]]; then
    read -r -p 'Title: ' title
  fi
fi
[[ -n "${title}" ]] || { echo 'Title is required' >&2; exit 2; }

template_label="$(issue_template label --type "${issue_type}")"

if [[ -n "${answers_file}" ]]; then
  [[ -f "${answers_file}" ]] || { echo "Answers file not found: ${answers_file}" >&2; exit 1; }
  body="$(issue_template render --type "${issue_type}" --answers-file "${answers_file}")"
elif [[ -n "${body_file}" ]]; then
  [[ -f "${body_file}" ]] || { echo "Body file not found: ${body_file}" >&2; exit 1; }
  body="$(<"${body_file}")"
elif [[ -z "${body}" ]]; then
  if [[ -t 0 ]]; then
    draft="$(mktemp)"
    issue_template skeleton --type "${issue_type}" >"${draft}"
    if [[ -n "${EDITOR:-}" ]]; then
      # EDITOR may include arguments, for example "code --wait".
      # shellcheck disable=SC2086
      ${EDITOR} "${draft}"
    else
      vi "${draft}"
    fi
    body="$(<"${draft}")"
    rm -f "${draft}"
  else
    echo 'A body is required. Pass --body, --body-file, or --answers-file.' >&2
    issue_template summary --type "${issue_type}" >&2
    exit 2
  fi
fi
validate_body

if [[ -z "${milestone_title}" && "${no_milestone}" != true && -t 0 ]]; then
  read -r -p 'Milestone (optional): ' milestone_title
fi

if [[ "${no_project}" != true && -z "${project_title}" ]]; then
  project_title="${default_project}"
fi

extra_json='[]'
if ((${#extra_labels[@]})); then
  extra_json="$(printf '%s\n' "${extra_labels[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')"
fi
mapfile -t label_names < <(jq -rn --arg label "${template_label}" --argjson extra "${extra_json}" '[$label] + $extra | unique | .[]')

label_ids=()
for label_name in "${label_names[@]}"; do
  label_id="$(gitea_label_id "${label_name}")" || {
    echo "Label was not found: ${label_name}" >&2
    exit 1
  }
  label_ids+=("${label_id}")
done
label_ids_json="$(printf '%s\n' "${label_ids[@]}" | jq -Rsc 'split("\n") | map(select(length > 0) | tonumber)')"

milestone_json='null'
if [[ -n "${milestone_title}" ]]; then
  milestone_id="$(gitea_milestone_id "${milestone_title}")" || {
    echo "Milestone was not found: ${milestone_title}" >&2
    exit 1
  }
  milestone_json="${milestone_id}"
fi

projects_json='null'
if [[ -n "${project_title}" ]]; then
  project_id="$(gitea_project_id "${project_title}")" || {
    echo "Project was not found: ${project_title}" >&2
    exit 1
  }
  projects_json="$(jq -nc --argjson id "${project_id}" '[$id]')"
fi

issue_payload="$(jq -nc \
  --arg title "${title}" \
  --arg body "${body}" \
  --argjson labels "${label_ids_json}" \
  --argjson milestone "${milestone_json}" \
  --argjson projects "${projects_json}" \
  '{title: $title, body: $body}
   + (if ($labels | length) > 0 then {labels: $labels} else {} end)
   + (if $milestone == null then {} else {milestone: $milestone} end)
   + (if $projects == null then {} else {projects: $projects} end)')"
issue="$(gitea_json POST 'issues' "${issue_payload}")"
issue_number="$(jq -r '.number' <<<"${issue}")"
issue_url="$(jq -r '.html_url' <<<"${issue}")"

slug="$(tr '[:upper:]' '[:lower:]' <<<"${title}" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
branch_name="issue/${issue_number}-${slug}"
echo "Created issue #${issue_number}: ${issue_url}"
echo "Suggested branch: ${branch_name}"
if [[ "${create_worktree}" == true ]]; then
  worktree_path="$("${script_dir}/worktree" create "${branch_name}")"
  echo "Created worktree: ${worktree_path}"
  echo "Next: cd \"${worktree_path}\""
else
  echo "Open its worktree with: cd \"\$(bin/wt ${issue_number})\""
fi
