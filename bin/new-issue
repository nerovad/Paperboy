#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck disable=SC1091
source "${script_dir}/gitea-common"

issue_type=''
title=''
body=''
body_file=''
milestone_title=''
project_title=''
no_milestone=false
no_project=false
create_worktree=false
default_project='Powerpuff Girls'
extra_labels=()
usage() {
  cat <<EOF
Usage: bin/new-issue [OPTIONS]

Create a Paperboy Gitea issue. Missing required values are prompted when
stdin is a terminal. The body and type label come from the repository issue
template unless --body or --body-file is set.

Options:
  --type TYPE          bug, feature, chore, or infrastructure
  --title TITLE        Issue title
  --body TEXT          Complete Markdown issue body
  --body-file PATH     Read the Markdown body from PATH
  --label NAME         Add a label (repeatable; the type label comes from the template)
  --milestone TITLE    Assign a milestone
  --no-milestone       Do not prompt for a milestone
  --project TITLE      Assign a project (default: ${default_project})
  --no-project         Do not assign a project
  --worktree           Create the issue worktree after creation
  --url URL            Override the Gitea base URL
  --owner NAME         Override the repository owner
  --repository NAME    Override the repository name
  -h, --help           Show this help

The issue is created in one request after every label, milestone, and
project name has been resolved. After creation, use the suggested
issue-linked branch with bin/wt.
EOF
}

while (($#)); do
  case "$1" in
    --type) issue_type="$2"; shift 2 ;;
    --title) title="$2"; shift 2 ;;
    --body) body="$2"; shift 2 ;;
    --body-file) body_file="$2"; shift 2 ;;
    --label) extra_labels+=("$2"); shift 2 ;;
    --milestone) milestone_title="$2"; shift 2 ;;
    --no-milestone) no_milestone=true; shift ;;
    --project) project_title="$2"; shift 2 ;;
    --no-project) no_project=true; shift ;;
    --worktree) create_worktree=true; shift ;;
    --url) GITEA_URL="$2"; shift 2 ;;
    --owner) GITEA_OWNER="$2"; shift 2 ;;
    --repository) GITEA_REPOSITORY="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ "${no_project}" == true && -n "${project_title}" ]]; then
  echo 'Use only one of --project or --no-project' >&2
  exit 2
fi

gitea_require_commands
gitea_load_config

if [[ -n "${body}" && -n "${body_file}" ]]; then
  echo 'Use only one of --body or --body-file' >&2
  exit 2
fi
if [[ -n "${body_file}" ]]; then
  [[ -f "${body_file}" ]] || { echo "Body file not found: ${body_file}" >&2; exit 1; }
  body="$(<"${body_file}")"
fi

if [[ -z "${issue_type}" ]]; then
  if [[ -t 0 ]]; then
    read -r -p 'Type (bug, feature, chore, infrastructure): ' issue_type
  else
    echo 'Type is required' >&2
    exit 2
  fi
fi
case "${issue_type}" in
  bug|feature|chore|infrastructure) ;;
  *) echo "Unsupported issue type: ${issue_type}" >&2; exit 2 ;;
esac

if [[ -z "${title}" ]]; then
  if [[ -t 0 ]]; then
    read -r -p 'Title: ' title
  fi
fi
[[ -n "${title}" ]] || { echo 'Title is required' >&2; exit 2; }

templates="$(gitea_get_all 'issue_templates')"
template_json="$(jq -er --arg type "${issue_type}" '
  first(.[] | select(
    [(.labels // [])[] | if type == "object" then .name else . end] | any(. == $type)
  ))
  | {
      labels: [(.labels // [])[] | if type == "object" then .name else . end],
      body: (if ((.body // "") | length) > 0 then .body else (.content // "") end)
    }
' <<<"${templates}")" || {
  echo "No issue template with label: ${issue_type}" >&2
  exit 1
}

if [[ -z "${body}" ]]; then
  body="$(jq -r '.body' <<<"${template_json}")"
fi
[[ -n "${body}" ]] || { echo 'A body is required. Pass --body or --body-file.' >&2; exit 2; }

if [[ -z "${milestone_title}" && "${no_milestone}" != true && -t 0 ]]; then
  read -r -p 'Milestone (optional): ' milestone_title
fi

if [[ "${no_project}" != true && -z "${project_title}" ]]; then
  project_title="${default_project}"
fi

extra_json='[]'
if ((${#extra_labels[@]})); then
  extra_json="$(printf '%s\n' "${extra_labels[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')"
fi
mapfile -t label_names < <(jq -r --argjson extra "${extra_json}" '(.labels + $extra) | unique | .[]' <<<"${template_json}")

label_ids=()
for label_name in "${label_names[@]}"; do
  label_id="$(gitea_label_id "${label_name}")" || {
    echo "Label was not found: ${label_name}" >&2
    exit 1
  }
  label_ids+=("${label_id}")
done
label_ids_json="$(printf '%s\n' "${label_ids[@]}" | jq -Rsc 'split("\n") | map(select(length > 0) | tonumber)')"

milestone_json='null'
if [[ -n "${milestone_title}" ]]; then
  milestone_id="$(gitea_milestone_id "${milestone_title}")" || {
    echo "Milestone was not found: ${milestone_title}" >&2
    exit 1
  }
  milestone_json="${milestone_id}"
fi

projects_json='null'
if [[ -n "${project_title}" ]]; then
  project_id="$(gitea_project_id "${project_title}")" || {
    echo "Project was not found: ${project_title}" >&2
    exit 1
  }
  projects_json="$(jq -nc --argjson id "${project_id}" '[$id]')"
fi

issue_payload="$(jq -nc \
  --arg title "${title}" \
  --arg body "${body}" \
  --argjson labels "${label_ids_json}" \
  --argjson milestone "${milestone_json}" \
  --argjson projects "${projects_json}" \
  '{title: $title, body: $body}
   + (if ($labels | length) > 0 then {labels: $labels} else {} end)
   + (if $milestone == null then {} else {milestone: $milestone} end)
   + (if $projects == null then {} else {projects: $projects} end)')"
issue="$(gitea_json POST 'issues' "${issue_payload}")"
issue_number="$(jq -r '.number' <<<"${issue}")"
issue_url="$(jq -r '.html_url' <<<"${issue}")"

slug="$(tr '[:upper:]' '[:lower:]' <<<"${title}" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
branch_name="issue/${issue_number}-${slug}"
echo "Created issue #${issue_number}: ${issue_url}"
echo "Suggested branch: ${branch_name}"
if [[ "${create_worktree}" == true ]]; then
  worktree_path="$("${script_dir}/worktree" create "${branch_name}")"
  echo "Created worktree: ${worktree_path}"
  echo "Next: cd \"${worktree_path}\""
else
  echo "Open its worktree with: cd \"\$(bin/wt ${issue_number})\""
fi
