#!/usr/bin/env bash
# Kept as the name AGENTS.md and muscle memory reach for. The workstation
# runner is bin/dev-local -- Puma, Solid Queue and the Dart Sass watcher in one
# terminal -- and every argument here is passed straight to it.
#
#   bin/dev              # Puma on :3001 + Solid Queue + Sass
#   bin/dev 3005         # different port
#   bin/dev --cron       # also run the recurring schedule
#   bin/dev --no-jobs    # Puma and Sass only
exec "$(dirname "$0")/dev-local" "$@"
