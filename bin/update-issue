#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "${script_dir}/.." && pwd -P)"
# shellcheck disable=SC1091
source "${script_dir}/gitea-common"

issue_number=''
milestone_title=''
project_title=''
column_title=''
title=''
title_set=false
issue_type=''
body=''
body_file=''
answers_file=''
apply=false
label_names=()
remove_labels=()

issue_template() {
  command -v ruby >/dev/null 2>&1 || {
    echo 'Required command not found: ruby' >&2
    return 1
  }
  ruby "${repo_root}/lib/paperboy/gitea/issue_template.rb" "$@"
}

strip_edges() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "${value}"
}

is_type_label() {
  case "$1" in
    bug|feature|chore|infrastructure) return 0 ;;
    *) return 1 ;;
  esac
}

# The template type owns the type label. Other labels stay under
# --add-label and --remove-label.
sync_type_label() {
  local template_label label_name other seen=false
  local -a kept_adds=()
  local -a kept_removes=()
  template_label="$(issue_template label --type "${issue_type}")"

  for label_name in "${label_names[@]+"${label_names[@]}"}"; do
    if is_type_label "${label_name}" && [[ "${label_name}" != "${template_label}" ]]; then
      continue
    fi
    kept_adds+=("${label_name}")
  done
  for label_name in "${remove_labels[@]+"${remove_labels[@]}"}"; do
    if is_type_label "${label_name}"; then
      continue
    fi
    kept_removes+=("${label_name}")
  done

  for label_name in "${kept_adds[@]+"${kept_adds[@]}"}"; do
    [[ "${label_name}" == "${template_label}" ]] && seen=true
  done
  if [[ "${seen}" == false ]] && ! grep -Fxq "${template_label}" <<<"${current_labels}"; then
    kept_adds+=("${template_label}")
  fi
  for other in bug feature chore infrastructure; do
    [[ "${other}" == "${template_label}" ]] && continue
    if grep -Fxq "${other}" <<<"${current_labels}"; then
      kept_removes+=("${other}")
    fi
  done

  label_names=()
  if ((${#kept_adds[@]})); then
    label_names=("${kept_adds[@]}")
  fi
  remove_labels=()
  if ((${#kept_removes[@]})); then
    remove_labels=("${kept_removes[@]}")
  fi
}

validate_body() {
  local draft
  draft="$(mktemp)"
  printf '%s' "${body}" >"${draft}"
  if ! issue_template validate-body --type "${issue_type}" --body-file "${draft}"; then
    rm -f "${draft}"
    exit 2
  fi
  rm -f "${draft}"
}

usage() {
  cat <<'EOF'
Usage: bin/update-issue --issue NUMBER [OPTIONS]

Plan explicit updates for one Gitea issue. The default is dry-run; add
--apply only after reviewing the plan. A body must follow the issue
template for --type.

Options:
  --issue NUMBER       Issue number to update (required)
  --title TITLE        Replace the issue title
  --type TYPE          bug, feature, chore, or infrastructure
  --answers-file PATH  JSON answers keyed by the template section ids
  --body TEXT          Complete Markdown issue body
  --body-file PATH     Read the Markdown body from PATH
  --add-label NAME     Add a repository label (repeatable)
  --remove-label NAME  Remove a repository label (repeatable)
  --milestone TITLE    Assign the named milestone
  --project TITLE      Replace the issue's project list with this project
  --column TITLE       Move the issue to this column on its project
  --apply              Apply the planned remote changes
  --url URL            Override the Gitea base URL
  --owner NAME         Override the repository owner
  --repository NAME    Override the repository name
  -h, --help           Show this help

--type is required with --body, --body-file, or --answers-file. It sets
that type label and removes any other type label. The same title, body,
or type label is left unchanged. --column uses the issue's global id.
Gitea's move API does not take the issue number. The issue must already
be on the project, or --project must name that project in the same
command. This command never closes an issue, merges a pull request, or
deletes a branch.
EOF
}

while (($#)); do
  case "$1" in
    --issue) issue_number="$2"; shift 2 ;;
    --title) title="$2"; title_set=true; shift 2 ;;
    --type) issue_type="$2"; shift 2 ;;
    --answers-file) answers_file="$2"; shift 2 ;;
    --body) body="$2"; shift 2 ;;
    --body-file) body_file="$2"; shift 2 ;;
    --add-label) label_names+=("$2"); shift 2 ;;
    --remove-label) remove_labels+=("$2"); shift 2 ;;
    --milestone) milestone_title="$2"; shift 2 ;;
    --project) project_title="$2"; shift 2 ;;
    --column) column_title="$2"; shift 2 ;;
    --apply) apply=true; shift ;;
    --url) GITEA_URL="$2"; shift 2 ;;
    --owner) GITEA_OWNER="$2"; shift 2 ;;
    --repository) GITEA_REPOSITORY="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ "${issue_number}" =~ ^[0-9]+$ ]] || { echo '--issue requires a number' >&2; exit 2; }

body_sources=0
[[ -n "${body}" ]] && body_sources=$((body_sources + 1))
[[ -n "${body_file}" ]] && body_sources=$((body_sources + 1))
[[ -n "${answers_file}" ]] && body_sources=$((body_sources + 1))
if ((body_sources > 1)); then
  echo 'Use only one of --body, --body-file, or --answers-file' >&2
  exit 2
fi

if [[ "${title_set}" == true ]]; then
  title="$(strip_edges "${title}")"
  [[ -n "${title}" ]] || { echo 'Title cannot be empty' >&2; exit 2; }
fi

if ((body_sources > 0)); then
  [[ -n "${issue_type}" ]] || { echo 'Type is required' >&2; exit 2; }
elif [[ -n "${issue_type}" ]]; then
  echo 'Pass --body, --body-file, or --answers-file with --type' >&2
  exit 2
fi

has_update=false
if ((${#label_names[@]} > 0 || ${#remove_labels[@]} > 0 || ${#milestone_title} > 0 || ${#project_title} > 0 || ${#column_title} > 0 || body_sources > 0)); then
  has_update=true
fi
[[ "${title_set}" == true ]] && has_update=true
[[ "${has_update}" == true ]] || { echo 'At least one update is required' >&2; exit 2; }

if [[ -n "${answers_file}" ]]; then
  [[ -f "${answers_file}" ]] || { echo "Answers file not found: ${answers_file}" >&2; exit 1; }
  body="$(issue_template render --type "${issue_type}" --answers-file "${answers_file}")"
elif [[ -n "${body_file}" ]]; then
  [[ -f "${body_file}" ]] || { echo "Body file not found: ${body_file}" >&2; exit 1; }
  body="$(<"${body_file}")"
fi
if ((body_sources > 0)); then
  validate_body
fi

gitea_require_commands
gitea_load_config
issue="$(gitea_get "issues/${issue_number}")"
issue_global_id="$(jq -r '.id' <<<"${issue}")"
[[ "${issue_global_id}" =~ ^[0-9]+$ ]] || { echo "Issue #${issue_number} has no global id" >&2; exit 1; }
current_labels="$(jq -r '(.labels // [])[] | .name' <<<"${issue}")"
current_project_ids="$(jq -c '[(.projects // [])[] | if type == "object" then .id else . end]' <<<"${issue}")"
if ((body_sources > 0)); then
  sync_type_label
fi

label_ids=()
new_labels=()
for label_name in "${label_names[@]}"; do
  label_id="$(gitea_label_id "${label_name}")" || {
    echo "Unknown label: ${label_name}" >&2
    exit 1
  }
  if ! grep -Fxq "${label_name}" <<<"${current_labels}"; then
    label_ids+=("${label_id}")
    new_labels+=("${label_name}")
  fi
done

remove_ids=()
removed_labels=()
for label_name in "${remove_labels[@]}"; do
  label_id="$(gitea_label_id "${label_name}")" || {
    echo "Unknown label: ${label_name}" >&2
    exit 1
  }
  if grep -Fxq "${label_name}" <<<"${current_labels}"; then
    remove_ids+=("${label_id}")
    removed_labels+=("${label_name}")
  fi
done

milestone_id=''
milestone_change=false
if [[ -n "${milestone_title}" ]]; then
  milestone_id="$(gitea_milestone_id "${milestone_title}")" || {
    echo "Unknown milestone: ${milestone_title}" >&2
    exit 1
  }
  current_milestone_id="$(jq -r '.milestone.id // empty' <<<"${issue}")"
  [[ "${current_milestone_id}" == "${milestone_id}" ]] || milestone_change=true
fi

project_id=''
project_change=false
project_replaces=false
if [[ -n "${project_title}" ]]; then
  project_id="$(gitea_project_id "${project_title}")" || {
    echo "Unknown project: ${project_title}" >&2
    exit 1
  }
  desired_project_ids="$(jq -nc --argjson id "${project_id}" '[$id]')"
  if [[ "${current_project_ids}" != "${desired_project_ids}" ]]; then
    project_change=true
    [[ "${current_project_ids}" == "[]" ]] || project_replaces=true
  fi
fi

column_id=''
column_project_id=''
if [[ -n "${column_title}" ]]; then
  if [[ -n "${project_id}" ]]; then
    column_project_id="${project_id}"
  elif [[ "$(jq 'length' <<<"${current_project_ids}")" -eq 1 ]]; then
    column_project_id="$(jq -r '.[0]' <<<"${current_project_ids}")"
  else
    echo 'Pass --project to choose the board for --column.' >&2
    exit 1
  fi
  column_id="$(gitea_project_column_id "${column_project_id}" "${column_title}")" || {
    echo "Unknown column: ${column_title}" >&2
    exit 1
  }
fi

title_change=false
if [[ "${title_set}" == true ]]; then
  current_title="$(strip_edges "$(jq -r '.title // ""' <<<"${issue}")")"
  [[ "${title}" == "${current_title}" ]] || title_change=true
fi

body_change=false
if ((body_sources > 0)); then
  current_body="$(strip_edges "$(jq -r '.body // ""' <<<"${issue}")")"
  [[ "$(strip_edges "${body}")" == "${current_body}" ]] || body_change=true
fi

echo 'Gitea update plan'
echo "Issue: #${issue_number} — $(jq -r '.title' <<<"${issue}")"
if [[ "${title_change}" == true ]]; then echo "- set title: ${title}"; fi
if [[ "${body_change}" == true ]]; then
  echo '- replace body:'
  printf '%s\n' "${body}"
fi
for label_name in "${removed_labels[@]}"; do echo "- remove label: ${label_name}"; done
for label_name in "${new_labels[@]}"; do echo "- add label: ${label_name}"; done
if [[ "${milestone_change}" == true ]]; then echo "- assign milestone: ${milestone_title}"; fi
if [[ "${project_change}" == true ]]; then
  if [[ "${project_replaces}" == true ]]; then
    echo "- assign project: ${project_title} (replaces other projects)"
  else
    echo "- assign project: ${project_title}"
  fi
fi
if [[ -n "${column_id}" ]]; then echo "- move to column: ${column_title}"; fi

no_changes=false
if ((${#removed_labels[@]} == 0 && ${#new_labels[@]} == 0)) \
  && [[ "${milestone_change}" == false && "${project_change}" == false && -z "${column_id}" \
        && "${title_change}" == false && "${body_change}" == false ]]; then
  echo '- no changes required'
  no_changes=true
fi

if [[ "${no_changes}" == true ]]; then
  if [[ "${apply}" == true ]]; then
    echo 'No Gitea state was changed.'
  else
    echo 'Dry run only: no Gitea state was changed. Use --apply to execute this plan.'
  fi
  exit 0
fi

if [[ "${apply}" != true ]]; then
  echo 'Dry run only: no Gitea state was changed. Use --apply to execute this plan.'
  exit 0
fi

if ((${#remove_ids[@]} > 0)); then
  for label_id in "${remove_ids[@]}"; do
    gitea_json DELETE "issues/${issue_number}/labels/${label_id}" >/dev/null
  done
  echo "Removed labels: $(IFS=', '; echo "${removed_labels[*]}")"
fi

if ((${#label_ids[@]} > 0)); then
  label_payload="$(printf '%s\n' "${label_ids[@]}" | jq -Rsc 'split("\n") | map(select(length > 0) | tonumber) | {labels: .}')"
  gitea_json POST "issues/${issue_number}/labels" "${label_payload}" >/dev/null
  echo "Applied labels: $(IFS=', '; echo "${new_labels[*]}")"
fi

milestone_json='null'
project_json='null'
if [[ "${milestone_change}" == true ]]; then
  milestone_json="${milestone_id}"
fi
if [[ "${project_change}" == true ]]; then
  project_json="$(jq -nc --argjson id "${project_id}" '[$id]')"
fi
if [[ "${title_change}" == true || "${body_change}" == true || "${milestone_change}" == true || "${project_change}" == true ]]; then
  patch_payload="$(jq -nc \
    --argjson title_change "${title_change}" \
    --arg title "${title}" \
    --argjson body_change "${body_change}" \
    --arg body "${body}" \
    --argjson milestone_change "${milestone_change}" \
    --argjson milestone "${milestone_json}" \
    --argjson project_change "${project_change}" \
    --argjson projects "${project_json}" \
    '{}
     + (if $title_change then {title: $title} else {} end)
     + (if $body_change then {body: $body} else {} end)
     + (if $milestone_change then {milestone: $milestone} else {} end)
     + (if $project_change then {projects: $projects} else {} end)')"
  gitea_json PATCH "issues/${issue_number}" "${patch_payload}" >/dev/null
  if [[ "${title_change}" == true ]]; then echo "Applied title: ${title}"; fi
  if [[ "${body_change}" == true ]]; then echo 'Applied body.'; fi
  if [[ "${milestone_change}" == true ]]; then echo "Applied milestone: ${milestone_title}"; fi
  if [[ "${project_change}" == true ]]; then echo "Applied project: ${project_title}"; fi
fi

if [[ -n "${column_id}" ]]; then
  # The move path takes the issue's global id, not its repository number.
  move_payload="$(jq -nc --argjson id "${column_id}" '{column_id: $id}')"
  gitea_json POST "projects/${column_project_id}/issues/${issue_global_id}/move" "${move_payload}" >/dev/null
  echo "Moved to column: ${column_title}"
fi

echo "Audit: issue #${issue_number} updated by explicit --apply request."
