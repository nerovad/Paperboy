#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$script_dir/.."

app_root=$PWD
pid_dir="$app_root/tmp/pids"

usage() {
  echo "Usage: bin/stopservers [PORT]" >&2
}

is_supported_process() {
  local command=$1

  [[ $command == *"rails server"* || $command == *puma* ||
     $command == *"bin/jobs"* || $command == *"solid-queue"* ||
     $command == *"dartsass:watch"* || $command == *"sass-embedded"* ]]
}

process_belongs_to_app() {
  local pid=$1 process_cwd command

  process_cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || return 1
  [[ $process_cwd == "$app_root" ]] || return 1

  command=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || return 1
  is_supported_process "$command"
}

process_is_running() {
  local pid=$1 state

  kill -0 "$pid" 2>/dev/null || return 1
  state=$(ps -o stat= -p "$pid" 2>/dev/null | tr -d ' ')
  [[ $state != Z* ]]
}

process_group_for() {
  local pid=$1

  ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' '
}

process_group_is_running() {
  local process_group=$1

  [[ -n "$process_group" ]] || return 1
  ps -o pid= -g "$process_group" 2>/dev/null | grep -q '[0-9]'
}

stack_is_running() {
  local pid process_group

  for pid in "$@"; do
    process_is_running "$pid" && return 0
    process_group="${process_groups[$pid]:-}"
    process_group_is_running "$process_group" && return 0
  done
  return 1
}

signal_process_group() {
  local pid=$1 signal=$2 process_group=${3:-}

  if [[ -n "$process_group" && "$process_group" == "$pid" ]]; then
    kill -"$signal" -- "-$process_group" 2>/dev/null || true
  else
    kill -"$signal" "$pid" 2>/dev/null || true
  fi
}

process_is_shell() {
  local pid=$1 executable

  executable=$(basename "$(readlink "/proc/$pid/exe" 2>/dev/null)") || return 1
  [[ $executable == bash || $executable == dash || $executable == fish ||
     $executable == ksh || $executable == sh || $executable == zsh ]]
}

port_is_in_command() {
  local command=$1 port=$2

  [[ " $command " == *" -p $port "* ||
    " $command " == *" --port $port "* ||
    " $command " == *" --port=$port "* ]]
}

find_processes() {
  local port=$1 command pid_file pid

  pid_file="$pid_dir/paperboy-dev-$port.pids"
  if [[ -f "$pid_file" ]]; then
    while read -r pid; do
      [[ $pid =~ ^[0-9]+$ ]] || continue
      process_belongs_to_app "$pid" || continue
      printf '%s\n' "$pid"
    done < "$pid_file"
  fi

  while read -r pid; do
    [[ $pid =~ ^[0-9]+$ ]] || continue
    process_belongs_to_app "$pid" || continue
    command=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || continue
    is_supported_process "$command" || continue
    [[ $command == *"rails server"* || $command == *puma* ]] || continue
    printf '%s\n' "$pid"
  done < <(
    ss -ltnpH 2>/dev/null |
      awk -v port=":$port" '$4 ~ port "$" { match($0, /pid=[0-9]+/); if (RSTART) print substr($0, RSTART + 4, RLENGTH - 4) }'
  )

  for process_dir in /proc/[0-9]*; do
    pid=${process_dir##*/}
    process_is_shell "$pid" && continue
    process_belongs_to_app "$pid" || continue
    command=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || continue
    [[ $command == *"rails server"* || $command == *puma* ]] || continue
    port_is_in_command "$command" "$port" || continue
    printf '%s\n' "$pid"
  done
}

stop_servers() {
  local port=${1:-3001}
  local -a pids=()
  local -A process_groups=()
  local pid process_group

  if [[ ! $port =~ ^[0-9]+$ ]]; then
    usage
    return 2
  fi

  mapfile -t pids < <(find_processes "$port" | sort -n -u)
  if ((${#pids[@]} == 0)); then
    rm -f "$pid_dir/paperboy-dev-$port.pids"
    echo "No Paperboy processes found for port ${port}."
    return
  fi

  for pid in "${pids[@]}"; do
    process_group="$(process_group_for "$pid")"
    process_groups["$pid"]="$process_group"
    signal_process_group "$pid" TERM "$process_group"
  done

  for _ in {1..50}; do
    if ! stack_is_running "${pids[@]}"; then
      rm -f "$pid_dir/paperboy-dev-$port.pids"
      echo "Stopped Paperboy processes for port ${port}."
      return
    fi
    sleep 0.1
  done

  echo "==> Graceful shutdown timed out; sending KILL to process groups" >&2
  for pid in "${pids[@]}"; do
    signal_process_group "$pid" KILL "${process_groups[$pid]}"
  done

  for _ in {1..10}; do
    if ! stack_is_running "${pids[@]}"; then
      rm -f "$pid_dir/paperboy-dev-$port.pids"
      echo "Stopped Paperboy processes for port ${port}."
      return
    fi
    sleep 0.1
  done

  echo "==> Could not stop all Paperboy processes for port ${port}." >&2
  echo "==> PID manifest retained at ${pid_dir}/paperboy-dev-${port}.pids." >&2
  return 1
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  stop_servers "${1:-}"
fi
