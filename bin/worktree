#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  bin/wt <issue-number>
  bin/wt list
  bin/wt context
  bin/wt clean <issue-number>
  bin/worktree create issue/<number>-<slug>
  bin/worktree switch issue/<number>-<slug>
  bin/worktree cleanup issue/<number>-<slug>

The short form finds the local issue/<number>-<slug> branch and places its
worktree in the shared checkout's worktrees/<number> directory. It copies the
common checkout's .env when the worktree does not already have one.

Use: cd "$(bin/wt 123)"

Use bin/wt context at the start of a session to verify its worktree and branch.

Cleanup only removes a branch that is merged into the default branch and has
no uncommitted changes. It refuses the current worktree.
EOF
}

command_name="${1:-}"
branch_name="${2:-}"
if [[ "${command_name}" == '-h' || "${command_name}" == '--help' ]]; then
  usage
  exit 0
fi

if [[ "${command_name}" =~ ^[0-9]+$ && $# -eq 1 ]]; then
  command_name='open'
  branch_name="${1}"
fi

repo_root="$(git rev-parse --show-toplevel)"
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
if [[ "${common_dir}" == */.git ]]; then
  common_root="${common_dir%/.git}"
else
  common_root="${repo_root}"
fi

default_branch="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)"
default_branch="${default_branch#origin/}"
default_branch="${default_branch:-master}"

if [[ "${command_name}" == context ]]; then
  [[ $# -eq 1 ]] || { usage >&2; exit 2; }
  current_branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo detached)"
  issue_number='none'
  if [[ "${current_branch}" =~ ^issue/([0-9]+)- ]]; then
    issue_number="${BASH_REMATCH[1]}"
  fi
  if [[ -z "$(git status --porcelain)" ]]; then
    working_state='clean'
  else
    working_state='dirty'
  fi
  printf 'Repository: %s\n' "${common_root}"
  printf 'Current worktree: %s\n' "${repo_root}"
  printf 'Branch: %s\n' "${current_branch}"
  printf 'Issue: %s\n' "${issue_number}"
  printf 'Status: %s\n' "${working_state}"
  printf 'Default branch: %s\n' "${default_branch}"
  if [[ "${repo_root}" == "${common_root}" ]]; then
    printf 'Session target: shared checkout (create or select a worktree before editing)\n'
  else
    printf 'Session target: linked worktree\n'
  fi
  exit 0
fi

resolve_issue_branch() {
  local issue_number="$1"
  local matching_branches=()

  mapfile -t matching_branches < <(
    git for-each-ref --format='%(refname:short)' "refs/heads/issue/${issue_number}-*"
  )
  if [[ "${#matching_branches[@]}" -eq 0 ]]; then
    echo "No local branch found for issue #${issue_number}" >&2
    echo "Create it with: bin/new-issue --worktree ..." >&2
    exit 1
  fi
  if [[ "${#matching_branches[@]}" -gt 1 ]]; then
    printf 'Multiple local branches found for issue #%s:\n' "${issue_number}" >&2
    printf '  %s\n' "${matching_branches[@]}" >&2
    exit 1
  fi
  branch_name="${matching_branches[0]}"
}

case "${command_name}" in
  list)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    git worktree list
    exit 0
    ;;
  context)
    usage >&2
    exit 2
    ;;
  clean)
    if [[ "${branch_name}" =~ ^[0-9]+$ ]]; then
      resolve_issue_branch "${branch_name}"
    fi
    command_name='cleanup'
    ;;
  open)
    if [[ "${branch_name}" =~ ^[0-9]+$ ]]; then
      resolve_issue_branch "${branch_name}"
    fi
    command_name='switch'
    ;;
  cleanup)
    if [[ "${branch_name}" =~ ^[0-9]+$ ]]; then
      resolve_issue_branch "${branch_name}"
    fi
    ;;
esac

[[ "${command_name}" == create ||
  "${command_name}" == switch ||
  "${command_name}" == cleanup ]] || {
  usage >&2
  exit 2
}
[[ "${branch_name}" =~ ^issue/[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$ ]] || {
  echo "Branch must match issue/<number>-<lowercase-slug>: ${branch_name}" >&2
  exit 2
}

worktree_root="${common_root}/worktrees"
issue_number="${branch_name#issue/}"
issue_number="${issue_number%%-*}"
worktree_path="${worktree_root}/${issue_number}"
branch_ref="refs/heads/${branch_name}"
env_source=''
if [[ -f "${common_root}/.env" ]]; then
  env_source="${common_root}/.env"
fi

copy_env_if_needed() {
  local destination="$1/.env"

  [[ -e "${destination}" ]] && return 0
  if [[ -n "${env_source}" && -f "${env_source}" ]]; then
    cp -p -- "${env_source}" "${destination}"
    echo "Copied .env to ${1}" >&2
  else
    echo "Warning: no .env found in the common checkout" >&2
  fi
}

existing_path="$(
  git worktree list --porcelain |
    awk -v branch="${branch_ref}" '
      $1 == "worktree" { path = $2 }
      $1 == "branch" && $2 == branch { print path }
    '
)"

if [[ "${command_name}" == cleanup ]]; then
  git show-ref --verify --quiet "${branch_ref}" || {
    echo "Branch does not exist locally: ${branch_name}" >&2
    exit 1
  }

  [[ "${branch_name}" != "${default_branch}" ]] || {
    echo "Refusing to clean up the default branch: ${branch_name}" >&2
    exit 1
  }

  git merge-base --is-ancestor "${branch_name}" "${default_branch}" || {
    echo "Branch is not merged into ${default_branch}: ${branch_name}" >&2
    exit 1
  }

  if [[ -n "${existing_path}" ]]; then
    current_root="$(git rev-parse --show-toplevel)"
    [[ "${existing_path}" != "${current_root}" ]] || {
      echo "Refusing to remove the current worktree: ${existing_path}" >&2
      exit 1
    }

    [[ -z "$(git -C "${existing_path}" status --porcelain)" ]] || {
      echo "Refusing to remove a dirty worktree: ${existing_path}" >&2
      exit 1
    }

    git worktree remove "${existing_path}"
  fi

  git branch -d "${branch_name}"
  printf 'Removed merged branch: %s\n' "${branch_name}"
  exit 0
fi

if [[ -n "${existing_path}" ]]; then
  copy_env_if_needed "${existing_path}"
  printf '%s\n' "${existing_path}"
  exit 0
fi

[[ ! -e "${worktree_path}" ]] || {
  echo "Worktree path already exists but is not registered: ${worktree_path}" >&2
  exit 1
}

if [[ "${command_name}" == switch ]] && ! git show-ref --verify --quiet "${branch_ref}"; then
  echo "Branch does not exist: ${branch_name}" >&2
  echo "Create it first with: bin/worktree create ${branch_name}" >&2
  exit 1
fi

mkdir -p "${worktree_root}"
if git show-ref --verify --quiet "${branch_ref}"; then
  git worktree add "${worktree_path}" "${branch_name}" >/dev/null
else
  git worktree add -b "${branch_name}" "${worktree_path}" HEAD >/dev/null
fi

copy_env_if_needed "${worktree_path}"
printf '%s\n' "${worktree_path}"
