#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  bin/worktree create issue/<number>-<slug>
  bin/worktree switch issue/<number>-<slug>
  bin/worktree cleanup issue/<number>-<slug>

Create or locate a worktree for a branch following the issue-linked convention.
The worktree is placed beside the repository in <repo>-worktrees/<branch>.
Use: cd "$(bin/worktree switch issue/123-short-description)"

Cleanup only removes a branch that is merged into the default branch and has
no uncommitted changes. It refuses the current worktree.
EOF
}

command_name="${1:-}"
branch_name="${2:-}"
if [[ "${command_name}" == '-h' || "${command_name}" == '--help' ]]; then
  usage
  exit 0
fi

[[ "${command_name}" == create ||
  "${command_name}" == switch ||
  "${command_name}" == cleanup ]] || {
  usage >&2
  exit 2
}
[[ "${branch_name}" =~ ^issue/[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$ ]] || {
  echo "Branch must match issue/<number>-<lowercase-slug>: ${branch_name}" >&2
  exit 2
}

repo_root="$(git rev-parse --show-toplevel)"
repo_name="$(basename "${repo_root}")"
worktree_root="$(dirname "${repo_root}")/${repo_name}-worktrees"
worktree_path="${worktree_root}/${branch_name//\//-}"
branch_ref="refs/heads/${branch_name}"
default_branch="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)"
default_branch="${default_branch#origin/}"
default_branch="${default_branch:-master}"

existing_path="$(
  git worktree list --porcelain |
    awk -v branch="${branch_ref}" '
      $1 == "worktree" { path = $2 }
      $1 == "branch" && $2 == branch { print path }
    '
)"

if [[ "${command_name}" == cleanup ]]; then
  git show-ref --verify --quiet "${branch_ref}" || {
    echo "Branch does not exist locally: ${branch_name}" >&2
    exit 1
  }

  [[ "${branch_name}" != "${default_branch}" ]] || {
    echo "Refusing to clean up the default branch: ${branch_name}" >&2
    exit 1
  }

  git merge-base --is-ancestor "${branch_name}" "${default_branch}" || {
    echo "Branch is not merged into ${default_branch}: ${branch_name}" >&2
    exit 1
  }

  if [[ -n "${existing_path}" ]]; then
    current_root="$(git rev-parse --show-toplevel)"
    [[ "${existing_path}" != "${current_root}" ]] || {
      echo "Refusing to remove the current worktree: ${existing_path}" >&2
      exit 1
    }

    [[ -z "$(git -C "${existing_path}" status --porcelain)" ]] || {
      echo "Refusing to remove a dirty worktree: ${existing_path}" >&2
      exit 1
    }

    git worktree remove "${existing_path}"
  fi

  git branch -d "${branch_name}"
  printf 'Removed merged branch: %s\n' "${branch_name}"
  exit 0
fi

if [[ -n "${existing_path}" ]]; then
  printf '%s\n' "${existing_path}"
  exit 0
fi

if [[ "${command_name}" == switch ]] && ! git show-ref --verify --quiet "${branch_ref}"; then
  echo "Branch does not exist: ${branch_name}" >&2
  echo "Create it first with: bin/worktree create ${branch_name}" >&2
  exit 1
fi

mkdir -p "${worktree_root}"
if git show-ref --verify --quiet "${branch_ref}"; then
  git worktree add "${worktree_path}" "${branch_name}" >/dev/null
else
  git worktree add -b "${branch_name}" "${worktree_path}" HEAD >/dev/null
fi

printf '%s\n' "${worktree_path}"
