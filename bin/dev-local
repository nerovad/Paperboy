#!/bin/bash
# Run Paperboy on this workstation: Puma + Solid Queue in one terminal.
#
# This is NOT a deploy script. bin/deploy-dev pulls master, precompiles assets
# and restarts systemd units that only exist on the dev server; running it here
# would reset your branch and leave stale assets shadowing your edits.
#
#   bin/dev-local            # Puma on :3001 + Solid Queue + Sass, schedule off
#   bin/dev-local 3005       # different port
#   bin/dev-local --cron     # also run the scheduled jobs (see warning below)
#   bin/dev-local --no-jobs  # Puma and Sass only
set -euo pipefail

cd "$(dirname "$0")/.."

PORT="${PORT:-3001}"
BIND="${BIND:-127.0.0.1}"
ENABLE_CRON=0
RUN_JOBS=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cron)     ENABLE_CRON=1; shift ;;
    --no-jobs)  RUN_JOBS=0; shift ;;
    -p|--port)  PORT="$2"; shift 2 ;;
    [0-9]*)     PORT="$1"; shift ;;
    -h|--help)  sed -n '2,10p' "$0"; exit 0 ;;
    *) echo "unknown option: $1 (try --help)" >&2; exit 1 ;;
  esac
done

# --- Preflight -------------------------------------------------------------
if [[ ! -f .env ]]; then
  echo "==> .env is missing. Rails cannot boot without GSABSS_* and the" >&2
  echo "    ACTIVE_RECORD_ENCRYPTION_* keys; copy it from another machine." >&2
  exit 1
fi

if ss -ltn 2>/dev/null | grep -qE "[:.]${PORT}[[:space:]]"; then
  echo "==> Port ${PORT} is already in use. Pass another: bin/dev-local 3002" >&2
  exit 1
fi

# --- Shutdown --------------------------------------------------------------
PIDS=()

cleanup() {
  trap - INT TERM EXIT
  echo
  echo "==> Shutting down..."
  for pid in "${PIDS[@]:-}"; do
    kill "$pid" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}
trap cleanup INT TERM EXIT

# --- Dart Sass -------------------------------------------------------------
# Compiles application.scss into app/assets/builds/application.css, which is
# what Sprockets serves. Without it a saved .scss changes nothing in a browser.
echo "==> Starting Dart Sass watcher..."
bundle exec rails dartsass:watch \
  > >(sed -u 's/^/[sass] /') 2>&1 &
PIDS+=($!)

# --- Solid Queue -----------------------------------------------------------
if [[ "$RUN_JOBS" -eq 1 ]]; then
  if [[ "$ENABLE_CRON" -ne 1 ]]; then
    export SOLID_QUEUE_CONFIG="$PWD/config/queue.yml"
    export SOLID_QUEUE_SKIP_RECURRING=true
  fi

  echo "==> Starting Solid Queue..."
  bundle exec bin/jobs \
    > >(sed -u 's/^/[solid-queue] /') 2>&1 &
  PIDS+=($!)
fi

# --- Puma ------------------------------------------------------------------
# Both processes run in the background and the script blocks in `wait`: bash
# defers traps while a foreground child runs, so a foreground Puma would make
# `kill` on this script hang instead of shutting the pair down.
echo "==> Starting Puma on http://localhost:${PORT} ..."
bundle exec rails server -p "$PORT" -b "$BIND" &
PIDS+=($!)

# Returns as soon as either process exits, so one dying takes the other with it.
wait -n
