#!/usr/bin/env bash
# Run Paperboy on this workstation: Puma + Solid Queue + Dart Sass.
#
# This is NOT a deploy script. bin/deploy-dev pulls master, precompiles assets
# and restarts systemd units that only exist on the dev server; running it here
# would reset your branch and leave stale assets shadowing your edits.
#
#   bin/dev-local            # Puma on :3001 + Solid Queue + Sass
#   bin/dev-local 3005       # different port
#   bin/dev-local --cron     # also run the recurring schedule
#   bin/dev-local --no-jobs  # Puma and Sass only
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
app_root=$(cd "$script_dir/.." && pwd)
cd "$app_root"

PORT="${PORT:-3001}"
BIND="${BIND:-127.0.0.1}"
ENABLE_CRON=0
RUN_JOBS=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cron)     ENABLE_CRON=1; shift ;;
    --no-jobs)  RUN_JOBS=0; shift ;;
    -p|--port)  PORT="$2"; shift 2 ;;
    [0-9]*)     PORT="$1"; shift ;;
    -h|--help)  sed -n '2,11p' "$0"; exit 0 ;;
    *) echo "unknown option: $1 (try --help)" >&2; exit 1 ;;
  esac
done

mkdir -p "$app_root/log"
exec 2> >(tee "$app_root/log/error.log" >&2)
mkdir -p "$app_root/tmp/pids"
pid_file="$app_root/tmp/pids/paperboy-dev-$PORT.pids"

# --- Preflight -------------------------------------------------------------
if [[ ! -f .env ]]; then
  echo "==> .env is missing. Rails cannot boot without GSABSS_* and the" >&2
  echo "    ACTIVE_RECORD_ENCRYPTION_* keys; copy it from another machine." >&2
  exit 1
fi

# --- Shutdown --------------------------------------------------------------
source "$script_dir/stopservers"
stop_servers "$PORT"
rm -f "$pid_file"

if ss -ltn 2>/dev/null | grep -qE "[:.]${PORT}[[:space:]]"; then
  echo "==> Port ${PORT} is already in use. Pass another: bin/dev-local 3002" >&2
  exit 1
fi

# --- Assets -----------------------------------------------------------------
{
  bundle check || bundle install
  bundle exec bin/rails assets:clobber
  bundle exec bin/rails assets:precompile
} 2>&1 | tee "$app_root/log/assets.log"

# --- Dart Sass --------------------------------------------------------------
echo "==> Starting Dart Sass watcher..."
nohup setsid bundle exec rails dartsass:watch \
  </dev/null >"$app_root/log/sass.log" 2>&1 &
echo "$!" >>"$pid_file"

# --- Solid Queue -----------------------------------------------------------
if [[ "$RUN_JOBS" -eq 1 ]]; then
  if [[ "$ENABLE_CRON" -ne 1 ]]; then
    export SOLID_QUEUE_CONFIG="$app_root/config/queue.yml"
    export SOLID_QUEUE_SKIP_RECURRING=true
  fi

  echo "==> Starting Solid Queue..."
  nohup setsid bundle exec bin/jobs \
    </dev/null >"$app_root/log/jobs.log" 2>&1 &
  echo "$!" >>"$pid_file"
fi

# --- Puma ------------------------------------------------------------------
echo "==> Starting Puma on http://${BIND}:${PORT} ..."
nohup setsid bundle exec rails server -p "$PORT" -b "$BIND" \
  </dev/null >"$app_root/log/server.log" 2>&1 &
echo "$!" >>"$pid_file"

echo "==> Paperboy started. Logs are under $app_root/log/"
