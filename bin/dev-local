#!/usr/bin/env bash
# Run Paperboy on this workstation: Puma + Solid Queue + Dart Sass.
#
# This is NOT a deploy script. bin/deploy-dev pulls master, precompiles assets
# and restarts systemd units that only exist on the dev server; running it here
# would reset your branch and leave stale assets shadowing your edits.
#
#   bin/dev-local            # Puma on :3001 + Solid Queue + Sass
#   bin/dev-local 3005       # different port
#   bin/dev-local --cron     # also run the recurring schedule
#   bin/dev-local --no-jobs  # Puma and Sass only
# Solid Queue, Cache, and Cable use SQLite files in this checkout.
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
app_root=$(cd "$script_dir/.." && pwd)
cd "$app_root"

# Private Solid Queue, Cache, and Cable files for this checkout. The dev
# server, staging, and production never set this, so they stay on SQL Server.
export PAPERBOY_LOCAL_SOLID=1

PORT="${PORT:-3001}"
BIND="${BIND:-127.0.0.1}"
ENABLE_CRON=0
RUN_JOBS=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cron)     ENABLE_CRON=1; shift ;;
    --no-jobs)  RUN_JOBS=0; shift ;;
    -p|--port)  PORT="$2"; shift 2 ;;
    [0-9]*)     PORT="$1"; shift ;;
    -h|--help)  sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "unknown option: $1 (try --help)" >&2; exit 1 ;;
  esac
done

mkdir -p "$app_root/log"
exec 2> >(tee "$app_root/log/error.log" >&2)
mkdir -p "$app_root/tmp/pids"
pid_file="$app_root/tmp/pids/paperboy-dev-$PORT.pids"
startup_complete=0

on_startup_failure() {
  local status=$?

  if [[ "$startup_complete" -eq 0 ]]; then
    echo "==> Paperboy startup failed; stopping children" >&2
    stop_servers "$PORT" || true
    rm -f "$pid_file"
  fi
  exit "$status"
}

trap on_startup_failure EXIT

# --- Preflight -------------------------------------------------------------
if [[ ! -f .env ]]; then
  echo "==> .env is missing. Rails cannot boot without GSABSS_* and the" >&2
  echo "    ACTIVE_RECORD_ENCRYPTION_* keys; run bin/env-pull to copy it from LockBox." >&2
  exit 1
fi

# --- Shutdown --------------------------------------------------------------
source "$script_dir/stopservers"
stop_servers "$PORT"
rm -f "$pid_file"

if ss -ltn 2>/dev/null | grep -qE "[:.]${PORT}[[:space:]]"; then
  echo "==> Port ${PORT} is already in use. Pass another: bin/dev-local 3002" >&2
  exit 1
fi

start_component() {
  local label=$1 log_file=$2
  shift 2

  echo "==> Starting ${label}..."
  nohup setsid "$@" </dev/null >>"$log_file" 2>&1 &
  local pid=$!
  echo "$pid" >>"$pid_file"

  for _ in {1..25}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "==> ${label} exited during startup; see ${log_file}" >&2
      tail -20 "$log_file" >&2 || true
      return 1
    fi
    sleep 0.2
  done

  echo "==> ${label} started (pid ${pid}); see ${log_file}"
}

wait_for_port() {
  local label=$1 port=$2

  for _ in {1..25}; do
    if ss -ltn 2>/dev/null | grep -qE "[:.]${port}[[:space:]]"; then
      return
    fi
    sleep 0.2
  done

  echo "==> ${label} did not open port ${port}; see ${app_root}/log/server.log" >&2
  tail -20 "$app_root/log/server.log" >&2 || true
  return 1
}

# --- Local Solid databases -------------------------------------------------
echo "==> Preparing local Solid databases..."
bundle check || bundle install
mkdir -p "$app_root/storage"
bundle exec rails local_solid:prepare

# --- Assets -----------------------------------------------------------------
{
  bundle check || bundle install
  bundle exec bin/rails assets:clobber
  bundle exec bin/rails assets:precompile
} 2>&1 | tee "$app_root/log/assets.log"

# --- Dart Sass --------------------------------------------------------------
echo "==> Starting Dart Sass watcher..."
start_component 'Dart Sass' "$app_root/log/sass.log" \
  bundle exec rails dartsass:watch

# --- Solid Queue -----------------------------------------------------------
if [[ "$RUN_JOBS" -eq 1 ]]; then
  if [[ "$ENABLE_CRON" -ne 1 ]]; then
    export SOLID_QUEUE_CONFIG="$app_root/config/queue.yml"
    export SOLID_QUEUE_SKIP_RECURRING=true
  fi

  start_component 'Solid Queue' "$app_root/log/jobs.log" \
    bundle exec bin/jobs
fi

# --- Puma ------------------------------------------------------------------
echo "==> Starting Puma on http://${BIND}:${PORT} ..."
start_component 'Puma' "$app_root/log/server.log" \
  bundle exec rails server -p "$PORT" -b "$BIND"
wait_for_port 'Puma' "$PORT"

startup_complete=1
echo "==> Paperboy started. Logs are under $app_root/log/"
