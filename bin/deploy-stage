#!/bin/bash
set -e

APP_DIR="/home/matthew/gitea/Paperboy"
# Stage and prod deploy a release tag, never a branch tip: dev tags the commit
# it has checked with bin/tag-master-commit, and the same tag then goes to
# stage and on to prod, so prod only ever runs code that was on dev and stage.
# The leading "v" is optional: 2.1.0-a1a91a09e and v2.1.0-a1a91a09e both work.
if [ -z "$1" ]; then
  echo "Usage: bin/deploy-stage <tag>   e.g. bin/deploy-stage v2.1.0-a1a91a09e" >&2
  echo "Recent tags:" >&2
  git -C "$APP_DIR" fetch -q origin --tags
  git -C "$APP_DIR" tag --list 'v*' --sort=-creatordate | head -5 | sed 's/^/  /' >&2
  exit 2
fi
TAG="v${1#v}"
cd "$APP_DIR"

# Installs a unit file unless /etc/systemd/system already symlinks straight at
# the repo copy, where git pull has updated it already and cp would fail with
# "are the same file" — aborting the deploy under set -e, after the migrations
# have run but before anything restarts.
sync_unit() {
  local src="$APP_DIR/config/systemd/$1"
  local dst="/etc/systemd/system/$1"
  if [ "$(readlink -f "$src")" = "$(readlink -f "$dst")" ]; then
    echo "    $1 already links to the repo copy"
  else
    sudo cp "$src" "$dst"
  fi
}

echo "==> Fetching and checking out tag: $TAG ..."
git fetch origin --tags

if ! git rev-parse -q --verify "refs/tags/$TAG^{commit}" >/dev/null; then
  echo "!!! No tag $TAG on origin. Tag it on dev with bin/tag-master-commit." >&2
  exit 1
fi

# A detached checkout leaves the box on exactly the tagged commit. Local edits
# would either block it or ride along into the deploy, so refuse them.
# db/schema.rb is exempt: db:prepare below rewrites it on every deploy.
if ! git diff --quiet HEAD -- . ':!db/schema.rb'; then
  echo "!!! Uncommitted changes in $APP_DIR -- stash or discard them first:" >&2
  git status --short -- . ':!db/schema.rb' >&2
  exit 1
fi

git checkout -q -- db/schema.rb
git checkout --detach "refs/tags/$TAG"

echo "==> Installing gems..."
# The full bundle, development and test groups included. config/application.rb
# runs Bundler.require(*Rails.groups), so staging loads neither group whether or
# not it is installed; excluding them saved disk and nothing else. What it cost
# was a boot: the exclusion lived only in this script, while the systemd units
# run bundle exec with none, so Bundler resolved the whole lockfile and refused
# to start the moment a lint gem version drifted from what was installed here.
# That was the 502 on 2026-09-27. bin/deploy-dev has always installed the lot.
bundle install

echo "==> Preparing application and Solid adapter databases..."
# dotenv-rails loads .env for every rails command below, the same way it does
# in bin/deploy and bin/deploy-dev.
# .env is shared with the dev host and names Paperboy_Dev. Stage has its own
# database, so override it here exactly as paperboy-stage.service does — this
# is the line that keeps a stage deploy off dev's data.
export PAPERBOY_DATABASE=Paperboy_Stage
RAILS_ENV=staging bundle exec rails db:prepare

# Each environment keeps uploads under its own storage/ root. Copies the files
# this database references out of the shared pre-split folder; idempotent.
# See lib/tasks/storage.rake.
echo "==> Adopting pre-split Active Storage files..."
RAILS_ENV=staging bundle exec rails storage:adopt_legacy

# Additive: creates the groups, grants and group memberships from db/acl.yml
# that are missing here, and never removes anything. Grants for a form stage
# does not have yet are held back and reported, not applied; so are memberships
# for anyone no longer in GSABSS. Contractor memberships never travel — their
# ids are local to each database — so grant those by hand here.
echo "==> Syncing ACL definitions..."
RAILS_ENV=staging bundle exec rails acl:sync

# Dev is the source of truth for form definitions. Creates the forms in
# db/forms.yml that are missing here and makes each one's template, statuses,
# routing steps, emails, email rules and copy recipients match the file -- the
# .erb views have always travelled through git, the rows behind them never did.
# Fields are added and updated but not removed; run PRUNE=1 by hand if you want
# fields dropped. After acl:sync, so a field or routing step tied to a group
# finds it. See lib/tasks/forms.rake.
echo "==> Syncing form definitions..."
RAILS_ENV=staging bundle exec rails forms:sync

# acl:sync holds back a grant for a form this database does not have. The
# forms:sync above may just have created that form, so the second pass applies
# what the first withheld and the form opens on the deploy that brings it.
echo "==> Syncing ACL grants for newly created forms..."
RAILS_ENV=staging bundle exec rails acl:sync

echo "==> Clobbering old assets..."
RAILS_ENV=staging bundle exec rails assets:clobber

echo "==> Precompiling assets..."
RAILS_ENV=staging bundle exec rails assets:precompile

# The units carry PAPERBOY_DATABASE=Paperboy_Stage, so a stale copy in
# /etc/systemd/system leaves the app on dev's database while this script
# migrates stage. bin/deploy does the same for the prod units.
echo "==> Syncing systemd units..."
sync_unit paperboy-stage.service
sync_unit paperboy-stage-jobs.service
sudo systemctl daemon-reload

echo "==> Restarting Puma..."
sudo systemctl restart paperboy-stage

echo "==> Restarting Solid Queue..."
sudo systemctl disable --now paperboy-stage-sidekiq 2>/dev/null || true
sudo systemctl enable paperboy-stage-jobs
sudo systemctl restart paperboy-stage-jobs

echo "==> Stage deploy complete!"
