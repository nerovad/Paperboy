#!/bin/bash
set -e

APP_DIR="/home/matthew/gitea/Paperboy"
BRANCH="${1:-master}"
cd "$APP_DIR"

# Installs a unit file unless /etc/systemd/system already symlinks straight at
# the repo copy, where git pull has updated it already and cp would fail with
# "are the same file" — aborting the deploy under set -e, after the migrations
# have run but before anything restarts.
sync_unit() {
  local src="$APP_DIR/config/systemd/$1"
  local dst="/etc/systemd/system/$1"
  if [ "$(readlink -f "$src")" = "$(readlink -f "$dst")" ]; then
    echo "    $1 already links to the repo copy"
  else
    sudo cp "$src" "$dst"
  fi
}

echo "==> Fetching and checking out branch: $BRANCH ..."
git fetch origin
git checkout "$BRANCH"
git pull origin "$BRANCH"

echo "==> Installing gems..."
bundle install --without development test

echo "==> Running migrations..."
# staging isn't in the dotenv-rails group, so load the same env file systemd
# hands to Puma (EnvironmentFile=.env) before running any rails command.
set -a; source "$APP_DIR/.env"; set +a
# .env is shared with the dev host and names Paperboy_Dev. Stage has its own
# database, so override it here exactly as paperboy-stage.service does — this
# is the line that keeps a stage deploy off dev's data.
export PAPERBOY_DATABASE=Paperboy_Stage
RAILS_ENV=staging bundle exec rails db:migrate

# Additive: creates groups and grants from db/acl.yml that are missing here,
# never removes anything and never touches memberships. Grants for a form that
# stage does not have yet are held back and reported, not applied.
echo "==> Syncing ACL definitions..."
RAILS_ENV=staging bundle exec rails acl:sync

echo "==> Clobbering old assets..."
RAILS_ENV=staging bundle exec rails assets:clobber

echo "==> Precompiling assets..."
RAILS_ENV=staging bundle exec rails assets:precompile

# The units carry PAPERBOY_DATABASE=Paperboy_Stage, so a stale copy in
# /etc/systemd/system leaves the app on dev's database while this script
# migrates stage. bin/deploy does the same for the prod units.
echo "==> Syncing systemd units..."
sync_unit paperboy-stage.service
sync_unit paperboy-stage-sidekiq.service
sudo systemctl daemon-reload

echo "==> Restarting Puma..."
sudo systemctl restart paperboy-stage

echo "==> Restarting Sidekiq..."
sudo systemctl restart paperboy-stage-sidekiq

echo "==> Stage deploy complete!"
