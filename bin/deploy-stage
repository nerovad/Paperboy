#!/bin/bash
set -e

APP_DIR="/home/matthew/gitea/Paperboy"
BRANCH="${1:-master}"
cd "$APP_DIR"

# Installs a unit file unless /etc/systemd/system already symlinks straight at
# the repo copy, where git pull has updated it already and cp would fail with
# "are the same file" — aborting the deploy under set -e, after the migrations
# have run but before anything restarts.
sync_unit() {
  local src="$APP_DIR/config/systemd/$1"
  local dst="/etc/systemd/system/$1"
  if [ "$(readlink -f "$src")" = "$(readlink -f "$dst")" ]; then
    echo "    $1 already links to the repo copy"
  else
    sudo cp "$src" "$dst"
  fi
}

echo "==> Fetching and checking out branch: $BRANCH ..."
git fetch origin
git checkout "$BRANCH"
git pull origin "$BRANCH"

echo "==> Installing gems..."
# An environment variable, not --without: that flag is saved to .bundle/config,
# and this checkout is also the development tree, where the saved exclusion
# hides the debug gem and every plain bin/rails command fails to boot.
export BUNDLE_WITHOUT=development:test
bundle install

echo "==> Preparing application and Solid adapter databases..."
# dotenv-rails loads .env for every rails command below, the same way it does
# in bin/deploy and bin/deploy-dev.
# .env is shared with the dev host and names Paperboy_Dev. Stage has its own
# database, so override it here exactly as paperboy-stage.service does — this
# is the line that keeps a stage deploy off dev's data.
export PAPERBOY_DATABASE=Paperboy_Stage
RAILS_ENV=staging bundle exec rails db:prepare

# Each environment keeps uploads under its own storage/ root. Copies the files
# this database references out of the shared pre-split folder; idempotent.
# See lib/tasks/storage.rake.
echo "==> Adopting pre-split Active Storage files..."
RAILS_ENV=staging bundle exec rails storage:adopt_legacy

# Additive: creates the groups, grants and group memberships from db/acl.yml
# that are missing here, and never removes anything. Grants for a form stage
# does not have yet are held back and reported, not applied; so are memberships
# for anyone no longer in GSABSS. Contractor memberships never travel — their
# ids are local to each database — so grant those by hand here.
echo "==> Syncing ACL definitions..."
RAILS_ENV=staging bundle exec rails acl:sync

# Additive: creates the form templates' fields from db/forms.yml that are
# missing here and updates the ones whose definition has changed, so a dropdown
# configured in dev's form builder actually reaches this database -- the .erb
# views have always travelled through git, the rows behind them never did.
# Nothing is removed; run PRUNE=1 by hand if you want fields dropped. A form
# with no template here is held back and reported rather than invented, since a
# template carries workflow this file does not: CREATE_TEMPLATES=1 opts in to a
# bare one. After acl:sync, so a field restricted to a group finds it.
# See lib/tasks/forms.rake.
echo "==> Syncing form definitions..."
RAILS_ENV=staging bundle exec rails forms:sync

echo "==> Clobbering old assets..."
RAILS_ENV=staging bundle exec rails assets:clobber

echo "==> Precompiling assets..."
RAILS_ENV=staging bundle exec rails assets:precompile

# The units carry PAPERBOY_DATABASE=Paperboy_Stage, so a stale copy in
# /etc/systemd/system leaves the app on dev's database while this script
# migrates stage. bin/deploy does the same for the prod units.
echo "==> Syncing systemd units..."
sync_unit paperboy-stage.service
sync_unit paperboy-stage-jobs.service
sudo systemctl daemon-reload

echo "==> Restarting Puma..."
sudo systemctl restart paperboy-stage

echo "==> Restarting Solid Queue..."
sudo systemctl disable --now paperboy-stage-sidekiq 2>/dev/null || true
sudo systemctl enable paperboy-stage-jobs
sudo systemctl restart paperboy-stage-jobs

echo "==> Stage deploy complete!"
