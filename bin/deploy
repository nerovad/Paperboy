#!/bin/bash
set -e

APP_DIR="/home/matthew/gitea/Paperboy"
# Stage and prod deploy a release tag, never a branch tip: dev tags the commit
# it has checked with bin/tag-master-commit, and the same tag then goes to
# stage and on to prod, so prod only ever runs code that was on dev and stage.
# The leading "v" is optional: 2.1.0-a1a91a09e and v2.1.0-a1a91a09e both work.
if [ -z "$1" ]; then
  echo "Usage: bin/deploy <tag>   e.g. bin/deploy v2.1.0-a1a91a09e" >&2
  echo "Recent tags:" >&2
  git -C "$APP_DIR" fetch -q origin --tags
  git -C "$APP_DIR" tag --list 'v*' --sort=-creatordate | head -5 | sed 's/^/  /' >&2
  exit 2
fi
TAG="v${1#v}"
cd "$APP_DIR"

# Installs a unit file unless /etc/systemd/system already symlinks straight at
# the repo copy, where git pull has updated it already and cp would fail with
# "are the same file" — aborting the deploy under set -e, after the migrations
# have run but before anything restarts.
sync_unit() {
  local src="$APP_DIR/config/systemd/$1"
  local dst="/etc/systemd/system/$1"
  if [ "$(readlink -f "$src")" = "$(readlink -f "$dst")" ]; then
    echo "    $1 already links to the repo copy"
  else
    sudo cp "$src" "$dst"
  fi
}

echo "==> Fetching and checking out tag: $TAG ..."
git fetch origin --tags

if ! git rev-parse -q --verify "refs/tags/$TAG^{commit}" >/dev/null; then
  echo "!!! No tag $TAG on origin. Tag it on dev with bin/tag-master-commit." >&2
  exit 1
fi

# A detached checkout leaves the box on exactly the tagged commit. Local edits
# would either block it or ride along into the deploy, so refuse them.
# db/schema.rb is exempt: db:prepare below rewrites it on every deploy.
if ! git diff --quiet HEAD -- . ':!db/schema.rb'; then
  echo "!!! Uncommitted changes in $APP_DIR -- stash or discard them first:" >&2
  git status --short -- . ':!db/schema.rb' >&2
  exit 1
fi

git checkout -q -- db/schema.rb
git checkout --detach "refs/tags/$TAG"

echo "==> Installing gems..."
# The full bundle, development and test groups included. config/application.rb
# runs Bundler.require(*Rails.groups), so production loads neither group
# whether or not it is installed; excluding them saved disk and nothing else.
# What it cost was a boot: the exclusion lived only in this script, while the
# systemd units run bundle exec with none, so Bundler resolved the whole
# lockfile and refused to start the moment a lint gem version drifted from what
# was installed here. That was the stage 502 on 2026-09-27. bin/deploy-dev has
# always installed the lot.
bundle install

echo "==> Preparing application and Solid adapter databases..."
RAILS_ENV=production bundle exec rails db:prepare

# Each environment keeps uploads under its own storage/ root. Copies the files
# this database references out of the shared pre-split folder; idempotent.
# See lib/tasks/storage.rake.
echo "==> Adopting pre-split Active Storage files..."
RAILS_ENV=production bundle exec rails storage:adopt_legacy

# Additive: creates the groups, grants and group memberships from db/acl.yml
# that are missing here, and never removes anything. Run PRUNE=1 by hand if you
# actually want grants or memberships dropped. Contractor memberships never
# travel — their ids are local to each database — so grant those by hand here.
# See lib/tasks/acl.rake.
echo "==> Syncing ACL definitions..."
RAILS_ENV=production bundle exec rails acl:sync

# Additive: creates the form templates' fields from db/forms.yml that are
# missing here and updates the ones whose definition has changed, so a dropdown
# configured in dev's form builder actually reaches this database -- the .erb
# views have always travelled through git, the rows behind them never did.
# Nothing is removed; run PRUNE=1 by hand if you want fields dropped. A form
# with no template here is held back and reported rather than invented, since a
# template carries workflow this file does not: CREATE_TEMPLATES=1 opts in to a
# bare one. After acl:sync, so a field restricted to a group finds it.
# See lib/tasks/forms.rake.
echo "==> Syncing form definitions..."
RAILS_ENV=production bundle exec rails forms:sync

echo "==> Clobbering old assets..."
RAILS_ENV=production bundle exec rails assets:clobber

echo "==> Precompiling assets..."
RAILS_ENV=production bundle exec rails assets:precompile

echo "==> Syncing systemd units..."
sync_unit paperboy.service
sync_unit paperboy-jobs.service
sudo systemctl daemon-reload
sudo systemctl disable --now paperboy-sidekiq 2>/dev/null || true

echo "==> Restarting Puma..."
sudo systemctl restart paperboy

echo "==> Restarting Solid Queue..."
sudo systemctl enable paperboy-jobs
sudo systemctl restart paperboy-jobs

echo "==> Deploy complete!"
