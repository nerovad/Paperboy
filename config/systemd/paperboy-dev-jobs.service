[Unit]
Description=Paperboy Solid Queue Worker (Development)
After=network.target

[Service]
Type=simple
User=matthew
Group=matthew
WorkingDirectory=/home/matthew/gitea/Paperboy

EnvironmentFile=/home/matthew/gitea/Paperboy/.env
Environment=RAILS_ENV=development

ExecStart=/bin/bash -lc 'bundle exec bin/jobs'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
