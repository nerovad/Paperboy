<div class="form-header billing-form-header">
  <h1>Email Subject List</h1>
</div>

<div class="form-wrapper billing-form billing-email-subjects">
  <p>Available placeholders: <code>%{fiscal_year}</code>, <code>%{apmon}</code>, and <code>%{type}</code>.</p>

  <%= form_with url: billing_email_subjects_path, method: :patch,
                id: "billing-email-subject-form", data: { turbo: false } do %>
    <div class="billing-period-grid">
      <table class="submission-table">
        <colgroup>
          <col class="billing-subject-type-column">
          <col class="billing-subject-name-column">
          <col class="billing-subject-format-column">
        </colgroup>
        <thead>
          <tr>
            <th>Type</th>
            <th>Name</th>
            <th>Subject Format</th>
          </tr>
        </thead>
        <tbody>
          <% @subjects.each do |subject| %>
            <tr>
              <td><%= subject.billing_type %></td>
              <td><%= @type_names.fetch(subject.billing_type).name %></td>
              <td class="billing-subject-format-cell">
                <%= text_field_tag "subjects[#{subject.billing_type}]", subject.subject_format,
                                   class: "form-control billing-subject-format-input", required: true,
                                   aria: { label: "Subject format for #{subject.billing_type}" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  <% end %>

  <div class="form-actions">
    <%= button_tag "Save", type: :submit, form: "billing-email-subject-form",
                           class: "btn approve" %>
    <%= button_tag "Reset", type: :reset, form: "billing-email-subject-form",
                            class: "btn deny" %>
    <%= button_to "Cancel", billing_root_path, method: :get, class: "btn ghost" %>
  </div>
</div>
