<div class="form-header billing-form-header">
  <h1>Email Billing Reports</h1>
</div>

<div class="form-wrapper billing-form billing-email-reports">
  <%= render "billing/shared/active_billing_period",
             active_billing_period: @active_billing_period %>

  <%= form_with url: billing_email_reports_path, method: :post, data: { turbo: false } do %>
    <div class="billing-period-grid">
      <table class="submission-table">
        <thead>
          <tr>
            <th>Billing Report</th>
            <th>Email</th>
          </tr>
        </thead>
        <tbody>
          <% @reports.each do |report| %>
            <tr>
              <td><%= report.name %></td>
              <td>
                <%= render "billing/shared/boolean_toggle",
                           name: "reports[#{report.name}]",
                           id_prefix: "report_#{report.name.parameterize}",
                           checked: @selected_names.include?(report.name),
                           aria_label: "Email #{report.name}" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @reports.empty? %>
      <p>No Billing reports have been generated.</p>
    <% end %>

    <div class="form-actions">
      <%= submit_tag "Preview", class: "button primary", disabled: @reports.empty? %>
      <%= submit_tag "Send", class: "button primary", disabled: @reports.empty? %>
      <%= link_to "Reset", billing_email_reports_path, class: "button reset" %>
      <%= link_to "Cancel", billing_root_path, class: "button cancel" %>
    </div>
  <% end %>

  <% if @preview_output.present? %>
    <section class="billing-refresh-result" aria-labelledby="billing-email-preview-title">
      <h2 id="billing-email-preview-title">Email Preview</h2>
      <%= render "shared/captured_output", output: @preview_output %>
    </section>
  <% end %>
</div>
