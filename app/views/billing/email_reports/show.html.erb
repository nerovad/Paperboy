<div class="form-header billing-form-header">
  <h1>Email Billing Reports</h1>
</div>

<div class="form-wrapper billing-form billing-email-reports">
  <%= render "billing/shared/active_billing_period",
             active_billing_period: @active_billing_period %>

  <%= form_with url: billing_email_reports_path, method: :post,
                id: "billing-email-report-form", data: { turbo: false } do %>
    <section>
      <h2>Email Recipients</h2>
      <div class="billing-period-grid">
        <table class="submission-table">
          <thead>
            <tr>
              <th>Email Recipient</th>
              <th>Email</th>
            </tr>
          </thead>
          <tbody>
            <% @recipients.each do |recipient| %>
              <tr>
                <td><%= recipient.email_address %></td>
                <td>
                  <%= render "billing/shared/boolean_toggle",
                             name: "recipients[#{recipient.id}]",
                             id_prefix: "recipient_#{recipient.id}",
                             checked: @selected_recipient_ids.include?(recipient.id.to_s),
                             aria_label: "Email #{recipient.email_address}" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @recipients.empty? %>
        <p>No email recipients have been configured.</p>
      <% end %>

      <div class="form-actions billing-recipient-actions">
        <%= button_tag "Clear", type: :submit, name: :recipient_action, value: :clear,
                                class: "button cancel" %>
        <%= button_tag "Reset", type: :submit, name: :recipient_action, value: :reset,
                                class: "button reset" %>
      </div>
    </section>

    <h2>Billing Reports</h2>
    <div class="billing-period-grid">
      <table class="submission-table">
        <thead>
          <tr>
            <th>Billing Report</th>
            <th>Email</th>
          </tr>
        </thead>
        <tbody>
          <% @reports.each do |report| %>
            <tr>
              <td><%= report.name %></td>
              <td>
                <%= render "billing/shared/boolean_toggle",
                           name: "reports[#{report.name}]",
                           id_prefix: "report_#{report.name.parameterize}",
                           checked: @selected_names.include?(report.name),
                           aria_label: "Email #{report.name}" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @reports.empty? %>
      <p>No Billing reports have been generated.</p>
    <% end %>

  <% end %>

  <div class="form-actions">
    <%= button_tag "Preview", type: :submit, name: :commit, value: "Preview",
                              form: "billing-email-report-form", class: "btn pdf",
                              disabled: @reports.empty? %>
    <%= button_tag "Send", type: :submit, name: :commit, value: "Send",
                           form: "billing-email-report-form", class: "btn approve",
                           disabled: @reports.empty? %>
    <%= button_to "Reset", billing_email_reports_path, method: :get, class: "btn warning" %>
    <%= button_to "Cancel", billing_root_path, method: :get, class: "btn ghost" %>
  </div>

  <% if @preview_output.present? %>
    <section class="billing-refresh-result billing-email-preview"
             aria-labelledby="billing-email-preview-title">
      <h2 id="billing-email-preview-title">Email Preview</h2>
      <%= render "shared/captured_output", output: @preview_output %>
    </section>
  <% end %>
</div>
