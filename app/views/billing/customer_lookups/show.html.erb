<section class="billing-page customer-lookup-page">
  <div class="billing-form-header">
    <h1>Customer Lookup</h1>
  </div>

  <section class="customer-lookup-card" aria-labelledby="customer-lookup-search-title">
    <h2 id="customer-lookup-search-title">Search</h2>
    <%= form_with url: billing_customer_lookup_path, method: :post,
                  data: { turbo: false, controller: "date-range",
                          action: "submit->date-range#validate" } do %>
      <div class="customer-lookup-fields">
        <div class="form-group">
          <%= label_tag "customer_lookup_start_date", "Start Date" %>
          <%= date_field_tag "customer_lookup[start_date]", @start_date,
                             id: "customer_lookup_start_date", required: true,
                             data: { date_range_target: "startDate",
                                     action: "input->date-range#validateRange" } %>
        </div>
        <div class="form-group">
          <%= label_tag "customer_lookup_end_date", "End Date" %>
          <%= date_field_tag "customer_lookup[end_date]", @end_date,
                             id: "customer_lookup_end_date", required: true,
                             data: { date_range_target: "endDate",
                                     action: "input->date-range#validateRange" } %>
        </div>
        <div class="form-group customer-lookup-unit-field">
          <%= label_tag "customer_lookup_budget_unit", "Budget Unit" %>
          <%= search_field_tag "customer_lookup[budget_unit]",
                               params.dig(:customer_lookup, :budget_unit),
                               id: "customer_lookup_budget_unit",
                               placeholder: "Enter a budget unit number…", required: true %>
        </div>
      </div>
      <div class="form-actions"><%= submit_tag "Search", class: "btn approve compact" %></div>
    <% end %>
  </section>

  <% if params.dig(:customer_lookup, :budget_unit).present? && @unit.nil? %>
    <p class="customer-lookup-status">No matching budget units found.</p>
  <% elsif @unit && @rows.nil? %>
    <p class="customer-lookup-status">No services found for this budget unit and date range.</p>
  <% elsif @rows %>
    <section class="customer-lookup-card customer-lookup-results" aria-labelledby="customer-lookup-results-title">
      <h2 id="customer-lookup-results-title">Services</h2>
      <% if @rows.empty? %>
        <p>No services found for this budget unit and date range.</p>
      <% else %>
        <p class="customer-lookup-total"><strong>Total Amount:</strong>
          <%= number_to_currency(@rows.sum { |row| row[:amount].to_f }) %></p>
        <% group_columns = %w[agency division department unit service] %>
        <% detail_columns = %w[doc_nmbr description date other1 other2 other3 rate quantity amount] %>
        <% detail_labels = { "doc_nmbr" => "Document#" } %>
        <% sortable_columns = %w[doc_nmbr date amount] %>
        <% grouped_rows = @rows.group_by { |row| group_columns.map { |column| row[column.to_sym] } } %>
        <div class="customer-lookup-grid-wrap" data-controller="customer-lookup-rows">
          <div class="customer-lookup-grid">
            <div class="customer-lookup-grid-header" role="row">
              <div class="customer-lookup-expand-column" role="columnheader" aria-label="Expand rows"></div>
              <% group_columns.each do |column| %><div role="columnheader"><%= column == "unit" ? "Cunit" : column.humanize %></div><% end %>
              <div role="columnheader">Amount</div>
            </div>
            <% grouped_rows.each_with_index do |(group_key, rows), index| %>
              <% detail_id = "customer-lookup-details-#{index}" %>
              <div class="customer-lookup-group">
                <div class="customer-lookup-summary-row" role="row">
                  <div class="customer-lookup-expand-column" role="cell">
                    <button type="button" class="customer-lookup-row-toggle"
                            data-action="customer-lookup-rows#toggle"
                            data-detail-id="<%= detail_id %>"
                            aria-controls="<%= detail_id %>" aria-expanded="false"
                            aria-label="Show details">
                      <span aria-hidden="true">▸</span>
                    </button>
                  </div>
                  <% group_key.each do |value| %><div role="cell"><%= value %></div><% end %>
                  <div class="numeric" role="cell"><%= number_to_currency(rows.sum { |row| row[:amount].to_f }) %></div>
                </div>
                <div id="<%= detail_id %>" class="customer-lookup-detail-row" hidden>
                    <table class="customer-lookup-detail-table">
                      <thead>
                        <tr>
                          <% detail_columns.each do |column| %>
                            <th>
                              <% label = detail_labels.fetch(column, column.humanize) %>
                              <% if sortable_columns.include?(column) %>
                                <button type="button" class="customer-lookup-sort"
                                        data-action="customer-lookup-rows#sort"
                                        data-sort-key="<%= column %>"
                                        data-sort-direction="none"><%= label %> <span class="customer-lookup-sort-indicator" aria-hidden="true">↕</span></button>
                              <% else %>
                                <%= label %>
                              <% end %>
                            </th>
                          <% end %>
                        </tr>
                      </thead>
                      <tbody>
                        <% rows.each do |row| %>
                          <tr>
                            <% detail_columns.each do |column| %>
                              <td class="<%= %w[quantity rate amount].include?(column) ? "numeric" : nil %>"
                                  data-sort-value="<%= row[column.to_sym] %>">
                                <%= if column == "amount"
                                  number_to_currency(row[column.to_sym])
                                elsif %w[quantity rate].include?(column)
                                  number_with_precision(row[column.to_sym], precision: 2)
                                else
                                  row[column.to_sym]
                                end %>
                              </td>
                            <% end %>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>
</section>
