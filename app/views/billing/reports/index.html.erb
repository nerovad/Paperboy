<div class="form-header billing-form-header">
  <h1>Billing Reports</h1>
</div>

<div class="form-wrapper billing-form billing-report-files">
  <%= render "billing/shared/active_billing_period",
             active_billing_period: @active_billing_period %>

  <% if @report_files.any? %>
    <div class="billing-period-grid">
      <table class="submission-table">
        <thead>
          <tr>
            <% { "File" => "file", "Modified" => "modified", "Size" => "size", "View" => "action" }.each do |label, column| %>
              <th>
                <%= link_to billing_reports_path(sort: column, direction: report_sort_direction(column)),
                            class: "sortable-header", data: { turbo: false } do %>
                  <%= label %>
                  <span class="sort-indicator"><%= report_sort_indicator(column) %></span>
                <% end %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @report_files.each do |report_file| %>
            <tr>
              <td><%= report_file.filename %></td>
              <td><%= l(report_file.modified_at, format: :short) %></td>
              <td><%= number_to_human_size(report_file.size) %></td>
              <td>
                <%= link_to(report_file.pdf? ? "View" : "Download",
                            billing_report_path(report_file.filename),
                            class: "btn pdf compact", target: ("_blank" if report_file.pdf?)) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>No Billing reports have been generated.</p>
  <% end %>
</div>
