<div class="form-header billing-form-header">
  <h1>Refresh Data</h1>
</div>

<div class="form-wrapper billing-form billing-data-refresh">
  <%= render "billing/shared/active_billing_period",
             active_billing_period: @active_billing_period %>

  <%= form_with url: billing_data_refresh_path, method: :patch, data: { turbo: false } do %>
    <div class="billing-period-grid">
      <table class="submission-table billing-refresh-table" data-controller="billing-refresh-groups">
        <colgroup>
          <col class="billing-refresh-group-column">
          <col class="billing-refresh-count-column">
          <col class="billing-refresh-toggle-column">
        </colgroup>
        <thead>
          <tr>
            <th>Data Runner dslGroup</th>
            <th>Enabled DSLs</th>
            <th>Refresh</th>
          </tr>
        </thead>
        <tbody>
          <% @groups.each do |group| %>
            <% detail_id = "billing-refresh-#{group.key}-dsls" %>
            <tr class="billing-refresh-group-row">
              <td>
                <button type="button" class="billing-refresh-group-trigger"
                        aria-expanded="false" aria-controls="<%= detail_id %>"
                        data-action="billing-refresh-groups#toggle"
                        data-detail-id="<%= detail_id %>">
                  <span aria-hidden="true" class="billing-refresh-group-chevron">▸</span>
                  <%= group.label %>
                </button>
              </td>
              <td>
                <button type="button" class="billing-refresh-group-trigger"
                        aria-label="<%= group.enabled_dsl_count %> enabled DSLs in <%= group.label %>"
                        aria-expanded="false" aria-controls="<%= detail_id %>"
                        data-action="billing-refresh-groups#toggle"
                        data-detail-id="<%= detail_id %>">
                  <%= group.enabled_dsl_count %>
                </button>
              </td>
              <td>
                <%= render "billing/shared/boolean_toggle",
                           name: "groups[#{group.key}]",
                           id_prefix: "group_#{group.key}",
                           checked: group.default,
                           aria_label: "Refresh #{group.label}" %>
              </td>
            </tr>
            <tr id="<%= detail_id %>" class="billing-refresh-detail-row" hidden>
              <td colspan="3">
                <table class="billing-refresh-dsl-table">
                  <colgroup>
                    <col class="billing-refresh-dsl-name-column">
                    <col class="billing-refresh-dsl-location-column">
                    <col class="billing-refresh-dsl-date-column">
                  </colgroup>
                  <thead>
                    <tr>
                      <th>DSL Name</th>
                      <th>Location / Script</th>
                      <th>Date</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% group.enabled_dsls.each do |dsl| %>
                      <% row_status = dsl.script ? "is-script" : (dsl.current ? "is-current" : "is-stale") %>
                      <tr class="<%= row_status %>">
                        <td><%= dsl.name %></td>
                        <td><%= dsl.location.presence || "Unavailable" %></td>
                        <td>
                          <%= tag.time(dsl.file_date ? dsl.file_date.to_date.iso8601 : "Unavailable",
                                       datetime: dsl.file_date&.iso8601) %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="form-actions">
      <%= submit_tag "Refresh", class: "btn approve" %>
      <%= button_tag "Reset", type: :reset, class: "btn warning" %>
      <%= link_to "Cancel", billing_root_path, class: "btn" %>
    </div>
  <% end %>

  <% if @output.present? %>
    <section class="billing-refresh-result" aria-labelledby="billing-refresh-output-title">
      <h2 id="billing-refresh-output-title">Refresh Output</h2>
      <%= render "shared/captured_output", output: @output %>
    </section>
  <% end %>
</div>
