<div class="form-header billing-form-header">
  <h1>Refresh Data</h1>
</div>

<div class="form-wrapper billing-form billing-data-refresh">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Billing</p>
      <h2>Data refresh progress</h2>
    </div>
    <%= link_to "Back to Billing", billing_data_refresh_path, class: "btn" %>
  </div>

  <section class="progress-tracker" data-controller="progress-tracker"
           data-progress-tracker-url-value="<%= billing_data_refresh_run_status_path(@run) %>">
    <div data-progress-tracker-target="content">
      <%= render "shared/progress_tracker", **progress_tracker_locals(@run) %>
    </div>
  </section>
</div>
