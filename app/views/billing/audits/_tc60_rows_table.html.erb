<div class="billing-audit-rows-table">
  <table class="submission-table">
    <thead>
      <tr>
        <% rows.first.columns.each do |column| %>
          <th><%= column %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <tr>
          <% row.cells.each do |cell| %>
            <td class="<%= 'billing-audit-invalid-cell' if cell.invalid %>"><%= cell.value %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
