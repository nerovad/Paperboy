<div class="form-header billing-form-header">
  <h1>Billing Audit</h1>
</div>

<div class="form-wrapper billing-form billing-audit">
  <%= render "billing/shared/active_billing_period",
             active_billing_period: @active_billing_period %>

  <% if @audit_error %>
    <div class="dashboard-error" role="alert"><p><%= @audit_error %></p></div>
  <% elsif @active_billing_period.nil? %>
    <div class="dashboard-error" role="status">
      <p>Select an active Billing period before running the audit.</p>
    </div>
  <% else %>
    <% @audit_groups.each do |group, results| %>
      <section class="billing-audit-group" aria-labelledby="<%= group.key %>-title">
        <h2 id="<%= group.key %>-title"><%= group.label %></h2>
        <div class="billing-audit-grid">
          <% results.each do |result| %>
            <article class="billing-audit-card<%= ' billing-audit-card--failure' if result.count.positive? %>">
              <h3><%= result.label %></h3>
              <div class="billing-audit-count"><%= number_with_delimiter result.count %></div>
              <p><%= 'failure'.pluralize(result.count) %></p>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
