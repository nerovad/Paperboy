<div class="form-header billing-form-header">
  <h1>Billing Audit</h1>
</div>

<div class="form-wrapper billing-form billing-audit">
  <%= render "billing/shared/active_billing_period",
             active_billing_period: @active_billing_period %>

  <% if @audit_error %>
    <div class="dashboard-error" role="alert"><p><%= @audit_error %></p></div>
  <% elsif @active_billing_period.nil? %>
    <div class="dashboard-error" role="status">
      <p>Select an active Billing period before running the audit.</p>
    </div>
  <% else %>
    <section class="billing-audit-group" aria-labelledby="billing-types-title">
      <h2 id="billing-types-title">Billing Type Audit</h2>
      <% if @billing_type_audits.any? %>
        <div class="billing-audit-grid">
          <% @billing_type_audits.each do |result| %>
            <% type_card_classes = "billing-audit-card billing-type-audit-card#{' billing-audit-card--failure' if result.error_count.positive?}" %>
            <% type_card = capture do %>
              <h3><%= result.code %></h3>
              <p><%= result.name.presence || result.code %></p>
              <div class="billing-type-audit-counts">
                <div>
                  <span class="billing-audit-count"><%= number_with_delimiter result.row_count %></span>
                  <span>Rows</span>
                </div>
                <div>
                  <span class="billing-audit-count"><%= number_with_delimiter result.error_count %></span>
                  <span>Errors</span>
                </div>
              </div>
            <% end %>
            <% if result.error_count.positive? %>
              <%= link_to billing_type_audit_rows_path(result.code),
                          class: "#{type_card_classes} billing-audit-card--link" do %>
                <%= type_card %>
              <% end %>
            <% else %>
              <article class="<%= type_card_classes %>"><%= type_card %></article>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p>No active Billing types are enabled.</p>
      <% end %>
    </section>

    <section class="billing-audit-group" aria-labelledby="cost-analysis-title">
      <h2 id="cost-analysis-title">Cost Analysis</h2>
      <div class="billing-audit-grid">
        <% amount_cost_failed = !@cost_analysis.amount_cost_variance.zero? %>
        <% amount_cost_card = capture do %>
          <h3>Amount vs Cost</h3>
          <p class="billing-audit-formula">Amount − Cost</p>
          <div class="billing-audit-count"><%= number_to_currency @cost_analysis.amount_cost_variance %></div>
        <% end %>
        <% if amount_cost_failed %>
          <%= link_to billing_cost_audit_rows_path(:amount_vs_cost),
                      class: "billing-audit-card billing-audit-card--failure billing-audit-card--link" do %>
            <%= amount_cost_card %>
          <% end %>
        <% else %>
          <article class="billing-audit-card"><%= amount_cost_card %></article>
        <% end %>
      </div>
    </section>

    <% @audit_groups.each do |group, results| %>
      <section class="billing-audit-group" aria-labelledby="<%= group.key %>-title">
        <h2 id="<%= group.key %>-title"><%= group.label %></h2>
        <div class="billing-audit-grid">
          <% results.each do |result| %>
            <% card_classes = "billing-audit-card#{' billing-audit-card--failure' if result.count.positive?}" %>
            <% card = capture do %>
              <h3><%= result.label %></h3>
              <div class="billing-audit-count"><%= number_with_delimiter result.count %></div>
              <p><%= 'Error'.pluralize(result.count) %></p>
            <% end %>
            <% if result.count.positive? %>
              <%= link_to billing_audit_detail_path(result.key), class: "#{card_classes} billing-audit-card--link" do %>
                <%= card %>
              <% end %>
            <% else %>
              <article class="<%= card_classes %>"><%= card %></article>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
