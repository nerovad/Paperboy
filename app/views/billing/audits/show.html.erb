<div class="form-header billing-form-header">
  <h1>Billing Audit</h1>
</div>

<div class="form-wrapper billing-form billing-audit">
  <%= render "billing/shared/active_billing_period",
             active_billing_period: @active_billing_period %>

  <% if @audit_error %>
    <div class="dashboard-error" role="alert"><p><%= @audit_error %></p></div>
  <% elsif @active_billing_period.nil? %>
    <div class="dashboard-error" role="status">
      <p>Select an active Billing period before running the audit.</p>
    </div>
  <% else %>
    <section class="billing-audit-group" aria-labelledby="billing-types-title">
      <h2 id="billing-types-title">Billing Type Audit</h2>
      <% if @billing_type_audits.any? %>
        <div class="billing-type-audit-table-wrapper">
          <table class="billing-type-audit-table" aria-labelledby="billing-types-title">
            <thead>
              <tr>
                <th scope="col" aria-label="Status"></th>
                <th scope="col">Type</th>
                <th scope="col">Name</th>
                <th scope="col">Rows</th>
                <th scope="col">Errors</th>
                <th scope="col">Total Cost</th>
              </tr>
            </thead>
            <tbody>
              <% @billing_type_audits.each do |result| %>
                <% failed = result.error_count.positive? %>
                <%= tag.tr class: ("clickable-row" if failed),
                           data: (failed ? { controller: "clickable-row", action: "click->clickable-row#click",
                                             href: billing_type_audit_rows_path(result.code) } : {}) do %>
                  <td>
                    <span class="billing-type-audit-status<%= ' billing-type-audit-status--failure' if failed %>"
                          role="img" aria-label="<%= failed ? 'Errors found' : 'No errors' %>"><%= failed ? '✕' : '✓' %></span>
                  </td>
                  <th scope="row">
                    <% if failed %>
                      <%= link_to result.code, billing_type_audit_rows_path(result.code) %>
                    <% else %>
                      <%= result.code %>
                    <% end %>
                  </th>
                  <td><%= result.name.presence || result.code %></td>
                  <td><%= number_with_delimiter result.row_count %></td>
                  <td><%= number_with_delimiter result.error_count %></td>
                  <td><%= number_to_currency result.total_cost %></td>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p>No active Billing types are enabled.</p>
      <% end %>
    </section>

    <section class="billing-audit-group" aria-labelledby="cost-analysis-title">
      <h2 id="cost-analysis-title">Cost Analysis</h2>
      <div class="billing-type-audit-table-wrapper">
        <% amount_cost_failed = !@cost_analysis.amount_cost_variance.zero? %>
        <table class="billing-type-audit-table billing-summary-audit-table">
          <thead><tr><th scope="col" aria-label="Status"></th><th scope="col">Check</th><th scope="col">Variance</th></tr></thead>
          <tbody><%= tag.tr class: ("clickable-row" if amount_cost_failed), data: (amount_cost_failed ? { controller: "clickable-row", action: "click->clickable-row#click", href: billing_cost_audit_rows_path(:amount_vs_cost) } : {}) do %>
            <td><span class="billing-type-audit-status<%= ' billing-type-audit-status--failure' if amount_cost_failed %>" role="img" aria-label="<%= amount_cost_failed ? 'Errors found' : 'No errors' %>"><%= amount_cost_failed ? '✕' : '✓' %></span></td>
            <th scope="row"><%= link_to_if amount_cost_failed, 'Amount vs Cost', billing_cost_audit_rows_path(:amount_vs_cost) %></th>
            <td><%= number_to_currency @cost_analysis.amount_cost_variance %></td>
          <% end %></tbody>
        </table>
      </div>
    </section>

    <% @audit_groups.each do |group, results| %>
      <section class="billing-audit-group" aria-labelledby="<%= group.key %>-title">
        <h2 id="<%= group.key %>-title"><%= group.label %></h2>
        <div class="billing-type-audit-table-wrapper">
          <table class="billing-type-audit-table billing-summary-audit-table">
            <thead><tr><th scope="col" aria-label="Status"></th><th scope="col">Check</th><th scope="col">Errors</th></tr></thead>
            <tbody>
          <% results.each do |result| %>
            <% failed = result.count.positive? %>
            <%= tag.tr class: ("clickable-row" if failed), data: (failed ? { controller: "clickable-row", action: "click->clickable-row#click", href: billing_audit_detail_path(result.key) } : {}) do %>
              <td><span class="billing-type-audit-status<%= ' billing-type-audit-status--failure' if failed %>" role="img" aria-label="<%= failed ? 'Errors found' : 'No errors' %>"><%= failed ? '✕' : '✓' %></span></td>
              <th scope="row"><%= link_to_if failed, result.label, billing_audit_detail_path(result.key) %></th>
              <td><%= number_with_delimiter result.count %></td>
            <% end %>
          <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
