<div class="form-header billing-form-header">
  <h1>TC60 Billing Type Errors: <%= @billing_type&.code || params[:code] %></h1>
</div>

<div class="form-wrapper billing-form billing-compute">
  <%= render "billing/shared/active_billing_period",
             active_billing_period: @active_billing_period %>
</div>

<div class="form-wrapper billing-form billing-audit billing-audit-rows">
  <% if @audit_error %>
    <div class="dashboard-error" role="alert"><p><%= @audit_error %></p></div>
  <% elsif @active_billing_period.nil? %>
    <div class="dashboard-error" role="status">
      <p>Select an active Billing period before running the audit.</p>
    </div>
  <% else %>
    <section class="billing-audit-group" aria-labelledby="billing-type-rows-title">
      <h2 id="billing-type-rows-title">Rows with Accounting Errors</h2>
      <% if @tc60_rows.any? %>
        <%= render "billing/audits/tc60_rows_table", rows: @tc60_rows %>
      <% else %>
        <p>No TC60 rows with accounting errors were found.</p>
      <% end %>
      <div class="form-actions billing-audit-detail-actions">
        <%= link_to "Back to Billing Audit", billing_audit_path, class: "btn" %>
      </div>
    </section>
  <% end %>
</div>
