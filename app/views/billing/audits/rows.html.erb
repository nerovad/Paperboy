<div class="form-header billing-form-header">
  <h1>TC60 Audit Rows: <%= @audit_check&.label || params[:key].to_s.upcase %></h1>
</div>

<div class="form-wrapper billing-form billing-audit billing-audit-rows">
  <%= render "billing/shared/active_billing_period",
             active_billing_period: @active_billing_period %>

  <% if @audit_error %>
    <div class="dashboard-error" role="alert"><p><%= @audit_error %></p></div>
  <% elsif @active_billing_period.nil? %>
    <div class="dashboard-error" role="status">
      <p>Select an active Billing period before running the audit.</p>
    </div>
  <% else %>
    <section class="billing-audit-group" aria-labelledby="audit-rows-title">
      <h2 id="audit-rows-title">Invalid <%= @audit_check.label %>: <%= @invalid_value %></h2>
      <% if @tc60_rows.any? %>
        <div class="billing-audit-rows-table">
          <table class="submission-table">
            <thead>
              <tr>
                <% @tc60_rows.first.keys.each do |column| %>
                  <th><%= column %></th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% @tc60_rows.each do |row| %>
                <tr>
                  <% row.each_value do |value| %>
                    <td><%= value %></td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p>No matching TC60 rows were found.</p>
      <% end %>
      <div class="form-actions billing-audit-detail-actions">
        <%= link_to "Back to Distinct Values",
                    billing_audit_detail_path(@audit_check.key), class: "btn" %>
      </div>
    </section>
  <% end %>
</div>
