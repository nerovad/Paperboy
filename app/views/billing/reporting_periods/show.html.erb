<div class="form-header billing-form-header">
  <h1>Reporting Period</h1>
</div>

<div class="form-wrapper billing-form billing-compute">
  <%= form_with url: billing_reporting_period_path, method: :patch, data: { turbo: false } do %>
    <div class="form-group">
      <%= label_tag :active_billing_period, "Active Billing Period" %>
      <%= text_area_tag :active_billing_period,
                       @active_billing_period&.display_text || "No active billing period selected.",
                       readonly: true, class: "form-control", rows: 2 %>
    </div>

    <%= render "billing/shared/fiscal_period_grid",
               fiscal_periods: @fiscal_periods, selected_apmon: @selected_apmon %>

    <div class="form-actions">
      <%= submit_tag "Select", class: "button primary" %>
      <%= button_tag "Reset", type: :reset, class: "button reset" %>
      <%= link_to "Cancel", billing_root_path, class: "button cancel" %>
    </div>
  <% end %>
</div>
