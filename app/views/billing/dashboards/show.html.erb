<div class="form-header billing-form-header">
  <h1>View Billing</h1>
</div>

<div class="form-wrapper billing-form dashboards-wrapper" data-controller="dashboards">
  <%= render "billing/shared/active_billing_period",
             active_billing_period: @active_billing_period %>

  <%= form_with url: billing_dashboard_path, method: :get, local: true,
                class: "dashboard-form-selector" do |form| %>
    <div class="form-group">
      <%= form.label :dashboard, "Select Dashboard", class: "form-label" %>
      <%= form.select :dashboard,
                      options_for_select(
                        @dashboards.map { |dashboard| [dashboard.name, dashboard.key] },
                        @selected_dashboard.key
                      ),
                      {},
                      class: "form-control",
                      data: {
                        action: "change->dashboards#loadDashboard",
                        dashboards_target: "formSelect"
                      } %>
    </div>
  <% end %>

  <% if @embed_url %>
    <div class="dashboard-container" data-dashboards-target="container">
      <iframe src="<%= @embed_url %>"
              title="<%= @selected_dashboard.name %>"
              data-dashboards-target="iframe"
              allowfullscreen></iframe>
    </div>
  <% else %>
    <div class="dashboard-error">
      <span class="error-icon" aria-hidden="true">⚙</span>
      <h3><%= @selected_dashboard.name %> is not available</h3>
      <p><%= @configuration_error %></p>
    </div>
  <% end %>
</div>
