<div class="form-header billing-form-header">
  <h1><%= @report.title %></h1>
</div>

<div class="form-wrapper billing-form billing-compute">
  <%= form_with url: billing_process_monthly_report_path(@report.operation),
                method: :post,
                scope: :billing_monthly_report,
                data: { turbo: false } do %>
    <div class="form-group">
      <%= label_tag :active_billing_period, "Active Billing Period" %>
      <%= text_area_tag :active_billing_period, @active_billing_period.display_text,
                       readonly: true, class: "form-control", rows: 2 %>
    </div>

    <div class="form-group">
      <%= label_tag :procedure_names, "Stored Procedure".pluralize(@report.procedure_names.length) %>
      <%= text_area_tag :procedure_names, @report.procedure_text, readonly: true,
                                                               class: "form-control",
                                                               rows: @report.procedure_names.length %>
    </div>

    <div class="form-actions">
      <%= submit_tag @report.button_label, class: "button primary" %>
      <%= link_to "Cancel", billing_root_path, class: "button cancel" %>
    </div>
  <% end %>
</div>
