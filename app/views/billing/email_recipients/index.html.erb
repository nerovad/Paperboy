<div class="form-header billing-form-header">
  <h1>Email Recipient List</h1>
</div>

<div class="form-wrapper billing-form billing-email-recipients">
  <div class="billing-period-grid">
    <table class="submission-table">
      <thead>
        <tr>
          <th>Email Address</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% @recipients.each do |recipient| %>
          <tr>
            <td><%= recipient.email_address %></td>
            <td>
              <%= button_to "Remove", billing_email_recipient_path(recipient), method: :delete,
                            class: "btn deny compact",
                            form: { data: { turbo_confirm: "Remove #{recipient.email_address}?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= form_with model: Billing::EmailRecipient.new,
                url: billing_email_recipients_path,
                class: "billing-inline-form billing-input-card" do |form| %>
    <h2 class="billing-input-card__heading">New Email Address</h2>
    <div class="billing-input-card__body">
      <div class="billing-recipient-entry">
        <%= form.email_field :email_address, required: true, class: "form-control",
                                             aria: { label: "New email address" } %>
        <%= form.submit "Add", class: "btn approve" %>
      </div>
    </div>
  <% end %>

  <%= button_to "Cancel", billing_root_path, method: :get, class: "btn ghost",
                          form: { class: "billing-recipient-cancel-form" } %>
</div>
