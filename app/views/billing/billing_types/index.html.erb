<div class="form-header billing-form-header">
  <h1>Enable Billing</h1>
</div>

<div class="form-wrapper billing-form billing-types">
  <%= render "billing/shared/active_billing_period",
             active_billing_period: @active_billing_period %>

  <%= form_with url: billing_billing_types_path, method: :patch,
                data: { turbo: false, controller: "billing-types" } do %>
    <div class="billing-period-grid">
      <table class="submission-table">
        <thead>
          <tr>
            <th>Type</th>
            <th>Active</th>
            <th>Name</th>
            <th>Funding Type</th>
          </tr>
        </thead>
        <tbody>
          <% @billing_types.each do |billing_type| %>
            <tr>
              <td><%= billing_type.code %></td>
              <td>
                <%= render "billing/shared/boolean_toggle",
                           name: "active[#{billing_type.code}]",
                           id_prefix: "active_#{billing_type.code}",
                           checked: billing_type.active?,
                           aria_label: "Active state for #{billing_type.code}" %>
              </td>
              <td><%= billing_type.name %></td>
              <td><%= billing_type.funding_type %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="form-actions">
      <%= submit_tag "Save", class: "btn approve" %>
      <%= button_tag "Enable All", type: :button, class: "btn approve",
                                   data: { action: "billing-types#enableAll" } %>
      <%= button_tag "Disable All", type: :button, class: "btn deny",
                                    data: { action: "billing-types#disableAll" } %>
      <%= button_tag "Reset", type: :reset, class: "btn warning" %>
      <%= link_to "Cancel", billing_root_path, class: "btn" %>
    </div>
  <% end %>
</div>
