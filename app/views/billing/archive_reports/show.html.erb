<div class="form-header billing-form-header">
  <h1>Archive Billing Reports</h1>
</div>

<div class="form-wrapper billing-form billing-email-reports">
  <%= render "billing/shared/active_billing_period",
             active_billing_period: @active_billing_period %>

  <% if @reports.empty? %>
    <div class="empty-state">
      <p>No Billing reports have been generated on this server.</p>
      <p class="empty-state-hint">
        <%= link_to "Print Billing Reports", billing_monthly_report_path("print") %>
        to generate them. Archive stays disabled until reports exist.
      </p>
    </div>
  <% end %>

  <%= form_with url: billing_archive_reports_path, method: :post,
                id: "billing-archive-report-form", data: { turbo: false } do %>
    <div class="form-group">
      <%= label_tag :archive_location, "Archive Location" %>
      <%= select_tag :archive_location,
                     options_from_collection_for_select(
                       @locations, :relative_path, :label, @selected_location
                     ),
                     class: "form-control", required: true,
                     disabled: @locations.empty? %>
    </div>

    <div class="billing-period-grid">
      <table class="submission-table">
        <thead>
          <tr>
            <th>Billing Report</th>
            <th>Archive</th>
          </tr>
        </thead>
        <tbody>
          <% @reports.each do |report| %>
            <tr>
              <td><%= report.name %></td>
              <td>
                <%= render "billing/shared/boolean_toggle",
                           name: "reports[#{report.name}]",
                           id_prefix: "archive_report_#{report.name.parameterize}",
                           checked: @selected_names.include?(report.name),
                           aria_label: "Archive #{report.name}" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="form-actions">
    <%= button_tag "Select All", type: :submit, name: :selection_action,
                                 value: :select_all, form: "billing-archive-report-form",
                                 class: "btn pdf", disabled: @reports.empty? %>
    <%= button_tag "Reset", type: :submit, name: :selection_action,
                            value: :reset, form: "billing-archive-report-form",
                            class: "btn warning", disabled: @reports.empty? %>
    <%= button_tag "Archive", type: :submit, form: "billing-archive-report-form",
                              class: "btn approve",
                              disabled: @reports.empty? || @locations.empty?,
                              data: { turbo_confirm: "Move the selected Billing reports to the archive?",
                                      confirm_title: "Archive Billing reports",
                                      confirm_label: "Archive" } %>
    <%= link_to "Cancel", billing_root_path, class: "btn ghost" %>
  </div>
</div>
