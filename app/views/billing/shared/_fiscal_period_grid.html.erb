<div class="billing-period-grid">
  <table class="submission-table">
    <thead>
      <tr>
        <th>Fiscal Year</th>
        <th>APMon</th>
        <th>Start Date</th>
        <th>End Date</th>
        <th>Use</th>
      </tr>
    </thead>
    <tbody>
      <% fiscal_periods.each do |period| %>
        <tr>
          <td><%= period.fetch("fyear") %></td>
          <td><%= period.fetch("apmon") %></td>
          <td><%= period.fetch("sdate").to_date.iso8601 %></td>
          <td><%= period.fetch("edate").to_date.iso8601 %></td>
          <td>
            <label class="billing-period-use">
              <%= radio_button_tag :apmon, period.fetch("apmon"),
                                   period.fetch("apmon") == selected_apmon, required: true %>
              <span class="billing-period-no">No</span>
              <span class="billing-period-yes">Yes</span>
            </label>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
