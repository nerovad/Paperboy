<%# app/views/billing/shared/_sidebar.html.erb
    Sidebar for the Billing app. The app switcher header is shared with
    every other app; everything below it is this app's own navigation. %>
<div class="sidebar billing-sidebar">
  <%= render "shared/app_switcher" %>

  <nav class="billing-links">
    <%= link_to "Hello World", billing_root_path,
                class: "nav-link#{' active' if current_page?(billing_root_path)}" %>
  </nav>
</div>
