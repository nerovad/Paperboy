<%# app/views/billing/shared/_sidebar.html.erb
    Sidebar for the Billing app. The app switcher header is shared with
    every other app; everything below it is this app's own navigation.

    Page entries are links. Action entries are POST forms confirmed through
    the shared modal. Billing::BillingHelper supplies the ordered entries and
    limits them to the buttons this user is granted under ACL > Application
    Features. %>
<% items = billing_sidebar_items %>
<div class="sidebar billing-sidebar" data-controller="billing-modal">
  <%= render "shared/app_switcher" %>

  <nav class="billing-links">
    <div class="billing-tool-section">
      <% items.each do |item| %>
        <% if item[:page] %>
          <%= link_to item[:label], item[:path],
                      class: "nav-link#{' active' if current_page?(item[:path])}" %>
        <% else %>
          <%= form_with url: item[:path], method: :post, data: { turbo: false } do %>
            <% if item[:dates] %>
              <%= hidden_field_tag :s_date, nil, id: nil %>
              <%= hidden_field_tag :e_date, nil, id: nil %>
            <% end %>
            <button type="submit" class="nav-link billing-tool-btn"
                    data-action="click->billing-modal#open"
                    data-requires-dates="<%= item[:dates] %>"
                    data-confirm-title="<%= item[:label] %>"
                    data-confirm-message="<%= item[:confirm] %>">
              <%= item[:label] %>
            </button>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </nav>

  <%= render "billing/shared/tools_modal" if items.any? %>
</div>
