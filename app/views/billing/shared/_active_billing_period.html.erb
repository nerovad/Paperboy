<div class="form-group">
  <span class="billing-period-label">Active Billing Period</span>
  <div class="billing-period-grid">
    <table class="submission-table">
      <thead>
        <tr>
          <th>Fiscal Year</th>
          <th>APMon</th>
          <th>Start Date</th>
          <th>End Date</th>
        </tr>
      </thead>
      <tbody>
        <% if active_billing_period %>
          <tr>
            <td><%= active_billing_period.fiscal_year %></td>
            <td><%= active_billing_period.apmon %></td>
            <td><%= active_billing_period.start_date.iso8601 %></td>
            <td><%= active_billing_period.end_date.iso8601 %></td>
          </tr>
        <% else %>
          <tr>
            <td colspan="4">No active billing period selected.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
