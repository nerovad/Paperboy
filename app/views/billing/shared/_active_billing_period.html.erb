<section class="billing-period-card" aria-labelledby="active-billing-period-title">
  <h2 id="active-billing-period-title" class="billing-period-card__heading">Active Billing Period</h2>

  <% if active_billing_period %>
    <dl class="billing-period-card__details">
      <div>
        <dt>Fiscal Year</dt>
        <dd><%= active_billing_period.fiscal_year %></dd>
      </div>
      <div>
        <dt>APMon</dt>
        <dd><%= active_billing_period.apmon %></dd>
      </div>
      <div>
        <dt>Start Date</dt>
        <dd><%= active_billing_period.start_date.iso8601 %></dd>
      </div>
      <div>
        <dt>End Date</dt>
        <dd><%= active_billing_period.end_date.iso8601 %></dd>
      </div>
      <div>
        <dt>Version</dt>
        <dd><%= active_billing_period.version %></dd>
      </div>
    </dl>
  <% else %>
    <p class="billing-period-card__empty">No active billing period selected.</p>
  <% end %>
</section>
