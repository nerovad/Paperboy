<div class="records-screen">
  <%= render "shared/work_tabs", active: :records %>

  <div class="records-head">
    <h1 class="records-title">Records</h1>
    <p class="records-subtitle">Live database tables for bulk viewing/editing</p>
  </div>

  <ul class="records-list">
    <% @tables.each do |table| %>
      <% path = table.route.present? ? public_send(table.route) : records_table_path(table.slug) %>
      <li>
        <%= link_to path, class: "records-list__item" do %>
          <h2 class="records-list__title"><%= table.label %></h2>
          <span class="records-list__count">
            <span class="records-list__count-num"><%= table.count %></span>
            <%= "record".pluralize(table.count) %>
          </span>
          <span class="records-list__open">Open<span class="records-list__arrow" aria-hidden="true">→</span></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
