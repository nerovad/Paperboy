<%# Shared Records grid — Airtable-style table with customizable columns and
    staged inline editing (Edit → change cells → Review & Save → confirm modal →
    batch write). The grid is read-only unless the viewer holds the table's
    record_edit grant; see ApplicationHelper#can_edit_record_table?.
    locals: table, page, columns, rows, edit_path (optional lambda(row) -> path),
            editable (optional, defaults to the viewer's grant),
            title + toolbar (optional; when given, the title, toolbar and Edit
            button share one row above the grid — rendered here so the Edit
            button stays inside the records-edit controller),
            exportable (optional; shows an Export button that opens the
            records-export modal, which the caller renders around the grid),
            emailable (optional; shows editors an Email button that opens the
            records-email dialog, which the caller renders around the grid),
            highlights (optional RecordsHighlights; built from the table when
            not given, so every grid colours its rows),
            highlight_counts + view_params (optional; given, a legend above the
            grid counts each rule's rows and filters to them, and editors get a
            Highlights button for the records-highlights dialog).
            actions (optional; markup for buttons of the table's own, placed
            ahead of the shared ones in the title row).
            Viewers with the edit grant also get the table's change log and a
            History button per row (see RecordsHistoriesController). %>
<% edit_path = local_assigns.fetch(:edit_path, nil) %>
<% editable = local_assigns.fetch(:editable) { can_edit_record_table?(table) } %>
<% title = local_assigns.fetch(:title, nil) %>
<% highlights = local_assigns.fetch(:highlights) { RecordsHighlights.new(table) } %>
<% highlight_counts = local_assigns.fetch(:highlight_counts, nil) %>
<div class="records-page"
     data-controller="column-customizer records-edit history-modal"
     data-column-customizer-page-value="<%= page %>"
     data-column-customizer-save-url-value="<%= settings_table_layout_path %>"
     data-column-customizer-catalog-value="{}"
     data-column-customizer-min-col-px-value="150"
     data-column-customizer-scrollable-value="true"
     data-records-edit-url-value="<%= records_table_path(table.slug) %>">
  <% if title %>
    <div class="records-bar">
      <h1 class="records-title"><%= title %></h1>
      <div class="records-bar__toolbar"><%= local_assigns[:toolbar] %></div>
      <div class="records-bar__actions">
        <%= local_assigns[:actions] %>
        <% if editable %>
          <%= link_to 'Changes', records_table_changes_path(table.slug), class: 'btn status-history' %>
        <% end %>
        <% if editable && highlight_counts %>
          <button type="button" class="btn" data-action="records-highlights#open">Highlights</button>
        <% end %>
        <% if editable && local_assigns[:emailable] %>
          <button type="button" class="btn secondary" data-action="records-email#open">Email</button>
        <% end %>
        <% if local_assigns[:exportable] %>
          <button type="button" class="btn secondary"
                  data-action="records-export#open">Export</button>
        <% end %>
        <% if editable && rows.any? %>
          <button type="button" class="btn"
                  data-records-edit-target="modeButton"
                  data-action="records-edit#toggleMode">Edit</button>
        <% end %>
      </div>
    </div>
  <% elsif editable && rows.any? %>
    <div class="records-editbar">
      <button type="button" class="btn"
              data-records-edit-target="modeButton"
              data-action="records-edit#toggleMode">Edit</button>
    </div>
  <% end %>

  <% if highlight_counts && highlights.any? %>
    <%= render 'records/highlight_legend', table: table, counts: highlight_counts,
               view_params: local_assigns.fetch(:view_params, {}) %>
  <% end %>

  <% if rows.any? %>
    <% row_attributes = ->(row) do
         highlight = highlights.rule_for(row)
         { class: class_names('is-inactive': row.respond_to?(:canceled_date) && row.canceled_date.present?,
                              "is-highlight-#{highlight&.color}": highlight).presence,
           title: highlight&.display_label }
       end %>
    <% cell_markup = ->(column, row) do
         attrs = { class: 'records-cell' }
         if editable && records_cell_editable?(table, column)
           attrs.merge!(class: 'records-cell is-editable',
                        data: { action: 'click->records-edit#start', id: row.id,
                                column: column.id, label: column.label, kind: column.kind,
                                raw: records_edit_raw(column, row) })
         end
         content_tag(:td, table_cell_content(column, row), attrs)
       end %>
    <% action_cell = ->(row) do
         actions = []
         actions << link_to('Edit', edit_path.call(row), class: 'btn edit compact') if edit_path
         if editable
           actions << button_tag('History', type: 'button', class: 'btn status-history compact',
                                 data: { action: 'history-modal#open',
                                         history_url: records_table_row_history_path(table.slug, row.id),
                                         history_label: 'History', record_title: table.row_label(row) })
         end
         safe_join(actions)
       end %>
    <%= render 'pfa/grid/table', columns: columns, rows: rows,
               header: ->(column) { sortable_column_header(column) },
               cell: cell_markup, cell_markup: true, row_attributes: row_attributes,
               action_header: button_tag('+', type: 'button', class: 'cc-trigger',
                                         data: { action: 'column-customizer#open' },
                                         title: 'Customize columns', aria: { label: 'Customize columns' }),
               action_cell: action_cell, table_class: 'records-table',
               wrapper_class: 'records-table-wrapper', wrapper_target: true %>
  <% else %>
    <div class="empty-state">
      <p>No <%= table.label %> records found.</p>
    </div>
  <% end %>

  <%= render "shared/series_pagination", pagy: local_assigns[:pagy] %>

  <%# Unsaved-changes bar — appears only while edits are staged %>
  <div class="records-savebar" data-records-edit-target="savebar" hidden>
    <span class="records-savebar__msg"><strong data-records-edit-target="count">0</strong> unsaved change(s)</span>
    <div class="records-savebar__actions">
      <button type="button" class="btn" data-action="records-edit#discardAll">Discard</button>
      <button type="button" class="btn approve" data-action="records-edit#openModal">Review &amp; Save</button>
    </div>
  </div>

  <%# Review modal — lists staged changes before they are written %>
  <div class="pb-modal-backdrop" data-records-edit-target="modal" hidden data-action="click->records-edit#backdropClick">
    <div class="pb-modal" role="dialog" aria-modal="true" aria-label="Review changes">
      <div class="pb-modal__header">
        <h3>Review changes <span data-records-edit-target="confirmCount"></span></h3>
        <button type="button" class="pb-modal__close" data-action="records-edit#closeModal" aria-label="Close">✕</button>
      </div>
      <ul class="pb-modal__list" data-records-edit-target="modalList"></ul>
      <p class="pb-modal__warning">
        These rows will be changed permanently in the database. The previous
        values are kept in the edit history, but the records themselves are
        overwritten. Are you sure you want to proceed?
      </p>
      <div class="pb-modal__actions">
        <button type="button" class="btn" data-action="records-edit#closeModal">Cancel</button>
        <button type="button" class="btn approve" data-action="records-edit#save">Save changes</button>
      </div>
    </div>
  </div>

  <%= render 'shared/column_customizer', page: page, columns: columns, employee_column: true,
                                          form_fields: false %>
  <%= render 'shared/history_modal' if editable %>
</div>
