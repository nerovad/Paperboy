<%# The Paperboy sidebar while the Form Library is open — Advanced Search mode.

    The list of forms moves to the page, with room for each one's number,
    description and tags, and the sidebar holds what narrows it instead: the
    search box, the org cascade, form type and tags. It is one GET form, sent
    on every change, so the page beside it always shows what is set here and
    its address can be bookmarked.

    Locals:
      library  the FormLibrary the page is showing %>
<%
  collection  = library.collection
  search_path = collection ? form_library_collection_path(collection.key) : form_library_path
%>
<%= form_with url: search_path, method: :get, class: "form-library-filters",
              data: { controller: "auto-submit", action: "change->auto-submit#submit" } do %>
  <%= search_field_tag :q, library.query, class: "sidebar-search-input",
                       placeholder: "Search forms, collections, numbers, tags",
                       aria: { label: "Search forms and collections" } %>

  <%= link_to "Basic Search", root_path,
              class: "btn secondary compact pb-advanced-trigger has-filters" %>

  <% if library.finder.org_tree[:agencies].any? %>
    <fieldset class="pb-filter-set">
      <legend>Issued by</legend>
      <%= render "shared/org_cascade",
                 prefix: "filter",
                 selected: { agency: library.org.agency, division: library.org.division,
                             department: library.org.department, unit: library.org.unit },
                 labels: { agency: "Any Agency", division: "Any", department: "Any", unit: "Any Unit" },
                 options: { agency: library.finder.org_tree[:agencies] } %>
    </fieldset>
  <% end %>

  <% if library.finder.form_types.any? %>
    <fieldset class="pb-filter-set">
      <legend>Form Type</legend>
      <div class="pb-checkbox-row">
        <% library.finder.form_types.each_with_index do |form_type, index| %>
          <label class="pb-checkbox">
            <%= check_box_tag "type[]", form_type, library.form_types.include?(form_type.downcase),
                              id: "form-library-type-#{index}" %>
            <span><%= form_type %></span>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <% if library.tag_options.any? %>
    <fieldset class="pb-filter-set">
      <legend>Tags</legend>
      <div class="pb-checkbox-row pb-checkbox-row--scroll">
        <% library.tag_options.each_with_index do |tag, index| %>
          <label class="pb-checkbox">
            <%= check_box_tag "tag[]", tag, library.tags.include?(tag.downcase),
                              id: "form-library-tag-#{index}" %>
            <span><%= tag %></span>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <% if library.filtered? %>
    <%= link_to "Clear filters", search_path, class: "btn clear-filters compact form-library-filters__clear" %>
  <% end %>
<% end %>
