<%# One bulk-action dialog shell, rendered as a layout around its form:
      render layout: "bulk_modal", locals: { key: "share", title: "Share assets" } do … end
    dam_selection_controller.js finds it by data-modal. %>
<div class="pb-modal-backdrop" hidden data-dam-selection-target="modal" data-modal="<%= key %>"
     data-action="click->dam-selection#backdropClose">
  <div class="pb-modal <%= local_assigns[:size] %>" role="dialog" aria-modal="true"
       aria-labelledby="bulk-<%= key %>-title">
    <div class="pb-modal__header">
      <h3 id="bulk-<%= key %>-title"><%= title %></h3>
      <button type="button" class="pb-modal__close" aria-label="Close"
              data-action="dam-selection#close">✕</button>
    </div>
    <%= yield %>
  </div>
</div>
