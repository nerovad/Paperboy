<%# The search results page. Everything the sidebar box and the Advanced Search
    modal submit lands here; with no params at all it is simply the library. %>
<div class="dam-page">
  <header class="dam-page-header">
    <div>
      <h1><%= @dam_search.any? ? "Search results" : "Library" %></h1>
      <p class="dam-page-subtitle">
        <%= pluralize(@pagy.count, "asset") %>
        <%= "matching your filters" if @dam_search.any? %>
      </p>
    </div>
    <div class="dam-page-actions">
      <%= link_to "Ingest asset", new_digital_asset_management_asset_path, class: "btn approve" %>
    </div>
  </header>

  <% if @dam_search.any? %>
    <div class="dam-chips">
      <% @dam_search.summary.each do |chip| %>
        <span class="dam-chip"><%= chip %></span>
      <% end %>
      <%= link_to "Clear", digital_asset_management_assets_path, class: "btn clear-filters compact" %>
    </div>
  <% end %>

  <% if @assets.any? %>
    <div class="dam-grid">
      <% @assets.each do |asset| %>
        <%= render "digital_asset_management/assets/asset_card",
                   asset: asset, favorited: @favorite_ids.include?(asset.id) %>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="pagination-wrapper">
        <%== @pagy.series_nav %>
        <p class="pagination-info">
          Showing <%= @pagy.from %>–<%= @pagy.to %> of <%= @pagy.count %> assets
        </p>
      </div>
    <% end %>
  <% else %>
    <p class="dam-empty">
      <% if @dam_search.any? %>
        Nothing matched. Try widening the filters in Advanced Search.
      <% else %>
        The library is empty. <%= link_to "Ingest the first asset", new_digital_asset_management_asset_path %>.
      <% end %>
    </p>
  <% end %>
</div>
