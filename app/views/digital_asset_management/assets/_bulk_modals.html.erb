<%# The dialogs behind the bulk action bar. dam_selection_controller.js opens
    them, writes "12 assets" into every summary target, and stamps the
    selection into each form as hidden fields as the dialog opens — the
    selection cannot change while one is open, since it covers the grid.

    Field ids carry a bulk_ prefix because the Advanced Search modal is on
    this page too. %>
<% if @bulk_publish_targets %>
  <%= render layout: "bulk_modal", locals: { key: "publish", title: "Publish assets" } do %>
    <% if @bulk_publish_targets.any? %>
      <% privacies = @bulk_publish_targets.index_by(&:id).transform_values(&:privacy_options) %>
      <%= form_with url: publish_digital_asset_management_bulk_assets_path, method: :post,
                    data: { dam_selection_target: "form", controller: "publish-form",
                            publish_form_privacies_value: privacies.to_json } do %>
        <div class="pb-modal__body">
          <p class="pb-modal__message">
            Sends <strong data-dam-selection-target="summary"></strong> out, each under its own title and
            description, through the account the target is connected to. An asset the target does not take is
            skipped. At most <%= DigitalAssetManagement::BulkAssetsController::MAX_PUBLISH %> at once.
          </p>
          <div class="form-group">
            <%= label_tag :bulk_publish_target_id, "Send to" %>
            <%= select_tag :publish_target_id,
                           options_for_select(@bulk_publish_targets.map { |target| ["#{target.label} (#{target.provider_label})", target.id] }),
                           id: "bulk_publish_target_id", class: "form-control",
                           data: { publish_form_target: "target", action: "change->publish-form#refresh" } %>
          </div>
          <div class="form-group">
            <%= label_tag :bulk_tags, "Tags" %>
            <%= text_field_tag :tags, nil, id: "bulk_tags", class: "form-control", placeholder: "comma, separated" %>
          </div>
          <div class="form-group" data-publish-form-target="privacyGroup">
            <%= label_tag :bulk_privacy, "Visibility" %>
            <%= select_tag :privacy, nil, id: "bulk_privacy", class: "form-control",
                           data: { publish_form_target: "privacy" } %>
          </div>
          <div class="pb-modal__actions">
            <button type="button" class="btn" data-action="dam-selection#close">Cancel</button>
            <%= submit_tag "Publish", class: "btn approve" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="pb-modal__body">
        <p class="pb-modal__message">
          No publish target is connected and enabled.
          <% if can_use_app_feature?("digital_asset_management", "publish_targets") %>
            <%= link_to "Set one up", digital_asset_management_publish_targets_path %>.
          <% end %>
        </p>
        <div class="pb-modal__actions">
          <button type="button" class="btn" data-action="dam-selection#close">Cancel</button>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render layout: "bulk_modal", locals: { key: "share", title: "Share assets" } do %>
  <%= form_with url: share_digital_asset_management_bulk_assets_path, method: :post,
                data: { dam_selection_target: "form" } do %>
    <div class="pb-modal__body">
      <p class="pb-modal__message">Shares <strong data-dam-selection-target="summary"></strong>, one share each.</p>
      <div class="form-group">
        <%= label_tag :bulk_recipients, "Recipients" %>
        <%= text_area_tag :recipients, nil, id: "bulk_recipients", class: "form-control", rows: 2,
                          required: true, placeholder: "one email per line" %>
      </div>
      <div class="form-group">
        <%= label_tag :bulk_permission, "Permission" %>
        <%= select_tag :permission, options_for_select(Dam::Share::PERMISSIONS.map { |key, label| [label, key] }),
                       id: "bulk_permission", class: "form-control" %>
      </div>
      <div class="form-group">
        <%= label_tag :bulk_expires_at, "Expires" %>
        <%= date_field_tag :expires_at, nil, id: "bulk_expires_at", class: "form-control" %>
      </div>
      <div class="form-group">
        <%= label_tag :bulk_message, "Message" %>
        <%= text_area_tag :message, nil, id: "bulk_message", class: "form-control", rows: 2 %>
      </div>
      <div class="pb-modal__actions">
        <button type="button" class="btn" data-action="dam-selection#close">Cancel</button>
        <%= submit_tag "Create shares", class: "btn approve" %>
      </div>
    </div>
  <% end %>
<% end %>

<% if @dam_metadata_fields.any? %>
  <%= render layout: "bulk_modal", locals: { key: "metadata", title: "Edit metadata", size: "pb-modal--lg" } do %>
    <%= form_with url: metadata_digital_asset_management_bulk_assets_path, method: :post,
                  data: { dam_selection_target: "form" } do %>
      <div class="pb-modal__body">
        <p class="pb-modal__message">
          Sets these fields on <strong data-dam-selection-target="summary"></strong>. A field left empty is left
          as it is on each asset; tick Clear to remove it.
        </p>
        <div class="dam-bulk-fields">
          <% @dam_metadata_fields.each do |field| %>
            <% input_id = "bulk_metadata_#{field.key}" %>
            <div class="dam-bulk-field">
              <%= label_tag input_id, field.label %>
              <% if field.field_type == "select" && field.choices.any? %>
                <%= select_tag "metadata[#{field.key}]", options_for_select(field.choices),
                               id: input_id, include_blank: "Leave as is", class: "form-control" %>
              <% else %>
                <%= text_field_tag "metadata[#{field.key}]", nil, id: input_id,
                                   type: { "number" => "number", "date" => "date" }.fetch(field.field_type, "text"),
                                   class: "form-control", placeholder: "Leave as is" %>
              <% end %>
              <label class="dam-bulk-clear">
                <%= check_box_tag "clear_metadata[]", field.key, false, id: nil %>
                Clear
              </label>
            </div>
          <% end %>
        </div>
        <div class="pb-modal__actions">
          <button type="button" class="btn" data-action="dam-selection#close">Cancel</button>
          <%= submit_tag "Update metadata", class: "btn approve" %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if can_use_app_feature?("digital_asset_management", "collections") && @collections.any? %>
  <%= render layout: "bulk_modal", locals: { key: "collection", title: "Add to collection" } do %>
    <%= form_with url: add_to_collection_digital_asset_management_bulk_assets_path, method: :post,
                  data: { dam_selection_target: "form" } do %>
      <div class="pb-modal__body">
        <p class="pb-modal__message">
          Adds <strong data-dam-selection-target="summary"></strong> to a collection. Assets already in it stay
          where they are.
        </p>
        <div class="form-group">
          <%= label_tag :bulk_collection_id, "Collection" %>
          <%= select_tag :collection_id, options_for_select(@collections.map { |collection| [collection.name, collection.id] }),
                         id: "bulk_collection_id", class: "form-control" %>
        </div>
        <div class="pb-modal__actions">
          <button type="button" class="btn" data-action="dam-selection#close">Cancel</button>
          <%= submit_tag "Add", class: "btn approve" %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render layout: "bulk_modal", locals: { key: "archive", title: "Archive assets" } do %>
  <%= form_with url: archive_digital_asset_management_bulk_assets_path, method: :post,
                data: { dam_selection_target: "form" } do %>
    <div class="pb-modal__body">
      <p class="pb-modal__message">
        Archives <strong data-dam-selection-target="summary"></strong>. Archived assets leave the library and
        its searches; nothing is deleted, and their collections, shares and jobs keep pointing at them.
      </p>
      <div class="pb-modal__actions">
        <button type="button" class="btn" data-action="dam-selection#close">Cancel</button>
        <%= submit_tag "Archive", class: "btn deny" %>
      </div>
    </div>
  <% end %>
<% end %>
