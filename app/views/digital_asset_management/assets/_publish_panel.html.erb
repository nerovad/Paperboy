<%# Publish — sending this asset out to a channel, a page or an address of
    our own. Queued, never done in the request: an upload takes as long as
    the file takes. Progress is on the publication's own page. %>
<section class="dam-panel">
  <h2>Publish</h2>

  <% if @publish_targets.any? %>
    <% privacies = @publish_targets.index_by(&:id).transform_values(&:privacy_options) %>
    <%= form_with url: digital_asset_management_publications_path, method: :post,
                  class: "dam-publish-form",
                  data: { controller: "publish-form", publish_form_privacies_value: privacies.to_json } do %>
      <%= hidden_field_tag :asset_id, asset.id %>

      <div class="form-group">
        <%= label_tag :publish_target_id, "Send to" %>
        <%= select_tag :publish_target_id,
                       options_for_select(@publish_targets.map { |target| ["#{target.label} (#{target.provider_label})", target.id] }),
                       class: "form-control",
                       data: { publish_form_target: "target", action: "change->publish-form#refresh" } %>
      </div>

      <div class="form-group">
        <%= label_tag :title %>
        <%= text_field_tag :title, asset.title, class: "form-control", required: true %>
      </div>

      <div class="form-group">
        <%= label_tag :description %>
        <%= text_area_tag :description, asset.description, class: "form-control", rows: 3 %>
      </div>

      <div class="form-group">
        <%= label_tag :tags %>
        <%= text_field_tag :tags, nil, class: "form-control", placeholder: "comma, separated" %>
      </div>

      <div class="form-group" data-publish-form-target="privacyGroup">
        <%= label_tag :privacy, "Visibility" %>
        <%= select_tag :privacy, nil, class: "form-control", data: { publish_form_target: "privacy" } %>
      </div>

      <%= submit_tag "Publish", class: "btn approve",
                     data: { turbo_confirm: "Publish #{asset.title}? It goes out under the account the target is connected to.",
                             confirm_title: "Publish asset", confirm_label: "Publish" } %>
    <% end %>
  <% elsif @publish_targets_closed.blank? %>
    <p class="dam-muted">
      No publish targets have been set up yet.
      <% if can_use_app_feature?("digital_asset_management", "publish_targets") %>
        <%= link_to "Add one", new_digital_asset_management_publish_target_path %>.
      <% end %>
    </p>
  <% end %>

  <% if @publish_targets_closed.present? %>
    <p class="dam-muted">
      Not available for this asset:
      <%= safe_join(@publish_targets_closed.map { |target| "#{target.label} (#{target.refusal_reason(asset)})" }, ", ") %>
    </p>
  <% end %>

  <% if @publications.present? %>
    <h3>Already published</h3>
    <ul class="dam-list">
      <% @publications.each do |publication| %>
        <li>
          <%= link_to publication.target_label, digital_asset_management_publication_path(publication) %>
          <%= dam_pill(publication.status) %>
          <% if (published = dam_published_url(publication.external_url)) %>
            <%= link_to "Open", published, target: "_blank", rel: "noopener", class: "btn compact pdf" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
