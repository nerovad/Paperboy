<%= form_with model: @collection, scope: :collection,
              url: @collection.persisted? ? digital_asset_management_collection_path(@collection)
                                          : digital_asset_management_collections_path,
              class: "dam-form" do |f| %>
  <% if @collection.errors.any? %>
    <div class="dam-errors">
      <ul>
        <% @collection.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :description %>
    <%= f.text_area :description, class: "form-control", rows: 3 %>
  </div>

  <div class="form-group">
    <%= f.label :parent_id, "Inside collection" %>
    <%= f.collection_select :parent_id, @parents, :id, :name,
                            { include_blank: "Top level" }, class: "form-control" %>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel", digital_asset_management_collections_path, class: "btn" %>
    <%= f.submit @collection.persisted? ? "Save collection" : "Create collection", class: "btn approve" %>
  </div>
<% end %>
