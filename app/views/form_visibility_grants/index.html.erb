<!-- app/views/form_visibility_grants/index.html.erb -->
<div class="form-header">
  <h1>Inbox and Submissions Visibility</h1>
</div>

<div class="form-wrapper visibility-grants">
  <div class="department-header">
    <h2>Submission Visibility Grants</h2>
    <%= link_to "← Back to Form Templates", form_templates_path, class: "btn secondary" %>
  </div>

  <p class="form-help">
    A grant lets every member of a group see submissions that aren't their own
    — including forms from people outside their reporting chain — for one form
    or for every form at once. Choose whether it widens their
    <strong>Inbox</strong>, the
    <strong>Submissions</strong> page or both, and narrow it to part of the
    organization when a group should only see one agency, division, department
    or unit. On the Submissions page granted forms appear automatically; in the
    Inbox they appear once the user filters to that form type. Manage who is in
    a group from the <%= link_to "ACL screen", acl_index_path %>.
  </p>

  <div class="approver-card visibility-grant-form">
    <h3>Add a grant</h3>

    <%= form_with url: form_visibility_grants_path, method: :post, data: { turbo: false } do %>
      <div class="pb-filter-grid">
        <div class="pb-filter">
          <%= label_tag :form_type, "Form" %>
          <%# "All forms" covers every form at once — the right answer when a
              group is being given a whole department's paperwork rather than
              one workflow. %>
          <%= select_tag :form_type,
                options_for_select([[Forms::VisibilityGrant::ALL_FORMS_LABEL, Forms::VisibilityGrant::ALL_FORMS]] +
                                   @form_types.map { |ft| [ft[:label], ft[:class_name]] }),
                include_blank: "Select a form…", class: "form-control" %>
        </div>

        <div class="pb-filter">
          <%= label_tag :group_id, "Group" %>
          <%= select_tag :group_id,
                options_for_select(@groups.map { |g| [g.group_name, g.GroupID] }),
                include_blank: "Select a group…", class: "form-control" %>
        </div>

        <div class="pb-filter">
          <%= label_tag :applies_to, "Applies to" %>
          <%= select_tag :applies_to,
                options_for_select(Forms::VisibilityGrant::APPLIES_TO_LABELS.map { |value, label| [label, value] }, "both"),
                class: "form-control" %>
        </div>
      </div>

      <fieldset class="pb-filter-set visibility-grant-org">
        <legend>Limit to part of the organization</legend>
        <p class="form-help">
          Leave a level blank for "all". A grant narrowed here only covers
          submissions filed inside that part of the county — a group asked to
          review General Services Agency → Maintenance sees those and nothing
          else.
        </p>
        <%= render "shared/org_cascade", labels: { agency: "All Agencies" } %>
      </fieldset>

      <div class="form-actions">
        <%= submit_tag "Add Grant", class: "btn approve" %>
      </div>
    <% end %>
  </div>

  <h3 class="visibility-grants-heading">Current grants</h3>

  <% if @grants.any? %>
    <table class="visibility-grants-table">
      <thead>
        <tr>
          <th>Form</th>
          <th>Group</th>
          <th>Applies to</th>
          <th>Organization</th>
          <th class="actions-column" scope="col">Remove</th>
        </tr>
      </thead>
      <tbody>
        <% @grants.each do |grant| %>
          <tr>
            <td>
              <strong><%= grant.form_label(@form_labels) %></strong>
              <% unless grant.all_forms? %>
                <span class="grant-class-name"><%= grant.form_type %></span>
              <% end %>
            </td>
            <td><%= grant.group&.group_name || "Group ##{grant.group_id}" %></td>
            <td><span class="grant-badge"><%= grant.applies_to_label %></span></td>
            <td>
              <% if grant.org_scoped? %>
                <% grant.org_summary.each do |chip| %>
                  <span class="pb-search-chip"><%= chip %></span>
                <% end %>
              <% else %>
                <span class="grant-muted">Entire organization</span>
              <% end %>
            </td>
            <td class="actions-column">
              <%= button_to "Remove", form_visibility_grant_path(grant), method: :delete,
                    class: "btn deny compact",
                    form: { data: { turbo_confirm: "Remove this visibility grant? The group goes back to seeing only their own submissions of this form.",
                                    confirm_title: "Remove grant", confirm_label: "Remove" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="form-help">No visibility grants yet. Everyone sees only their own submissions.</p>
  <% end %>
</div>
