<div class="form-header">
  <h1><%= @rule.name_was.presence || @rule.name %></h1>
</div>

<div class="form-wrapper acl-management dam-access-rules">
  <div class="acl-header">
    <%= button_to "Delete rule", dam_access_rule_path(@rule), method: :delete, class: "btn deny",
                  form: { data: { turbo_confirm: "Delete #{@rule.name}? Its assets become visible to everyone unless another rule covers them.",
                                  confirm_title: "Delete rule", confirm_label: "Delete" } } %>
  </div>

  <%= render "grantees", rule: @rule %>
  <%= render "form", rule: @rule %>
</div>
