<!-- app/views/acl/org_permissions.html.erb -->
<div class="form-header">
  <h1><%= [@agency_id, @division_id, @department_id, @unit_id].any?(&:present?) ? 'Organizational Permissions' : 'Global Permissions' %></h1>
</div>

<div class="form-wrapper acl-management">
  <div class="acl-header">
    <div>
      <p class="acl-subtitle">Configure permissions for:</p>
      <p class="acl-org-label"><%= @org_label %></p>
    </div>
  </div>

  <%= form_tag update_org_permissions_acl_index_path, method: :patch, data: { turbo: false } do %>
    <%= hidden_field_tag :agency_id, @agency_id %>
    <%= hidden_field_tag :division_id, @division_id %>
    <%= hidden_field_tag :department_id, @department_id %>
    <%= hidden_field_tag :unit_id, @unit_id %>

    <details id="application-access" class="acl-permission-group" open>
      <summary>Application access</summary>
      <p class="acl-permission-group__intro">Choose the applications, navigation items, and administrative consoles available at this scope.</p>

      <div id="applications" class="acl-permissions-section" data-controller="select-all">
        <h3>Applications</h3>
        <p class="acl-subtitle">Select which applications are accessible from the sidebar app switcher at this organization level. Paperboy is always available.</p>
        <div class="permissions-grid">
          <label class="permission-checkbox select-all-checkbox">
            <%= check_box_tag "select_all_applications", "1",
                @application_items.all? { |item| @org_application_keys.include?(item[:key]) },
                data: { select_all_target: "selectAll", action: "change->select-all#toggle" } %>
            <span><strong>Select All</strong></span>
          </label>
          <% @application_items.each do |item| %>
            <label class="permission-checkbox">
              <%= check_box_tag "application_permissions[]", item[:key], @org_application_keys.include?(item[:key]),
                  data: { select_all_target: "checkbox", action: "change->select-all#update" } %>
              <span><%= item[:label] %></span>
            </label>
          <% end %>
        </div>
      </div>

      <%= render "acl/feature_permissions", apps: @feature_apps, selected_keys: @org_feature_keys %>

      <%= render "acl/authorization_console_permissions",
            consoles: @authorization_consoles, selected_keys: @org_authorization_console_keys %>

      <details id="profile-dropdown-items" class="acl-permission-subgroup">
        <summary>Profile Dropdown Items</summary>
        <div class="acl-permissions-section" data-controller="select-all">
          <p class="acl-subtitle">Select which profile dropdown items are accessible at this organization level.</p>
          <div class="permissions-grid">
          <label class="permission-checkbox select-all-checkbox">
            <%= check_box_tag "select_all_dropdown", "1",
                @dropdown_items.all? { |item| @org_dropdown_keys.include?(item[:key]) },
                data: { select_all_target: "selectAll", action: "change->select-all#toggle" } %>
            <span><strong>Select All</strong></span>
          </label>
          <% @dropdown_items.each do |item| %>
            <label class="permission-checkbox">
              <%= check_box_tag "dropdown_permissions[]", item[:key], @org_dropdown_keys.include?(item[:key]),
                  data: { select_all_target: "checkbox", action: "change->select-all#update" } %>
              <span><%= item[:label] %></span>
            </label>
          <% end %>
          </div>
        </div>
      </details>
    </details>

    <details id="form-workflow" class="acl-permission-group">
      <summary>Form and submission workflow</summary>
      <p class="acl-permission-group__intro">Control which forms appear and which actions users at this organization level may take on submissions.</p>

      <details id="forms" class="acl-permission-subgroup">
        <summary>Forms</summary>
        <div class="acl-permissions-section" data-controller="select-all">
          <p class="acl-subtitle">Select which forms are accessible at this organization level. When any forms are selected, only those forms will appear in the sidebar.</p>
          <div class="permissions-grid">
          <label class="permission-checkbox select-all-checkbox">
            <%= check_box_tag "select_all_forms", "1",
                @all_forms.all? { |form| @org_form_keys.include?(form[:key]) },
                data: { select_all_target: "selectAll", action: "change->select-all#toggle" } %>
            <span><strong>Select All</strong></span>
          </label>
          <% @all_forms.each do |form| %>
            <label class="permission-checkbox">
              <%= check_box_tag "form_permissions[]", form[:key], @org_form_keys.include?(form[:key]),
                  data: { select_all_target: "checkbox", action: "change->select-all#update" } %>
              <span><%= form[:label] %></span>
            </label>
          <% end %>
          </div>
        </div>
      </details>

      <%= render "acl/submission_action_permissions",
                 forms: @submission_forms,
                 selected_keys: @org_submission_action_keys,
                 scope_label: "users at this organization level" %>
    </details>

    <div class="form-actions">
      <%= submit_tag "Save Permissions", class: "btn approve" %>
    </div>
  <% end %>
</div>
