<%# Form Activity Notifications: what a group is emailed about.

    A sibling of the visibility section above, and deliberately separate from
    it: seeing a form and being told about it are different decisions. Like a
    grant, a subscription is a row rather than a tick-box, so this section
    posts on its own and must be rendered outside the permissions form.

    Locals:
      group          the Group whose ACL page this is, preselected in the picker
      groups         every group, for the picker
      subscriptions  all group-held Forms::Subscription rows
      form_types     [{ class_name:, label: }] catalog
      form_labels    class_name => label
-%>
<div class="acl-permissions-section visibility-grants">
  <h3>Form Activity Notifications</h3>
  <p class="acl-subtitle">
    A subscription emails every member of a group when something happens to a
    form — a new submission, an edit to any field, or a status change — for one
    form or for every form at once. Choose <strong>each change</strong> to be
    mailed as things happen, or <strong>one daily digest</strong> to get a
    single summary the next morning. Edit notifications list exactly which
    fields changed and what they changed from. This is separate from
    visibility above: subscribing does not grant anyone sight of a form they
    could not already open.
  </p>

  <%= form_with url: form_subscriptions_path, method: :post, data: { turbo: false } do %>
    <div class="pb-filter-grid">
      <div class="pb-filter">
        <%= label_tag :form_type, "Form" %>
        <%= select_tag :form_type,
              options_for_select([[Forms::Subscription::ALL_FORMS_LABEL, Forms::Subscription::ALL_FORMS]] +
                                 form_types.map { |ft| [ft[:label], ft[:class_name]] }),
              include_blank: "Select a form…", class: "form-control" %>
      </div>

      <div class="pb-filter">
        <%= label_tag :group_id, "Group" %>
        <%= select_tag :group_id,
              options_for_select(groups.map { |g| [g.group_name, g.GroupID] }, group.GroupID),
              include_blank: "Select a group…", class: "form-control" %>
      </div>

      <div class="pb-filter">
        <%= label_tag :delivery_mode, "Delivery" %>
        <%= select_tag :delivery_mode,
              options_for_select(Forms::Subscription::DELIVERY_MODE_LABELS.map { |value, label| [label, value] },
                                 Forms::Subscription::IMMEDIATE),
              class: "form-control" %>
      </div>
    </div>

    <fieldset class="pb-filter-set visibility-grant-org">
      <legend>Notify about</legend>
      <p class="acl-subtitle">
        Pick at least one. A new submission also reaches whoever it is routed
        to for approval — that is the inbox notification in each person's own
        Settings, and is unaffected by anything here.
      </p>
      <% Forms::Subscription::EVENT_LABELS.each do |event, label| %>
        <label class="settings-toggle">
          <%= check_box_tag "events[]", event, false, id: "acl_event_#{event}" %>
          <span class="settings-label"><strong><%= label %></strong></span>
        </label>
      <% end %>
    </fieldset>

    <div class="form-actions">
      <%= submit_tag "Add Subscription", class: "btn approve" %>
    </div>
  <% end %>

  <h4 class="visibility-grants-heading">Current subscriptions</h4>

  <% if subscriptions.any? %>
    <table class="visibility-grants-table">
      <thead>
        <tr>
          <th scope="col">Form</th>
          <th scope="col">Group</th>
          <th scope="col">Notify about</th>
          <th scope="col">Delivery</th>
          <th scope="col" class="actions-column">Remove</th>
        </tr>
      </thead>
      <tbody>
        <% subscriptions.each do |subscription| %>
          <tr>
            <td>
              <strong><%= subscription.form_label(form_labels) %></strong>
              <% unless subscription.all_forms? %>
                <span class="grant-class-name"><%= subscription.form_type %></span>
              <% end %>
            </td>
            <td><%= subscription.group&.group_name || "Group ##{subscription.group_id}" %></td>
            <td>
              <% subscription.event_labels.each do |label| %>
                <span class="pb-search-chip"><%= label %></span>
              <% end %>
            </td>
            <td><span class="grant-badge"><%= subscription.delivery_mode_label %></span></td>
            <td class="actions-column">
              <%= button_to "Remove", form_subscription_path(subscription), method: :delete,
                    class: "btn deny compact",
                    params: { group_id: subscription.group_id },
                    form: { data: { turbo_confirm: "Remove this subscription? The group stops being emailed about this form.",
                                    confirm_title: "Remove subscription", confirm_label: "Remove" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="acl-subtitle">No subscriptions yet. Nobody in this group is emailed about form activity.</p>
  <% end %>
</div>
