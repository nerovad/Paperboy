<!-- app/views/acl/permissions.html.erb -->
<div class="form-header">
  <h1>Permissions - <%= @group.group_name %></h1>
</div>

<div class="form-wrapper acl-management">
  <div class="acl-header">
    <p class="acl-subtitle">Configure what this group grants access to.</p>
  </div>

  <%= form_tag update_permissions_acl_path(@group), method: :patch, id: "acl-permissions-form", data: { turbo: false } do %>

    <details id="application-access" class="acl-permission-group" open>
      <summary>Application access</summary>
      <p class="acl-permission-group__intro">Choose the applications, navigation items, and administrative consoles available to this group.</p>

      <div id="applications" class="acl-permissions-section" data-controller="select-all">
        <h3>Applications</h3>
        <p class="acl-subtitle">Select which applications members of this group can open from the sidebar app switcher. Paperboy is always available.</p>
        <div class="permissions-grid">
          <label class="permission-checkbox select-all-checkbox">
            <%= check_box_tag "select_all_applications", "1",
                @application_items.all? { |item| @application_keys.include?(item[:key]) },
                data: { select_all_target: "selectAll", action: "change->select-all#toggle" } %>
            <span><strong>Select All</strong></span>
          </label>
          <% @application_items.each do |item| %>
            <label class="permission-checkbox">
              <%= check_box_tag "application_permissions[]", item[:key], @application_keys.include?(item[:key]),
                  data: { select_all_target: "checkbox", action: "change->select-all#update" } %>
              <span><%= item[:label] %></span>
            </label>
          <% end %>
        </div>
      </div>

      <%= render "acl/feature_permissions", apps: @feature_apps, selected_keys: @feature_keys %>

      <%= render "acl/authorization_console_permissions",
            consoles: @authorization_consoles, selected_keys: @authorization_console_keys %>

      <details id="profile-dropdown-items" class="acl-permission-subgroup">
        <summary>Profile Dropdown Items</summary>
        <div class="acl-permissions-section" data-controller="select-all">
          <p class="acl-subtitle">Select which profile dropdown items members of this group can access.</p>
          <div class="permissions-grid">
          <label class="permission-checkbox select-all-checkbox">
            <%= check_box_tag "select_all_dropdown", "1",
                @dropdown_items.all? { |item| @dropdown_keys.include?(item[:key]) },
                data: { select_all_target: "selectAll", action: "change->select-all#toggle" } %>
            <span><strong>Select All</strong></span>
          </label>
          <% @dropdown_items.each do |item| %>
            <label class="permission-checkbox">
              <%= check_box_tag "dropdown_permissions[]", item[:key], @dropdown_keys.include?(item[:key]),
                  data: { select_all_target: "checkbox", action: "change->select-all#update" } %>
              <span><%= item[:label] %></span>
            </label>
          <% end %>
          </div>
        </div>
      </details>
    </details>

    <details id="records-access" class="acl-permission-group">
      <summary>Records access</summary>
      <p class="acl-permission-group__intro">Control which Records tables members of this group can open and edit inline.</p>

      <details id="record-view" class="acl-permission-subgroup">
        <summary>Records Access</summary>
        <div class="acl-permissions-section" data-controller="select-all">
          <p class="acl-subtitle">Select which Records tables members of this group can open. Some tables are also reachable through a profile dropdown item below; a tick here grants the table on its own.</p>
          <div class="permissions-grid">
          <label class="permission-checkbox select-all-checkbox">
            <%= check_box_tag "select_all_record_view", "1",
                @record_table_items.any? && @record_table_items.all? { |item| @record_view_keys.include?(item[:key]) },
                data: { select_all_target: "selectAll", action: "change->select-all#toggle" } %>
            <span><strong>Select All</strong></span>
          </label>
          <% @record_table_items.each do |item| %>
            <label class="permission-checkbox">
              <%= check_box_tag "record_view_permissions[]", item[:key], @record_view_keys.include?(item[:key]),
                  data: { select_all_target: "checkbox", action: "change->select-all#update" } %>
              <span><%= item[:label] %></span>
            </label>
          <% end %>
          </div>
        </div>
      </details>

      <details id="record-edit" class="acl-permission-subgroup">
        <summary>Records Editing</summary>
        <div class="acl-permissions-section" data-controller="select-all">
          <p class="acl-subtitle">Select which Records tables members of this group can edit inline. Being able to open a table does not grant editing. Without a tick here the grid stays read-only.</p>
          <div class="permissions-grid">
          <label class="permission-checkbox select-all-checkbox">
            <%= check_box_tag "select_all_record_edit", "1",
                @record_table_items.any? && @record_table_items.all? { |item| @record_edit_keys.include?(item[:key]) },
                data: { select_all_target: "selectAll", action: "change->select-all#toggle" } %>
            <span><strong>Select All</strong></span>
          </label>
          <% @record_table_items.each do |item| %>
            <label class="permission-checkbox">
              <%= check_box_tag "record_edit_permissions[]", item[:key], @record_edit_keys.include?(item[:key]),
                  data: { select_all_target: "checkbox", action: "change->select-all#update" } %>
              <span><%= item[:label] %></span>
            </label>
          <% end %>
          </div>
        </div>
      </details>
    </details>

    <details id="form-workflow" class="acl-permission-group">
      <summary>Form and submission workflow</summary>
      <p class="acl-permission-group__intro">Control which forms members of this group can use and what they may do with submissions.</p>

      <details id="forms" class="acl-permission-subgroup">
        <summary>Forms</summary>
        <div class="acl-permissions-section" data-controller="select-all">
          <p class="acl-subtitle">Select which forms members of this group can access. When any forms are selected, only those forms will appear in the sidebar.</p>
          <div class="permissions-grid">
          <label class="permission-checkbox select-all-checkbox">
            <%= check_box_tag "select_all_forms", "1",
                @all_forms.all? { |form| @form_keys.include?(form[:key]) },
                data: { select_all_target: "selectAll", action: "change->select-all#toggle" } %>
            <span><strong>Select All</strong></span>
          </label>
          <% @all_forms.each do |form| %>
            <label class="permission-checkbox">
              <%= check_box_tag "form_permissions[]", form[:key], @form_keys.include?(form[:key]),
                  data: { select_all_target: "checkbox", action: "change->select-all#update" } %>
              <span><%= form[:label] %></span>
            </label>
          <% end %>
          </div>
        </div>
      </details>

      <%= render "acl/submission_action_permissions",
                 forms: @submission_forms,
                 selected_keys: @submission_action_keys,
                 scope_label: "members of this group" %>
    </details>

  <% end %>

  <details id="submission-sharing" class="acl-permission-group">
    <summary>Submission visibility and notifications</summary>
    <p class="acl-permission-group__intro">Control which other submissions this group can see and which form activity notifications it receives.</p>

    <%# These editors use their own forms, so they stay outside the permissions
        form above to keep the HTML valid. %>
    <%= render "acl/submission_visibility",
               group: @group,
               groups: @groups,
               grants: @visibility_grants,
               form_types: @submission_forms,
               form_labels: @submission_form_labels %>

    <%= render "acl/form_subscriptions",
               group: @group,
               groups: @groups,
               subscriptions: @form_subscriptions,
               opt_out_names: @opt_out_names,
               form_types: @submission_forms,
               form_labels: @submission_form_labels %>
  </details>

  <%# Last thing on the page, so nothing sits below Save. The form attribute
      ties it back to the permissions form it submits. %>
  <div class="form-actions acl-save-row">
    <%= submit_tag "Save Permissions", class: "btn approve", form: "acl-permissions-form" %>
  </div>
</div>
