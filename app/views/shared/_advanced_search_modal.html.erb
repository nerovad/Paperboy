<%# Advanced Search — the panel behind the sidebar button.

    It narrows the list of forms you can *fill out*, on the official metadata
    an admin set on each form in the form builder: which part of the county
    issues it, what kind of form it is, and its free-text tags. It does not
    search submitted forms — that is the Submissions list's own filter bar.

    Everything here is applied in the browser. The sidebar has already rendered
    every form the viewer is allowed to use, each carrying its metadata, so
    narrowing is instant and needs no round trip. FormFinder built the option
    lists from those same forms, so no choice here can come back empty.

    Locals:
      form_finder  FormFinder over the forms this sidebar is showing %>
<div class="pb-modal-backdrop" hidden
     data-advanced-search-target="modal"
     data-action="click->advanced-search#backdropClose">
  <div class="pb-modal pb-modal--lg" role="dialog" aria-modal="true"
       aria-labelledby="pb-advanced-search-title">
    <div class="pb-modal__header">
      <h3 id="pb-advanced-search-title">Advanced Search</h3>
      <button type="button" class="pb-modal__close" aria-label="Close"
              data-action="advanced-search#close">✕</button>
    </div>

    <div class="pb-modal__body">
      <% if form_finder.any_facets? %>
        <p class="pb-modal__message">
          Narrow the forms in the sidebar. Leave a filter unset to include everything.
        </p>

        <% if form_finder.org_tree[:agencies].any? %>
          <fieldset class="pb-filter-set">
            <legend>Organization</legend>
            <%# Only the agencies are rendered; the deeper levels are filled
                from the org tree as the user narrows, by the same controller
                that would otherwise fetch them from /lookups. %>
            <%= render "shared/org_cascade",
                       scope: "advanced-search", standalone: false, prefix: "form_filter",
                       labels: { agency: "Any Agency", division: "Any",
                                 department: "Any", unit: "Any Unit" },
                       options: { agency: form_finder.org_tree[:agencies],
                                  division: [], department: [], unit: [] } %>
          </fieldset>
        <% end %>

        <% if form_finder.form_types.any? %>
          <fieldset class="pb-filter-set">
            <legend>Form Type</legend>
            <div class="pb-checkbox-row">
              <% form_finder.form_types.each_with_index do |form_type, index| %>
                <label class="pb-checkbox">
                  <%= check_box_tag "form_filter_type[]", form_type, false,
                                    id: "pb-search-type-#{index}",
                                    data: { advanced_search_target: "formType" } %>
                  <span><%= form_type %></span>
                </label>
              <% end %>
            </div>
          </fieldset>
        <% end %>

        <% if form_finder.tags.any? %>
          <fieldset class="pb-filter-set">
            <%# Ticking several tags widens rather than narrows: a form needs
                only one of them, the same way the type boxes work. %>
            <legend>Tags</legend>
            <div class="pb-checkbox-row pb-checkbox-row--scroll">
              <% form_finder.tags.each_with_index do |tag, index| %>
                <label class="pb-checkbox">
                  <%= check_box_tag "form_filter_tag[]", tag, false,
                                    id: "pb-search-tag-#{index}",
                                    data: { advanced_search_target: "tag" } %>
                  <span><%= tag %></span>
                </label>
              <% end %>
            </div>
          </fieldset>
        <% end %>
      <% else %>
        <p class="pb-modal__message">
          None of your forms have been tagged yet. An administrator sets a
          form's agency, type, number and tags in Manage Form Templates, and
          they become filters here.
        </p>
      <% end %>
    </div>

    <div class="pb-modal__actions">
      <button type="button" class="btn clear-filters"
              data-action="advanced-search#clear">Clear filters</button>
      <button type="button" class="btn" data-action="advanced-search#close">Cancel</button>
      <button type="button" class="btn approve" data-action="advanced-search#apply">Apply</button>
    </div>
  </div>
</div>
