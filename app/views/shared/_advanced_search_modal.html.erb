<%# Advanced Search — the filter panel behind the sidebar button.

    It is a GET to the Submissions list using the same parameter names its
    filter bar already uses, so a search is always reproducible from its URL
    and can be bookmarked, saved or handed to somebody else. The bar sends one
    value per filter; this panel sends several, which FormSearch and
    Filterable#apply_filters both understand.

    The org selects are the shared cascade partial — Agency → Division →
    Department → Unit, refilled from /lookups as the user narrows. %>
<div class="pb-modal-backdrop" hidden
     data-advanced-search-target="modal"
     data-action="click->advanced-search#backdropClose">
  <div class="pb-modal pb-modal--xl" role="dialog" aria-modal="true"
       aria-labelledby="pb-advanced-search-title">
    <div class="pb-modal__header">
      <h3 id="pb-advanced-search-title">Advanced Search</h3>
      <button type="button" class="pb-modal__close" aria-label="Close"
              data-action="advanced-search#close">✕</button>
    </div>

    <%= form_with url: submissions_path, method: :get,
                  class: "pb-advanced-form", data: { turbo: false } do %>
      <%# A search looks across everything the viewer is allowed to see, rather
          than the list's default of "mine" — asking for a whole unit's forms
          and getting back your own reads as a broken search. `all` still means
          the viewer's own and their subordinates' unless they are a system
          admin, and the Submissions list ignores it entirely for anyone with
          neither reports nor admin rights. Sent as a parameter so the widening
          stays visible in the URL and can be narrowed again from the filter
          bar. %>
      <%= hidden_field_tag :filter_employee, params[:filter_employee].presence || "all" %>

      <div class="pb-modal__body">
        <fieldset class="pb-filter-set">
          <legend>Organization</legend>
          <%= render "shared/org_cascade",
                     scope: "advanced-search", standalone: false, prefix: "filter",
                     selected: { agency: form_search.agency, division: form_search.division,
                                 department: form_search.department, unit: form_search.unit } %>
        </fieldset>

        <fieldset class="pb-filter-set">
          <legend>Form</legend>
          <div class="pb-checkbox-row">
            <% FormSearch.form_type_options.each_with_index do |form_type, index| %>
              <label class="pb-checkbox">
                <%= check_box_tag "filter_type[]", form_type,
                                  form_search.form_types.include?(form_type),
                                  id: "pb-search-type-#{index}" %>
                <span><%= form_type %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <fieldset class="pb-filter-set">
          <legend>Status</legend>
          <div class="pb-checkbox-row">
            <% FormSearch.status_options.each_with_index do |status, index| %>
              <label class="pb-checkbox">
                <%= check_box_tag "filter_status[]", status,
                                  form_search.statuses.include?(status),
                                  id: "pb-search-status-#{index}" %>
                <span><%= status %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <fieldset class="pb-filter-set">
          <%# A status belongs to exactly one category, so this is the coarse
              way to ask the same question — "anything denied", whatever each
              form calls its denial. %>
          <legend>Category</legend>
          <div class="pb-checkbox-row">
            <% FormSearch.category_options.each_with_index do |category, index| %>
              <label class="pb-checkbox">
                <%= check_box_tag "filter_category[]", category,
                                  form_search.categories.include?(category),
                                  id: "pb-search-category-#{index}" %>
                <span><%= category %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      </div>

      <div class="pb-modal__actions">
        <%= link_to "Clear filters", submissions_path, class: "btn clear-filters", data: { turbo: false } %>
        <button type="button" class="btn" data-action="advanced-search#close">Cancel</button>
        <button type="submit" class="btn approve">Search</button>
      </div>
    <% end %>
  </div>
</div>
