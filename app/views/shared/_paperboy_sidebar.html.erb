<%# app/views/shared/_paperboy_sidebar.html.erb %>
<button class="hamburger-btn" data-controller="sidebar" data-action="click->sidebar#toggle">
  <span class="navbar-toggler-icon"></span>
</button>

<!-- Overlay -->
<div class="sidebar-overlay" data-controller="sidebar" data-action="click->sidebar#close"></div>

<div class="sidebar" data-controller="sidebar-search advanced-search"
     data-advanced-search-org-labels-value="<%= OrgLabels.js_config.to_json %>">
  <%= render "shared/app_switcher" %>
  <% if current_user %>
    <input
      type="text"
      placeholder="Search forms, fields, tags..."
      data-sidebar-search-target="input"
      data-action="input->sidebar-search#filter"
      class="sidebar-search-input"
    />

    <%# The box above narrows the list of forms you can fill out; this searches
        forms already submitted, and lands on the Submissions list. %>
    <button type="button"
            class="btn secondary compact pb-advanced-trigger<%= ' has-filters' if form_search.advanced? %>"
            data-action="advanced-search#open">
      Advanced Search<%= " •" if form_search.advanced? %>
    </button>
    <%
    # Map legacy form names to ACL keys
    legacy_form_key_map = {
      "Creative Job Request" => "creative_job_request",
      "Leave of Absence"    => "leave_of_absence",
      "Workplace Violence"  => "workplace_violence",
      "Notice of Change"    => "notice_of_change",
    }

    # Legacy forms not managed via Forms::Template
    legacy_forms = [
      ["Creative Job Request", new_creative_job_request_path],
      ["Leave of Absence", new_leave_of_absence_form_path],
      ["Workplace Violence", new_workplace_violence_form_path],
      ["Notice of Change", new_notice_of_change_form_path],
    ]
    # Billing Tools used to be pinned to the top of this list for system
    # admins. Its buttons are now in the Billing app's sidebar, reached from
    # the app switcher above.

    # ACL whitelist: non-admins only see forms they have explicit permission for
    form_perm_keys = system_admin? ? nil : current_user_form_permission_keys

    # Filter legacy forms through ACL (admins bypass)
    unless system_admin?
      legacy_forms.select! { |name, _| form_perm_keys&.include?(legacy_form_key_map[name]) }
    end

    available_forms = legacy_forms.dup

    # Cache form templates with their field labels and tags for search
    form_field_labels = {}
    form_tags = {}
    Forms::Template.active.includes(:form_fields).each do |template|
      form_field_labels[template.name] = template.form_fields.pluck(:label).join(", ")
      form_tags[template.name] = template.tags_array.join(", ")
    end

    # Resolve the route path for a Forms::Template.
    # Tries the standard _form convention first, then falls back
    # to the base name for legacy forms (e.g. critical_information_reportings).
    resolve_path = ->(template) {
      begin
        send("new_#{template.file_name}_path")
      rescue NoMethodError
        send("new_#{template.file_name.chomp('_form')}_path") rescue nil
      end
    }

    # Add form templates — non-admins only see those granted by ACL
    # Archived templates are excluded from the sidebar but remain in Manage Form Templates.
    Forms::Template.active.each do |template|
      path = resolve_path.call(template)
      next unless path
      next if available_forms.any? { |f| f[0] == template.name }
      next if !system_admin? && !form_perm_keys&.include?(template.id.to_s)
      available_forms << [template.name, path]
    end
    %>
    <div data-sidebar-search-target="formsList">
      <% available_forms.sort_by { |f| f[0] }.each do |label, path| %>
        <%= link_to label, path, class: "nav-link",
            data: {
              turbo_frame: "main-content",
              sidebar_search_target: "formLink",
              fields: form_field_labels[label] || "",
              tags: form_tags[label] || ""
            } %>
      <% end %>
    </div>

    <%= render "shared/advanced_search_modal" %>
  <% else %>
    <p class="sidebar-p">Please log in to access forms.</p>
  <% end %>
</div>
