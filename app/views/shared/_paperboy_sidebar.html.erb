<%# app/views/shared/_paperboy_sidebar.html.erb %>
<button class="hamburger-btn" data-controller="sidebar" data-action="click->sidebar#toggle">
  <span class="navbar-toggler-icon"></span>
</button>

<!-- Overlay -->
<div class="sidebar-overlay" data-controller="sidebar" data-action="click->sidebar#close"></div>

<%
  # The list of forms and the facets over it are the same on both surfaces that
  # offer them — this sidebar and the command palette — so FormCatalog builds
  # them for both. Nothing here runs for a signed-out visitor: the ACL lookups
  # inside need somebody to ask about.
  #
  # Billing Tools used to be pinned to the top of this list for system admins.
  # Its buttons are now in the Billing app's sidebar, reached from the app
  # switcher above.
  catalog = if current_user
              FormCatalog.new(admin: system_admin?,
                              permitted_keys: current_user_form_permission_keys)
            end
%>
<div class="sidebar"
     <%= tag.attributes(data: { controller: "sidebar-search" }) if catalog %>>
  <%= render "shared/app_switcher" %>
  <% if current_user %>
    <input
      type="text"
      placeholder="Search forms, numbers, fields, tags — or ask who am i"
      data-sidebar-search-target="input"
      data-action="input->sidebar-search#filter keydown.enter->sidebar-search#activate"
      class="sidebar-search-input"
    />

    <%# The box above narrows this list by text. Narrowing on the metadata an
        admin set in the form builder — org, type, tags — needs more room than
        a sidebar has, so the button opens the Form Library instead. %>
    <%= link_to "Advanced Search", form_library_path,
                class: "btn secondary compact pb-advanced-trigger" %>

    <%= render "shared/search_commands", row_class: "nav-link sidebar-command" %>

    <div data-sidebar-search-target="formsList">
      <% catalog.forms.each do |label, path| %>
        <%= link_to label, path, class: "nav-link",
            data: catalog.search_data(label)
                         .merge(turbo_frame: "main-content",
                                sidebar_search_target: "formLink") %>
      <% end %>
      <%# Shown only when the search box leaves nothing, so a list that has
          gone empty says why. %>
      <p class="sidebar-p sidebar-empty" data-sidebar-search-target="emptyState" hidden>
        No forms match.
      </p>
    </div>
  <% else %>
    <p class="sidebar-p">Please log in to access forms.</p>
  <% end %>
  <%= render "shared/sidebar_footer" %>
</div>
