<div id="status-history-modal"
     class="pb-modal-backdrop"
     data-status-history-modal-target="backdrop"
     style="display:none;">
  <div class="pb-modal pb-modal--lg pb-modal--status-history" data-status-history-modal-target="modal"
       role="dialog" aria-modal="true" aria-labelledby="status-history-modal-title">
    <div class="pb-modal__header">
      <h3 id="status-history-modal-title" data-status-history-modal-target="title">Status History</h3>
      <button type="button" class="pb-modal__close" data-action="status-history-modal#close" aria-label="Close">✕</button>
    </div>

    <div class="pb-modal__body" data-status-history-modal-target="body">
      <p class="status-history-modal__loading">Loading…</p>
    </div>
  </div>
</div>
