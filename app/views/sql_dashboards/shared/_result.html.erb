<%# One run of a query: the message when it failed, otherwise its chart and,
    when asked (or when the query is a table), its rows.
    Locals: result, query, rows (true to always list the rows), dom_key. %>
<% chart = SqlDashboards::ChartData.new(chart_type: query.chart_type, columns: result.columns, rows: result.rows) %>
<% if result.ok? %>
  <% if rows %>
    <p class="sql-result__status">
      <%= pluralize(number_with_delimiter(result.rows.size), "row") %> in <%= number_with_delimiter(result.duration_ms) %> ms
    </p>
  <% end %>
  <% if result.truncated %>
    <p class="sql-result__notice">
      Only the first <%= number_with_delimiter(result.rows.size) %> rows are shown. The query returned more.
    </p>
  <% end %>

  <% if chart.drawable? %>
    <div class="sql-chart" id="<%= dom_key %>-chart"
         data-controller="sql-chart"
         data-sql-chart-type-value="<%= chart.chart_class %>"
         data-sql-chart-series-value="<%= chart.series.to_json %>"
         data-sql-chart-options-value="<%= chart.options.to_json %>"></div>
  <% elsif chart.problem %>
    <p class="sql-result__notice"><%= chart.problem %></p>
  <% end %>

  <% if rows || chart.table? %>
    <div class="sql-result__rows">
      <table class="submission-table sql-result__table">
        <thead>
          <tr>
            <% result.columns.each do |column| %>
              <th><%= column %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% result.rows.each do |row| %>
            <tr>
              <% row.each do |value| %>
                <td><%= sql_dashboard_cell(value) %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% else %>
  <div class="sql-result__error" role="alert">
    <strong>The query did not run.</strong>
    <pre><%= result.error %></pre>
  </div>
<% end %>
