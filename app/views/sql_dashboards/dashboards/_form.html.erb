<%= form_with model: @dashboard, scope: :dashboard,
              url: @dashboard.persisted? ? sql_dashboards_dashboard_path(@dashboard) : sql_dashboards_dashboards_path do |f| %>
  <%= render "sql_dashboards/shared/errors", record: @dashboard %>

  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :description %>
    <%= f.text_area :description, class: "form-control", rows: 2 %>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel",
                @dashboard.persisted? ? sql_dashboards_dashboard_path(@dashboard) : sql_dashboards_dashboards_path,
                class: "btn" %>
    <%= f.submit @dashboard.persisted? ? "Save dashboard" : "Create dashboard", class: "btn approve" %>
  </div>
<% end %>
