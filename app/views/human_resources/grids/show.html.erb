<%= turbo_frame_tag 'human-resources-grid', data: { human_resources_sidebar_target: 'grid' } do %>
  <% if @error %>
    <p class="human-resources-grid__error" role="alert"><%= @error %></p>
  <% else %>
    <div class="human-resources-grid">
      <%= render 'pfa/grid/table', columns: @grid.columns, rows: @grid.rows,
                 header: ->(column) { column.label },
                 cell: ->(column, row) { row[column.key] } %>
      <div class="pagination-wrapper">
        <nav class="human-resources-grid__nav" aria-label="Row navigation">
          <% if @pagy.previous %>
            <%= link_to 'Previous', human_resources_grid_path(@definition.slug, page: @pagy.previous),
                        class: 'btn compact', data: { turbo_frame: 'human-resources-grid' } %>
          <% else %>
            <button type="button" class="btn compact" disabled>Previous</button>
          <% end %>
          <% if @pagy.next %>
            <%= link_to 'Next', human_resources_grid_path(@definition.slug, page: @pagy.next),
                        class: 'btn compact', data: { turbo_frame: 'human-resources-grid' } %>
          <% else %>
            <button type="button" class="btn compact" disabled>Next</button>
          <% end %>
        </nav>
        <p class="pagination-info">
          <% if @pagy.count.positive? %>
            Showing <%= number_with_delimiter(@pagy.from) %>–<%= number_with_delimiter(@pagy.to) %> of <%= number_with_delimiter(@pagy.count) %> rows
          <% else %>
            Showing 0 of 0 rows
          <% end %>
        </p>
      </div>
    </div>
  <% end %>
<% end %>
