<%# app/views/human_resources/shared/_sidebar.html.erb
    Sidebar for the Human Resources app. The app switcher header is shared with
    every other app; everything below it is this app's own navigation. %>
<div class="sidebar human-resources-sidebar">
  <%= render "shared/app_switcher" %>

  <nav class="human-resources-links">
    <%# The root path is the slideshow landing page; the working dashboard is
        one level in, matching how AIM splits home from dashboard. %>
    <%= link_to "Home", human_resources_root_path,
                class: "nav-link#{' active' if current_page?(human_resources_root_path)}" %>
    <%= link_to "Hello World", human_resources_dashboard_path,
                class: "nav-link#{' active' if current_page?(human_resources_dashboard_path)}" %>
  </nav>
</div>
