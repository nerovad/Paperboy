<%# app/views/human_resources/shared/_sidebar.html.erb
    Sidebar for the Human Resources app. The app switcher header is shared with
    every other app; everything below it is this app's own navigation. %>
<div class="sidebar human-resources-sidebar" data-controller="human-resources-sidebar"
     data-human-resources-sidebar-slideshow-url-value="<%= human_resources_root_path %>">
  <%= render "shared/app_switcher" %>

  <nav class="human-resources-links" aria-label="Human Resources actions">
    <% if can_use_app_feature?('human_resources', 'data_refresh') %>
      <%= link_to "Refresh Data", human_resources_data_refresh_path,
                  class: "nav-link#{' active' if current_page?(human_resources_data_refresh_path)}" %>
    <% end %>
    <% ["Employees", "Bargaining Units", "FLSA Status", "Job Salaries",
        "Unions", "Union codes", "VCHRP unions"].each do |label| %>
      <button type="button" class="nav-link" data-action="human-resources-sidebar#select"
              data-human-resources-sidebar-label-param="<%= label %>"><%= label %></button>
    <% end %>
  </nav>

  <div class="pb-modal-backdrop" data-human-resources-sidebar-target="backdrop" hidden>
    <section class="pb-modal pb-modal--sidebar-selection" role="dialog" aria-modal="true"
             aria-labelledby="human-resources-selection-title">
      <div class="pb-modal__header">
        <h3 id="human-resources-selection-title" data-human-resources-sidebar-target="title"></h3>
        <button type="button" class="pb-modal__close" aria-label="Close"
                data-action="human-resources-sidebar#dismiss">✕</button>
      </div>
      <div class="pb-modal__body">
        <p data-human-resources-sidebar-target="message"></p>
      </div>
      <div class="pb-modal__actions">
        <button type="button" class="btn" data-action="human-resources-sidebar#dismiss">Cancel</button>
        <button type="button" class="btn approve" data-action="human-resources-sidebar#dismiss">Okay</button>
      </div>
    </section>
  </div>
</div>
