<%# app/views/production/shared/_sidebar.html.erb
    Sidebar for the Production app. The app switcher header is shared with
    every other app; below it is the bookmark list from Production::Links,
    which the command palette searches from every other app. %>
<div class="sidebar production-sidebar">
  <%= render "shared/app_switcher" %>

  <nav class="production-links">
    <div class="production-links__label">Paperboy</div>
    <% Production::Links.grouped.each_value.with_index do |links, index| %>
      <% if index.positive? %>
        <div class="production-links__divider" role="separator"></div>
      <% end %>
      <% links.each do |link| %>
        <%= link_to link[:label], link[:url],
                    class: "nav-link",
                    title: link[:title],
                    target: "_blank",
                    rel: "noopener" %>
      <% end %>
    <% end %>
  </nav>
</div>
