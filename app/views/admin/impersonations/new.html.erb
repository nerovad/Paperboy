<!-- app/views/admin/impersonations/new.html.erb -->
<div class="form-header">
  <h1>Emulate</h1>
</div>

<div class="form-wrapper impersonation-wrapper">
  <%= form_with url: admin_impersonations_path, method: :post do |f| %>
    <%= f.label :employee_id, "Select Employee or Contractor:" %>
    <div data-controller="choices">
      <%= f.select :employee_id,
                   grouped_options_for_select(
                     "Employees" => @employees.map { |e| ["#{e.first_name} #{e.last_name} (#{e.employee_id})", e.employee_id] },
                     "Contractors" => @contractors.map { |c| [contractor_emulation_label(c), c.id] }
                   ),
                   { prompt: "Choose a user..." },
                   { class: "form-control", data: { choices_target: "select", placeholder: "Search for an employee or contractor..." } } %>
    </div>

    <%= f.submit "Emulate", class: "btn-impersonate" %>
    <%= link_to "Cancel", root_path, class: "btn-back" %>
  <% end %>
</div>
