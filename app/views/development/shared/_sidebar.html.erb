<div class="sidebar development-sidebar">
  <%= render "shared/app_switcher" %>
  <nav class="development-links">
    <%= link_to "Dashboard", development_root_path,
                class: "nav-link#{' active' if current_page?(development_root_path)}" %>
    <% Development::ScriptCatalog.groups.each do |group| %>
      <% scripts = Development::ScriptCatalog.for_group(group).select { |script| can_use_app_feature?('development', script[:feature]) } %>
      <% next if scripts.empty? %>
      <details class="nav-group" <%= 'open' if scripts.any? { |script| params[:script_key] == script[:key] } %>>
        <summary><span class="nav-group-label"><%= development_group_label(group) %></span></summary>
        <% scripts.each do |script| %>
          <%= link_to script[:label], "#{development_root_path}?script_key=#{script[:key]}",
                      class: "nav-link#{' active' if params[:script_key] == script[:key]}" %>
        <% end %>
      </details>
    <% end %>
  </nav>
  <%= render "shared/sidebar_footer" %>
</div>
