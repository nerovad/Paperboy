<div class="development-page">
  <div class="form-header">
    <h1>Development Workflows</h1>
    <p>Run approved Paperboy development scripts with recorded output.</p>
  </div>

  <% if @selected_script %>
    <section class="development-section development-section--selected">
      <h2><%= development_group_label(@selected_script[:group]) %></h2>
      <div class="development-cards">
        <%= render "development/runs/card", script: @selected_script, gitea_choices: @gitea_choices,
                   gitea_issue: @gitea_issue %>
      </div>
    </section>
  <% elsif @show_recent_runs %>
    <section class="development-section">
      <h2>Recent Runs</h2>
      <% if @recent_runs.any? %>
        <div class="development-runs">
          <% @recent_runs.each do |run| %>
            <%= link_to development_run_path(run), class: "development-run" do %>
              <span><%= run.script_label %></span>
              <span class="development-status development-status--<%= run.status %>"><%= run.status.humanize %></span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p>No workflow runs yet.</p>
      <% end %>
    </section>
  <% else %>
    <section class="development-section development-empty-state">
      <h2>Select a workflow</h2>
      <p>Choose a workflow from the sidebar to open its form.</p>
    </section>
  <% end %>
</div>
