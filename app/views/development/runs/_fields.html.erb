<% key = development_field(script) %>
<% case key %>
<% when 'unit_test' %>
  <%= label_tag :target, 'Test target (optional)' %><%= text_field_tag :target, nil, class: 'form-control', placeholder: 'test' %>
<% when 'environment_check', 'environment_pull' %>
  <%= label_tag :lockbox, 'LockBox checkout (optional)' %><%= text_field_tag :lockbox, nil, class: 'form-control' %>
  <% if key == 'environment_pull' %>
    <%= label_tag :no_pull, class: 'checkbox-label' do %><%= check_box_tag :no_pull %> Do not pull LockBox<% end %>
    <%= label_tag :prune, class: 'checkbox-label' do %><%= check_box_tag :prune %> Accept removed variables<% end %>
  <% end %>
<% when 'status_report' %>
  <%= label_tag :stale_days, 'Stale after days' %><%= number_field_tag :stale_days, 30, min: 0, class: 'form-control' %>
<% when 'tag_commit' %>
  <%= label_tag :commit, 'Commit (optional)' %><%= text_field_tag :commit, nil, class: 'form-control', placeholder: 'HEAD' %>
<% when 'deploy_dev' %>
  <%= label_tag :branch, 'Branch' %><%= text_field_tag :branch, 'master', required: true, class: 'form-control' %>
<% when 'deploy_stage', 'deploy_production' %>
  <%= label_tag :tag, 'Release tag' %><%= text_field_tag :tag, nil, required: true, class: 'form-control', placeholder: 'v2.1.0-a1a91a09e' %>
<% when 'deploy_aim_workers' %>
  <%= label_tag :lockbox, 'LockBox checkout (optional)' %><%= text_field_tag :lockbox, nil, class: 'form-control' %>
  <%= label_tag :target, 'Target directory (optional)' %><%= text_field_tag :target, nil, class: 'form-control' %>
  <%= label_tag :apply, class: 'checkbox-label' do %><%= check_box_tag :apply %> Apply changes (otherwise dry-run)<% end %>
  <%= label_tag :v2, class: 'checkbox-label' do %><%= check_box_tag :v2 %> Deploy v2 workers<% end %>
<% when 'generate_csr' %>
  <%= label_tag :environment, 'Environment' %><%= text_field_tag :environment, nil, required: true, class: 'form-control', placeholder: 'dev' %>
  <%= label_tag :server_ip, 'Server IP' %><%= text_field_tag :server_ip, nil, required: true, class: 'form-control' %>
  <%= label_tag :extra_dns_names, 'Extra DNS names (space separated)' %><%= text_field_tag :extra_dns_names, nil, class: 'form-control' %>
<% when 'create_issue' %>
  <%= render 'development/runs/issue_create_fields', gitea_choices: local_assigns[:gitea_choices] %>
<% when 'create_pull_request' %>
  <%= label_tag :title, 'Title' %><%= text_field_tag :title, nil, required: true, class: 'form-control' %>
  <%= label_tag :body, 'Body (optional)' %><%= text_area_tag :body, nil, rows: 4, class: 'form-control' %>
  <%= label_tag :head, 'Head branch (optional)' %><%= text_field_tag :head, nil, class: 'form-control', placeholder: 'Current branch' %>
  <%= label_tag :base, 'Base branch (optional)' %><%= text_field_tag :base, 'master', class: 'form-control' %>
  <%= label_tag :issue, 'Issue number (optional)' %><%= number_field_tag :issue, nil, min: 1, class: 'form-control' %>
<% when 'update_issue' %>
  <%= render 'development/runs/issue_update_fields', gitea_choices: local_assigns[:gitea_choices] %>
<% when 'clean_worktree' %>
  <%= label_tag :issue, 'Issue number' %><%= number_field_tag :issue, nil, required: true, min: 1, class: 'form-control' %>
<% end %>
