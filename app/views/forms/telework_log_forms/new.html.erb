                    <div class="form-group flex-fill">
                      <%= vf.label :work_performed, "Work Performed" %>
                      <%= vf.text_area :work_performed, rows: 3, class: "form-control" %>
                    </div>
          </div>
          <div class="repeatable-row-actions">
            <button type="button" class="repeatable-remove-btn" data-action="repeatable-section#remove" aria-label="Remove" title="Remove">&minus;</button>
          </div>
        </div>
            <% end %>
          </div>
          <template data-repeatable-section-target="template">
            <%= form.fields_for :telework_log_form_work_performeds, TeleworkLogFormWorkPerformed.new, child_index: "NEW_RECORD" do |vf| %>
              <div class="repeatable-block" data-block-index="NEW_RECORD">
          <div class="form-row d-flex flex-wrap">
                    <div class="form-group flex-fill">
                      <%= vf.label :work_performed, "Work Performed" %>
                      <%= vf.text_area :work_performed, rows: 3, class: "form-control" %>
