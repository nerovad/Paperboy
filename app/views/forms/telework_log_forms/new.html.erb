          </div>
          <div class="repeatable-row-actions">
            <button type="button" class="repeatable-remove-btn" data-action="repeatable-section#remove" aria-label="Remove" title="Remove">&minus;</button>
          </div>
        </div>
            <% end %>
          </template>
          <button type="button" class="btn btn-secondary btn-sm add-repeatable-btn"
                  data-repeatable-section-target="addButton"
                  data-action="repeatable-section#add">+ Add Work Performed</button>
        </div>
<!-- FIELD:work_performed END -->
<!-- FIELD:hours START -->        <div class="form-group repeatable-section" style="flex: 0 0 100%;"
             data-controller="repeatable-section"
             data-repeatable-section-min-value="1"
             data-repeatable-section-max-value="0">
          <div data-repeatable-section-target="wrapper">
            <%= form.fields_for :telework_log_form_hours do |vf| %>
              <div class="repeatable-block" data-block-index="<%= vf.index %>">
          <div class="form-row d-flex flex-wrap">
                    <div class="form-group flex-fill">
                      <%= vf.label :hours, "Hours" %>
                      <%= vf.number_field :hours, class: "form-control" %>
                    </div>
          </div>
          <div class="repeatable-row-actions">
            <button type="button" class="repeatable-remove-btn" data-action="repeatable-section#remove" aria-label="Remove" title="Remove">&minus;</button>
          </div>
        </div>
            <% end %>
          </div>
          <template data-repeatable-section-target="template">
            <%= form.fields_for :telework_log_form_hours, TeleworkLogFormHour.new, child_index: "NEW_RECORD" do |vf| %>
              <div class="repeatable-block" data-block-index="NEW_RECORD">
          <div class="form-row d-flex flex-wrap">
                    <div class="form-group flex-fill">
                      <%= vf.label :hours, "Hours" %>
                      <%= vf.number_field :hours, class: "form-control" %>
                    </div>
          </div>
          <div class="repeatable-row-actions">
            <button type="button" class="repeatable-remove-btn" data-action="repeatable-section#remove" aria-label="Remove" title="Remove">&minus;</button>
          </div>
        </div>
            <% end %>
          </template>
          <button type="button" class="btn btn-secondary btn-sm add-repeatable-btn"
                  data-repeatable-section-target="addButton"
                  data-action="repeatable-section#add">+ Add Hours</button>
        </div>
<!-- FIELD:hours END -->
<!-- FIELD:total_hours START --><div class="form-group flex-fill<%= '' %>">
  <%= form.label :total_hours, "Total Hours" %>
            <%= form.number_field :total_hours, class: "form-control", required: true %>
          </div>
<!-- FIELD:total_hours END -->
        </div>
      </div>

    <!-- Navigation Buttons -->
    <div class="navigation-buttons d-flex justify-content-between">
      <div>
        <button type="button" id="prevBtn" data-action="click->form-navigation#prevPage" style="display:none;">Previous</button>
      </div>
      <div>
        <button type="button" id="nextBtn" data-action="click->form-navigation#nextPage">Next</button>
        <%= form.submit "Submit", data: { form_navigation_target: "submitButton" }, style: "display:none;" %>
      </div>
    </div>

  <% end %>
</div>
