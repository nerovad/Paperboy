<div class="form-header">
  <%= render "shared/back_button" %>
  <h1>Notice Of Change Form</h1>
</div>

<div class="form-wrapper">
  <div class="form-inner">

  <%= render partial: "shared/readonly_record",
             locals: { record: @notice_of_change_form,
                       exclude: %w[id created_at updated_at approver_id deny_reason] } %>

  <div class="form-actions" style="margin-top: 16px;">
    <%= link_to "Download PDF", pdf_notice_of_change_form_path(@notice_of_change_form), target: "_blank", class: "form-btn" %>
    <%= render "shared/change_status", record: @notice_of_change_form %>
  </div>
  </div>
</div>
