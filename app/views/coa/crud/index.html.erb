<section class="coa-page">
  <div class="coa-header">
    <div>
      <h1><%= collection_title %></h1>
    </div>
  </div>

  <% search_config = {
       "Coa::Agency" => { id: :agency_search, label: "Search agencies",
                          placeholder: "Fuzzy search by agency ID or name…",
                          columns: %w[agency_id long_name] },
       "Coa::Division" => { id: :division_search, label: "Search divisions",
                            placeholder: "Fuzzy search by division ID or name…",
                            columns: %w[division_id long_name] },
       "Coa::Department" => { id: :department_search, label: "Search departments",
                              placeholder: "Fuzzy search by department ID or name…",
                              columns: %w[department_id long_name] },
       "Coa::Unit" => { id: :unit_search, label: "Search units",
                        placeholder: "Fuzzy search by unit ID or name…",
                        columns: %w[unit_id long_name] },
       "Coa::Activity" => { id: :activity_search, label: "Search activities",
                            placeholder: "Fuzzy search by activity ID or name…",
                            columns: %w[activity_id long_name] },
       "Coa::Function" => { id: :function_search, label: "Search functions",
                            placeholder: "Fuzzy search by function ID or name…",
                            columns: %w[function_id long_name] },
       "Coa::Fund" => { id: :fund_search, label: "Search funds",
                        placeholder: "Fuzzy search by fund ID or name…",
                        columns: %w[fund_id long_name] },
       "Coa::MajorProgram" => { id: :major_program_search, label: "Search major programs",
                                placeholder: "Fuzzy search by major program ID or name…",
                                columns: %w[major_program_id long_name] },
       "Coa::Object" => { id: :object_search, label: "Search objects",
                          placeholder: "Fuzzy search by object ID or name…",
                          columns: %w[object_id long_name] },
       "Coa::Phase" => { id: :phase_search, label: "Search phases",
                         placeholder: "Fuzzy search by phase ID or name…",
                         columns: %w[phase_id long_name] },
       "Coa::Program" => { id: :program_search, label: "Search programs",
                           placeholder: "Fuzzy search by program ID or name…",
                           columns: %w[program_id long_name] },
       "Coa::RevenueSource" => { id: :revenue_source_search, label: "Search revenue sources",
                                 placeholder: "Fuzzy search by revenue source ID or name…",
                                 columns: %w[revenue_source_id long_name] },
       "Coa::ObjectInference" => { id: :object_inference_search, label: "Search object inferences",
                                   placeholder: "Fuzzy search by agency object code or name…",
                                   columns: %w[agency_object_code], object_name: true },
       "Coa::SubUnit" => { id: :sub_unit_search, label: "Search sub units",
                           placeholder: "Fuzzy search by sub unit ID or name…",
                           columns: %w[sub_unit_id sub_unit_name] },
       "Coa::Task" => { id: :task_search, label: "Search tasks",
                        placeholder: "Fuzzy search by task ID or name…",
                        columns: %w[task_id long_name] }
     }[model_class.name] %>
  <div class="coa-grid" data-controller="<%= "sidebar-search" if search_config %>"
       <%= "data-sidebar-search-debounce-value=250" if search_config %>>
    <% if search_config %>
      <section class="coa-lookup-card coa-grid-search">
        <%= label_tag search_config[:id], search_config[:label],
                      class: "coa-lookup-card__heading" %>
        <div class="coa-lookup-card__body">
          <%= search_field_tag search_config[:id], nil,
                               class: "coa-grid-search__input",
                               placeholder: search_config[:placeholder],
                               autocomplete: "off",
                               data: { sidebar_search_target: "input",
                                       action: "input->sidebar-search#filter" } %>
        </div>
      </section>
    <% end %>

    <div class="table-wrapper coa-table-wrapper">
      <table class="submission-table coa-table">
        <thead>
          <tr>
            <% display_columns.each do |column_name| %>
              <th><%= column_name.humanize %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% records.each do |row| %>
            <% search_values = search_config ? search_config[:columns].map { |column| row.public_send(column) } : [] %>
            <% search_values << row.object&.long_name if search_config&.fetch(:object_name, false) %>
            <tr <%= "data-sidebar-search-target=item" if search_config %>
                data-search="<%= search_values.join(" ") %>">
              <% display_columns.each do |column_name| %>
                <td><%= row.public_send(column_name) %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
