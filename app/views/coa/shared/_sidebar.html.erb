<div class="sidebar coa-sidebar">
  <%= render "shared/app_switcher" %>

  <div class="coa-table-links">
    <%# Each entry is an ACL > Application Features grant under Chart of
        Accounts; coa_sidebar_resources is already filtered to what this user
        holds. %>
    <% lookup_links = [
         ["Billing Lookup", coa_billing_lookup_path, "billing_lookup"],
         ["Customer Lookup", coa_customer_lookup_path, "customer_lookup"]
       ].select { |_, _, feature| can_use_app_feature?("coa", feature) } %>
    <% resource_labels = {
         "Coa::Agency" => "Agency",
         "Coa::Division" => "Division",
         "Coa::Department" => "Department",
         "Coa::Unit" => "Unit",
         "Coa::SubUnit" => "Sub Unit",
         "Coa::Activity" => "Activity",
         "Coa::Function" => "Function",
         "Coa::Fund" => "Fund",
         "Coa::MajorProgram" => "Major Programs",
         "Coa::Object" => "Object",
         "Coa::Phase" => "Phase",
         "Coa::Program" => "Program",
         "Coa::RevenueSource" => "Revenue Source",
         "Coa::ObjectInference" => "Object Inference",
         "Coa::Task" => "Task"
       } %>
    <% budget_unit_names = %w[Coa::Agency Coa::Division Coa::Department Coa::Unit Coa::SubUnit] %>
    <% budget_unit_resources = coa_sidebar_resources.select { |resource| budget_unit_names.include?(resource.name) } %>
    <% accounting_code_resources = coa_sidebar_resources.reject { |resource| budget_unit_names.include?(resource.name) } %>
    <% current_resource = lambda do |resource|
         path = coa_sidebar_collection_path(resource)
         current_page?(path) || request.path.start_with?("#{path}/")
       end %>

    <% unless lookup_links.empty? %>
      <details class="nav-group" <%= "open" if lookup_links.any? { |_, path, _| current_page?(path) } %>>
        <summary><span class="nav-group-label">Lookups</span></summary>
        <% lookup_links.each do |label, path, _| %>
          <%= link_to label, path, class: "nav-link" %>
        <% end %>
      </details>
    <% end %>

    <% unless budget_unit_resources.empty? %>
      <details class="nav-group" <%= "open" if budget_unit_resources.any?(&current_resource) %>>
        <summary><span class="nav-group-label">Budget Unit</span></summary>
        <% budget_unit_resources.each do |model_class| %>
          <%= link_to resource_labels.fetch(model_class.name),
                      coa_sidebar_collection_path(model_class), class: "nav-link" %>
        <% end %>
      </details>
    <% end %>

    <% unless accounting_code_resources.empty? %>
      <details class="nav-group" <%= "open" if accounting_code_resources.any?(&current_resource) %>>
        <summary><span class="nav-group-label">Accounting Codes</span></summary>
        <% accounting_code_resources.each do |model_class| %>
          <%= link_to resource_labels.fetch(model_class.name),
                      coa_sidebar_collection_path(model_class), class: "nav-link" %>
        <% end %>
      </details>
    <% end %>
  </div>
</div>
