<section class="coa-page">
  <div class="coa-header">
    <div>
      <h1>Billing Lookup</h1>
      <p class="coa-subtitle">Find a billing account string using familiar organization names.</p>
    </div>
  </div>

  <div class="coa-form coa-billing-lookup"
       data-controller="coa-billing-lookup"
       data-coa-billing-lookup-divisions-url-value="<%= divisions_coa_billing_lookup_path %>"
       data-coa-billing-lookup-departments-url-value="<%= departments_coa_billing_lookup_path %>"
       data-coa-billing-lookup-units-url-value="<%= units_coa_billing_lookup_path %>"
       data-coa-billing-lookup-objects-url-value="<%= objects_coa_billing_lookup_path %>"
       data-coa-billing-lookup-activities-url-value="<%= activities_coa_billing_lookup_path %>"
       data-coa-billing-lookup-cfunctions-url-value="<%= cfunctions_coa_billing_lookup_path %>"
       data-coa-billing-lookup-programs-url-value="<%= programs_coa_billing_lookup_path %>"
       data-coa-billing-lookup-phases-url-value="<%= phases_coa_billing_lookup_path %>"
       data-coa-billing-lookup-tasks-url-value="<%= tasks_coa_billing_lookup_path %>">
    <section class="coa-lookup-card" aria-labelledby="organization-selection-title">
      <h2 id="organization-selection-title" class="coa-lookup-card__heading">Organization Selection</h2>
      <div class="coa-lookup-card__body coa-billing-fields">
        <div class="field coa-billing-field">
          <%= label_tag :billing_agency, "Agency" %>
          <%= select_tag :billing_agency,
                         options_for_select([["Select one", ""]] + @agency_options.map { |option| [option[:label], option[:value]] }),
                         data: { coa_billing_lookup_target: "agency",
                                 action: "change->coa-billing-lookup#agencyChanged" } %>
        </div>

        <div class="field coa-billing-field">
          <%= label_tag :billing_division, "Division" %>
          <%= select_tag :billing_division, options_for_select([["Select one", ""]]), disabled: true,
                         data: { coa_billing_lookup_target: "division",
                                 action: "change->coa-billing-lookup#divisionChanged" } %>
        </div>

        <div class="field coa-billing-field">
          <%= label_tag :billing_department, "Department" %>
          <%= select_tag :billing_department, options_for_select([["Select one", ""]]), disabled: true,
                         data: { coa_billing_lookup_target: "department",
                                 action: "change->coa-billing-lookup#departmentChanged" } %>
        </div>

        <div class="field coa-billing-field">
          <%= label_tag :billing_unit, "Unit" %>
          <%= select_tag :billing_unit, options_for_select([["Select one", ""]]), disabled: true,
                         data: { coa_billing_lookup_target: "unit",
                                 action: "change->coa-billing-lookup#unitChanged" } %>
        </div>
      </div>
    </section>

    <div class="coa-billing-sections" data-coa-billing-lookup-target="accountFields" hidden>
    <section class="coa-lookup-card" aria-labelledby="account-hierarchy-title">
      <h2 id="account-hierarchy-title" class="coa-lookup-card__heading">Account Hierarchy</h2>
      <div class="coa-lookup-card__body">
        <ul class="coa-account-tree">
          <li>
            <span>Agency - <code data-coa-billing-lookup-target="agencyId"></code> - <strong data-coa-billing-lookup-target="agencyName"></strong></span>
            <ul>
              <li>
                <span>Division - <code data-coa-billing-lookup-target="divisionId"></code> - <strong data-coa-billing-lookup-target="divisionName"></strong></span>
                <ul>
                  <li>
                    <span>Department - <code data-coa-billing-lookup-target="departmentId"></code> - <strong data-coa-billing-lookup-target="departmentName"></strong></span>
                    <ul>
                      <li><span>Unit - <code data-coa-billing-lookup-target="unitId"></code> - <strong data-coa-billing-lookup-target="unitName"></strong></span></li>
                    </ul>
                  </li>
                </ul>
              </li>
            </ul>
          </li>
        </ul>
      </div>
    </section>

    </div>

    <div class="coa-billing-result" data-coa-billing-lookup-target="accountFields result" hidden>
      <section class="coa-lookup-card" aria-labelledby="billing-account-string-title">
        <h2 id="billing-account-string-title" class="coa-lookup-card__heading">Billing Account String</h2>
        <div class="coa-lookup-card__body">
          <div class="coa-billing-string-grid-wrap">
            <div class="coa-billing-string-grid">
            <div class="coa-billing-string-grid__heading">Agency</div>
            <div class="coa-billing-string-grid__heading">Division</div>
            <div class="coa-billing-string-grid__heading">Department</div>
            <div class="coa-billing-string-grid__heading">Unit</div>
            <div class="coa-billing-string-grid__heading">COBJECT</div>
            <div class="coa-billing-string-grid__heading">CACTIVITY</div>
            <div class="coa-billing-string-grid__heading">CFUNCTION</div>
            <div class="coa-billing-string-grid__heading">CPROGRAM</div>
            <div class="coa-billing-string-grid__heading">CPHASE</div>
            <div class="coa-billing-string-grid__heading">CTASK</div>
            <code data-coa-billing-lookup-target="billingAgencyId"></code>
            <code data-coa-billing-lookup-target="billingDivisionId"></code>
            <code data-coa-billing-lookup-target="billingDepartmentId"></code>
            <code data-coa-billing-lookup-target="billingUnitId"></code>
            <% [
              ["COBJECT", "cobject"],
              ["CACTIVITY", "cactivity"],
              ["CFUNCTION", "cfunction"],
              ["CPROGRAM", "cprogram"],
              ["CPHASE", "cphase"],
              ["CTASK", "ctask"]
            ].each do |label, target| %>
              <div class="coa-billing-string-grid__field">
                <%= select_tag "billing_#{target}", options_for_select([["Select an agency first", ""]]),
                               disabled: true, aria: { label: label },
                               data: { coa_billing_lookup_target: target } %>
              </div>
            <% end %>
            </div>
          </div>
          <button type="button" class="btn approve compact coa-billing-copy"
                  data-action="coa-billing-lookup#copy">Copy</button>
        </div>
      </section>
    </div>
  </div>
</section>
