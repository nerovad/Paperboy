<table class="p2m-associated-files-table">
  <thead>
    <tr>
      <th scope="col">File name</th>
      <th scope="col">File name</th>
    </tr>
  </thead>
  <tbody>
    <% @associated_files.each_slice(2) do |names| %>
      <tr>
        <% names.each do |name| %>
          <td>
            <% if File.extname(name).casecmp?('.zip') %>
              <span class="p2m-associated-file-name" title="<%= name %>"><%= name %></span>
            <% else %>
              <%= link_to name,
                          preview_p2m_stage_data_path(directory: params[:directory],
                                                      oms_number: @oms_number, filename: name),
                          class: "p2m-associated-file-name", title: name,
                          target: "_blank", rel: "noopener" %>
            <% end %>
          </td>
        <% end %>
        <% if names.one? %>
          <td aria-hidden="true"></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
<div class="p2m-maildat-actions">
  <%= link_to "Print Tray Labels",
              print_tray_labels_p2m_stage_data_path(directory: params[:directory],
                                                    oms_number: @oms_number),
              class: "btn pdf compact", target: "_blank", rel: "noopener" %>
  <button type="button" class="btn reassign compact"
          data-action="data-refresh-groups#staging"
          data-staging-url="<%= move_to_shipping_station_p2m_stage_data_path %>"
          data-staging-method="POST" data-staging-action="Move to Shipping Station"
          data-directory="<%= params[:directory] %>" data-oms-number="<%= @oms_number %>">
    Move to Shipping Station
  </button>
  <button type="button" class="btn deny compact"
          data-action="data-refresh-groups#staging"
          data-staging-url="<%= remove_from_shipping_station_p2m_stage_data_path %>"
          data-staging-method="DELETE" data-staging-action="Remove from Shipping Station"
          data-confirm-message="Remove the Mail.dat file for OMS <%= @oms_number %> from the Shipping Station?"
          data-directory="<%= params[:directory] %>" data-oms-number="<%= @oms_number %>">
    Remove from Shipping Station
  </button>
  <%= link_to "Upload to USPS", "https://gateway.usps.com/eAdmin/view/signin",
              class: "btn approve compact", target: "_blank", rel: "noopener" %>
  <button type="button" class="btn approve compact"
          data-action="data-refresh-groups#staging"
          data-staging-url="<%= move_to_staging_p2m_stage_data_path %>"
          data-staging-method="POST" data-staging-action="Move to Staging"
          data-directory="<%= params[:directory] %>" data-oms-number="<%= @oms_number %>">
    Move to Staging
  </button>
  <button type="button" class="btn deny compact"
          data-action="data-refresh-groups#staging"
          data-staging-url="<%= remove_from_staging_p2m_stage_data_path %>"
          data-staging-method="DELETE" data-staging-action="Remove from Staging"
          data-confirm-message="Remove associated files for OMS <%= @oms_number %> from Staging?"
          data-directory="<%= params[:directory] %>" data-oms-number="<%= @oms_number %>">
    Remove from Staging
  </button>
  <button type="button" class="btn compact" data-action="data-refresh-groups#feedback"
          data-feedback-action="Cancel" data-feedback-oms="<%= @oms_number %>">Cancel</button>
</div>
