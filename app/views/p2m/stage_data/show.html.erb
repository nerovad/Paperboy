<div class="form-header p2m-form-header">
  <h1>Mail.dat uploaded to USPS</h1>
</div>

<div class="form-wrapper p2m-stage-data">
  <section class="p2m-stage-card" aria-labelledby="p2m-date-range-title">
    <h2 id="p2m-date-range-title">Date Range</h2>

    <%= form_with url: p2m_stage_data_path, method: :post,
                  data: { turbo: false, controller: "date-range",
                          action: "submit->date-range#validate reset->date-range#reset" } do %>
      <div class="p2m-stage-date-fields">
        <div class="form-group">
          <%= label_tag "stage_data_start_date", "Start Date" %>
          <%= date_field_tag "stage_data[start_date]", @start_date,
                             id: "stage_data_start_date", class: "form-control", required: true,
                             data: { date_range_target: "startDate", action: "input->date-range#validateRange" } %>
        </div>
        <div class="form-group">
          <%= label_tag "stage_data_end_date", "End Date" %>
          <%= date_field_tag "stage_data[end_date]", @end_date,
                             id: "stage_data_end_date", class: "form-control", required: true,
                             data: { date_range_target: "endDate", action: "input->date-range#validateRange" } %>
        </div>
      </div>

      <div class="form-actions">
        <%= submit_tag "Confirm", class: "btn approve" %>
        <%= button_tag "Reset", type: :reset, class: "btn warning" %>
        <%= link_to "Cancel", p2m_root_path, class: "btn" %>
      </div>
    <% end %>
  </section>

  <% if @report.present? %>
    <section class="p2m-stage-card" aria-labelledby="p2m-oms-results-title">
      <h2 id="p2m-oms-results-title">
        Mail.dat Files Found at <%= @report.fetch("source_root", "/mnt/o/Outputs") %>/...
      </h2>
      <p>
        Inclusive range: <%= @report.fetch("start_date") %> through
        <%= @report.fetch("end_date") %>
        — found <%= @report.fetch("found_count", 0) %> in
        <%= format("%.4f", @report.fetch("search_seconds", 0)) %> seconds
      </p>
      <div class="table-wrap p2m-maildat-grid">
        <table class="p2m-maildat-table">
          <thead>
            <tr>
              <th>OMS Number</th>
              <th>Location</th>
              <th>Modified</th>
            </tr>
          </thead>
          <tbody>
            <% @report.fetch("files", []).each do |file| %>
              <tr>
                <td><%= file.fetch("oms_number") %></td>
                <td><%= file.fetch("directory") %></td>
                <td><%= file.fetch("modified_at") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
