<div class="form-header p2m-form-header">
  <h1>OMS Uploads</h1>
</div>

<div class="form-wrapper p2m-stage-data">
  <section class="p2m-stage-card p2m-stage-card--compact" aria-labelledby="p2m-upload-date-range-title">
    <h2 id="p2m-upload-date-range-title">Date Range</h2>

    <%= form_with(url: p2m_oms_uploads_path, method: :get,
                  data: { turbo: false, controller: "date-range",
                          action: "submit->date-range#validate reset->date-range#reset" }) do %>
      <div class="p2m-stage-date-fields">
        <div class="form-group">
          <%= label_tag "oms_uploads_start_date", "Start Date" %>
          <%= date_field_tag "oms_uploads[start_date]", @start_date,
                             id: "oms_uploads_start_date", class: "form-control", required: true,
                             data: { date_range_target: "startDate",
                                     action: "input->date-range#validateRange" } %>
        </div>
        <div class="form-group">
          <%= label_tag "oms_uploads_end_date", "End Date" %>
          <%= date_field_tag "oms_uploads[end_date]", @end_date,
                             id: "oms_uploads_end_date", class: "form-control", required: true,
                             data: { date_range_target: "endDate",
                                     action: "input->date-range#validateRange" } %>
        </div>
      </div>

      <div class="form-actions">
        <%= submit_tag "Confirm", class: "btn approve compact" %>
        <%= button_tag "Reset", type: :reset, class: "btn warning compact" %>
        <%= link_to "Cancel", p2m_root_path, class: "btn compact" %>
      </div>
    <% end %>
  </section>

  <section class="p2m-stage-card" aria-labelledby="p2m-oms-uploads-title">
    <h2 id="p2m-oms-uploads-title">Staged Mailing Jobs</h2>
    <p>One row per OMS number and mailer date. Mailed counts indicate records with postage.</p>

    <div class="table-wrap p2m-maildat-grid">
      <table class="submission-table p2m-maildat-table" data-controller="data-refresh-groups">
        <thead>
          <tr>
            <th>OMS Number</th>
            <th>Mailer Date</th>
            <th>Budget Job</th>
            <th>Input</th>
            <th>Mailed</th>
            <th>Non-Mailed</th>
            <th>Stage Progress</th>
            <th>Findings</th>
          </tr>
        </thead>
        <tbody>
          <% @uploads.each_with_index do |upload, index| %>
            <% detail_id = "p2m-oms-upload-#{upload.id}-details" %>
            <tr class="p2m-maildat-row<%= " is-alternate" if index.odd? %>" data-detail-id="<%= detail_id %>">
              <td>
                <button type="button" class="p2m-row-trigger"
                        aria-expanded="false" aria-controls="<%= detail_id %>"
                        aria-label="Show details for OMS <%= upload.oms_number %>"
                        data-action="data-refresh-groups#toggle" data-detail-id="<%= detail_id %>">
                  <span aria-hidden="true">▸</span>
                </button>
                <%= upload.oms_number %>
              </td>
              <td><%= upload.mailer_date.iso8601 %></td>
              <td><%= upload.budget_job_id.presence || "—" %></td>
              <td><%= upload.input_record_count || "—" %></td>
              <td><%= upload.mailed_record_count || "—" %></td>
              <td><%= upload.non_mailed_record_count || "—" %></td>
              <td>
                <dl class="p2m-upload-stages">
                  <div><dt>Overall</dt><dd><%= upload.status.humanize %></dd></div>
                  <div><dt>Validation</dt><dd><%= upload.validation_status.humanize %></dd></div>
                  <div><dt>Import</dt><dd><%= upload.import_status.humanize %></dd></div>
                  <div><dt>Archive</dt><dd><%= upload.archive_status.humanize %></dd></div>
                </dl>
              </td>
              <td title="<%= upload.findings.map(&:message).compact.join(' ') %>">
                <%= upload.findings.count { |finding| finding.status == "failed" } %> errors,
                <%= upload.findings.count { |finding| finding.severity == "info" } %> info
              </td>
            </tr>
            <tr id="<%= detail_id %>" class="p2m-maildat-detail" hidden>
              <td colspan="8">
                <div class="p2m-upload-details">
                  <section>
                    <h3>Mailing Job</h3>
                    <dl class="p2m-upload-metadata">
                      <div><dt>Document Profile</dt><dd><%= upload.document_profile.presence || "—" %></dd></div>
                      <div><dt>Production Workflow</dt><dd><%= upload.production_workflow.presence || "—" %></dd></div>
                      <div><dt>AIMS Job</dt><dd><%= upload.aims_job_id.presence || "—" %></dd></div>
                      <div><dt>Files</dt><dd><%= upload.files.size %></dd></div>
                    </dl>
                  </section>
                  <section>
                    <h3>Findings</h3>
                    <ul>
                      <% upload.findings.each do |finding| %>
                        <li>
                          <strong><%= finding.rule.humanize %>:</strong>
                          <%= finding.status.humanize %>
                          <% if finding.observed_value.present? %>
                            — observed <%= finding.observed_value %>
                          <% end %>
                          <% if finding.message.present? %> — <%= finding.message %><% end %>
                        </li>
                      <% end %>
                    </ul>
                  </section>
                  <section>
                    <h3>Original Files</h3>
                    <ul>
                      <% upload.files.sort_by(&:original_filename).each do |file| %>
                        <li>
                          <%= file.original_filename %> — <%= file.category.humanize %>,
                          <%= number_to_human_size(file.byte_size) %>
                        </li>
                      <% end %>
                    </ul>
                  </section>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @uploads.empty? %>
            <tr><td colspan="8">No OMS uploads have been recorded.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @pagy&.pages.to_i > 1 %>
      <div class="pagination-wrapper">
        <%== @pagy.series_nav %>
        <p class="pagination-info">
          Showing <%= @pagy.from %>–<%= @pagy.to %> of <%= @pagy.count %> OMS uploads
        </p>
      </div>
    <% end %>
  </section>
</div>
