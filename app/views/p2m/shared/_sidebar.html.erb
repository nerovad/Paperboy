<%# app/views/p2m/shared/_sidebar.html.erb
    Sidebar for the Print 2 Mail app. The app switcher header is shared with
    every other app; everything below it is this app's own navigation. %>
<div class="sidebar p2m-sidebar">
  <%= render "shared/app_switcher" %>

  <nav class="p2m-links">
    <%# The root path is the slideshow landing page; the working dashboard is
        one level in, matching how AIM splits home from dashboard. %>
    <%= link_to "Home", p2m_root_path,
                class: "nav-link#{' active' if current_page?(p2m_root_path)}" %>
    <%= link_to "Hello World", p2m_dashboard_path,
                class: "nav-link#{' active' if current_page?(p2m_dashboard_path)}" %>
  </nav>
</div>
