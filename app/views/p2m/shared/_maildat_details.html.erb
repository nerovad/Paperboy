<div data-controller="pdf-preview">
<table class="p2m-associated-files-table">
  <thead>
    <tr>
      <th scope="col" class="p2m-associated-file-select" aria-label="Select file"></th>
      <th scope="col">Filename</th>
      <th scope="col" class="p2m-associated-file-select" aria-label="Select file"></th>
      <th scope="col">Filename</th>
    </tr>
  </thead>
  <tbody>
    <% @associated_files.each_slice(2).with_index do |names, row_index| %>
      <tr>
        <% names.each_with_index do |name, column_index| %>
          <% extension = File.extname(name).downcase %>
          <% checkbox_id = "p2m-file-#{@oms_number}-#{row_index}-#{column_index}" %>
          <td class="p2m-associated-file-select">
            <%= check_box_tag "selected_files[]", name, false, id: checkbox_id,
                              aria: { label: "Select #{name}" } %>
          </td>
          <td>
            <% if %w[.csv .txt .zip].include?(extension) %>
              <span class="p2m-associated-file-name" title="<%= name %>"><%= name %></span>
            <% elsif extension == '.pdf' %>
              <%= link_to name,
                          preview_p2m_stage_data_path(directory: params[:directory],
                                                      oms_number: @oms_number, filename: name),
                          class: "p2m-associated-file-name", title: name,
                          data: { action: "pdf-preview#open", pdf_preview_title: name } %>
            <% else %>
              <%= link_to name,
                          preview_p2m_stage_data_path(directory: params[:directory],
                                                      oms_number: @oms_number, filename: name),
                          class: "p2m-associated-file-name", title: name,
                          target: "_blank", rel: "noopener" %>
            <% end %>
          </td>
        <% end %>
        <% if names.one? %>
          <td class="p2m-associated-file-select" aria-hidden="true"></td>
          <td aria-hidden="true"></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
<div class="p2m-maildat-actions">
  <% if production_stage == :pre %>
    <button type="button" class="btn approve compact"
            data-controller="printer-selection"
            data-action="printer-selection#open"
            data-printer-selection-oms-value="<%= @oms_number %>"
            data-printer-selection-catalog-value="<%= @printer_queues.to_json %>">
      Send to Printer
    </button>
    <button type="button" class="btn compact" data-action="data-refresh-groups#feedback"
            data-feedback-action="Cancel" data-feedback-oms="<%= @oms_number %>">Cancel</button>
  <% else %>
  <%= link_to "Print Tray Labels",
              print_tray_labels_p2m_stage_data_path(directory: params[:directory],
                                                    oms_number: @oms_number),
              class: "btn pdf compact",
              data: { action: "pdf-preview#open", pdf_preview_title: "Tray Labels" } %>
  <button type="button" class="btn reassign compact"
          data-action="data-refresh-groups#staging"
          data-staging-url="<%= move_to_shipping_station_p2m_stage_data_path %>"
          data-staging-method="POST" data-staging-action="Move to Shipping Station"
          data-directory="<%= params[:directory] %>" data-oms-number="<%= @oms_number %>">
    Move to Shipping Station
  </button>
  <button type="button" class="btn deny compact"
          data-action="data-refresh-groups#staging"
          data-staging-url="<%= remove_from_shipping_station_p2m_stage_data_path %>"
          data-staging-method="DELETE" data-staging-action="Remove from Shipping Station"
          data-confirm-message="Remove the Mail.dat file for OMS <%= @oms_number %> from the Shipping Station?"
          data-directory="<%= params[:directory] %>" data-oms-number="<%= @oms_number %>">
    Remove from Shipping Station
  </button>
  <%= link_to "Upload to USPS", "https://gateway.usps.com/eAdmin/view/signin",
              class: "btn approve compact", target: "_blank", rel: "noopener" %>
  <button type="button" class="btn approve compact"
          data-action="data-refresh-groups#staging"
          data-staging-url="<%= move_to_staging_p2m_stage_data_path %>"
          data-staging-method="POST" data-staging-action="Move to Staging"
          data-staging-remove-on-success="true"
          data-directory="<%= params[:directory] %>" data-oms-number="<%= @oms_number %>">
    Move to Staging
  </button>
  <button type="button" class="btn deny compact"
          data-action="data-refresh-groups#staging"
          data-staging-url="<%= remove_from_staging_p2m_stage_data_path %>"
          data-staging-method="DELETE" data-staging-action="Remove from Staging"
          data-confirm-message="Remove associated files for OMS <%= @oms_number %> from Staging?"
          data-directory="<%= params[:directory] %>" data-oms-number="<%= @oms_number %>">
    Remove from Staging
  </button>
  <button type="button" class="btn compact" data-action="data-refresh-groups#feedback"
          data-feedback-action="Cancel" data-feedback-oms="<%= @oms_number %>">Cancel</button>
  <% end %>
</div>

<% unless production_stage == :pre %>
<div class="p2m-staging-progress" data-staging-progress hidden>
  <progress aria-label="Moving files to staging"></progress>
  <span data-staging-progress-label aria-live="polite">Moving files… 0.0 seconds elapsed</span>
</div>
<% end %>

<div class="pb-modal-backdrop" data-pdf-preview-target="backdrop"
     data-action="click->pdf-preview#backdropClose" hidden>
  <div class="pb-modal pb-modal--report-preview" role="dialog" aria-modal="true"
       aria-labelledby="p2m-pdf-preview-title-<%= @oms_number %>">
    <div class="pb-modal__header">
      <h3 id="p2m-pdf-preview-title-<%= @oms_number %>" data-pdf-preview-target="title">
        PDF Preview
      </h3>
      <button type="button" class="pb-modal__close" data-action="pdf-preview#close"
              aria-label="Close">✕</button>
    </div>
    <div class="pb-modal__body pb-pdf-preview" data-pdf-preview-target="body"></div>
    <div class="pb-modal__actions">
      <button type="button" class="btn" data-action="pdf-preview#close">Close</button>
    </div>
  </div>
</div>
</div>
