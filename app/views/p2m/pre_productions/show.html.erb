<div class="form-header p2m-form-header">
  <h1>Pre Production</h1>
</div>

<div class="form-wrapper p2m-stage-data">
  <%= render "p2m/shared/date_range_card",
             title_id: "p2m-pre-production-date-range-title",
             url: p2m_pre_production_path,
             method: :get,
             scope: :pre_production %>

  <% if @report.present? %>
    <%= render "p2m/shared/maildat_grid", report: @report, production_stage: :pre,
               details_path: ->(file) {
                 details_p2m_pre_production_path(directory: file.fetch("directory"),
                                                 oms_number: file.fetch("oms_number"))
               } %>
  <% end %>
</div>
