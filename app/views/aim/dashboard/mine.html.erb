<%# Someone's own dashboard (#131): their queue, what has waited, what waits on
    their second approval or their typing, and the oldest. %>
<div class="aim-page aim-dashboard-page">
  <header class="aim-page-header">
    <div>
      <h1 class="aim-page-title">My AIM</h1>
      <p class="aim-page-subtitle">What is waiting on you. <%= link_to 'How AIM works', aim_help_path %></p>
    </div>
    <div class="aim-page-header__pills">
      <%= link_to 'My Queue', aim_my_queue_path, class: 'btn approve compact' %>
      <%= link_to 'Upload Invoices', new_aim_upload_path, class: 'btn compact' %>
    </div>
  </header>

  <%= render 'aim/shared/find_box', url: aim_find_path,
                                    wheres: Aim::Invoice::QUEUES.map { |queue, config| [config[:label], queue] } %>

  <%= render 'aim/shared/attention_tiles', tiles: @tiles %>

  <h2 class="aim-profile-heading">Waiting longest in my queue</h2>
  <section class="aim-panel aim-agency-group-panel">
    <%= render 'aim/shared/oldest', oldest: @oldest, path: ->(invoice) { aim_invoice_path(invoice.batch_id, queue: 'ready_for_approval') } %>
  </section>
</div>
