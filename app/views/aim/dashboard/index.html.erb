<div class="aim-page">
  <header class="aim-page-header">
    <div>
      <h1 class="aim-page-title">AIM Invoice Processing Portal</h1>
      <p class="aim-page-subtitle">Where every invoice is, at a glance.</p>
    </div>
    <%= link_to 'Upload Invoices', new_aim_upload_path, class: 'btn approve' %>
  </header>

  <% if aim_queue_access? %>
    <section class="aim-dashboard-grid" data-controller="aim-counts" data-aim-counts-url-value="<%= aim_counts_path %>">
      <% @dashboard_queues.each do |queue, config| %>
        <%= link_to aim_invoices_path(queue: queue), class: "aim-dashboard-card #{config[:css_class]}" do %>
          <h2><%= config[:label] %></h2>
          <div class="aim-dashboard-count" data-aim-count="<%= queue %>">…</div>
          <p><%= config[:description] %></p>
          <% if queue == 'needs_review' && @review_reasons.present? %>
            <p class="aim-dashboard-note">
              <%= @review_reasons.map { |reason, count| "#{count} #{aim_review_reason_label(reason).downcase}" }.join(', ') %>
            </p>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <section class="aim-panel aim-empty-state">
      <p>Invoices waiting for you are in My Queue.</p>
    </section>
  <% end %>
</div>
