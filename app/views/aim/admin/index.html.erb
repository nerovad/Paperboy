<div class="aim-page">
  <header class="aim-page-header">
    <div>
      <h1 class="aim-page-title">Users &amp; Queues</h1>
      <p class="aim-page-subtitle">Who works AIM. Budget unit coverage and each BU's shared queue are coming next.</p>
    </div>
    <span class="aim-count-pill"><%= pluralize(@people.length, 'person') %></span>
  </header>

  <section class="aim-panel aim-admin-add-panel">
    <%= form_with url: aim_members_path, method: :post, local: true, class: 'aim-inline-form' do |form| %>
      <%= render 'aim/shared/person_picker', name: :employee_id, label: 'Add a person', url: aim_admin_employees_path %>
      <%= form.submit 'Add to AIM', class: 'btn approve compact' %>
    <% end %>
  </section>

  <% if @people.empty? %>
    <section class="aim-panel aim-empty-state"><p>Nobody works AIM yet.</p></section>
  <% else %>
    <section class="aim-panel aim-queue-panel">
      <table class="submission-table aim-queue-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Employee ID</th>
            <th>Unit</th>
            <th>Added through</th>
            <th>Open invoices</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @people.each do |person| %>
            <% employee = person[:employee] %>
            <% name = "#{employee.last_name}, #{employee.first_name}" %>
            <tr>
              <td class="is-strong"><%= link_to name, aim_member_path(employee.id) %></td>
              <td><%= employee.id %></td>
              <td><%= employee.unit.presence || 'N/A' %></td>
              <td>
                <%= [('Admin list' if person[:member]), ('AIM group' if person[:via_group])].compact.join(' and ') %>
              </td>
              <td><%= person[:open] %></td>
              <td class="action-buttons">
                <%= link_to 'View queue', aim_member_path(employee.id), class: 'btn secondary compact' %>
                <% if person[:member] && person[:open].zero? %>
                  <%= button_to 'Remove', aim_member_path(employee.id), method: :delete,
                                data: { turbo_confirm: "Remove #{name} from AIM?", confirm_title: 'Remove from AIM',
                                        confirm_label: 'Remove' },
                                class: 'btn deny compact' %>
                <% elsif person[:member] %>
                  <%= link_to 'Move invoices to remove', aim_member_path(employee.id), class: 'btn reassign compact' %>
                <% else %>
                  Through a group, under ACL
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
</div>
