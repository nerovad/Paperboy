<%# The coding lookups (item b.3): Fiscal's rules by agency and budget unit. %>
<div class="aim-page" data-controller="aim-queue-filter">
  <header class="aim-page-header">
    <div>
      <h1 class="aim-page-title">Coding Rules</h1>
      <p class="aim-page-subtitle">What each vendor's invoices are coded with, by budget unit. Open a rule to change or retire it.</p>
    </div>
    <div class="aim-page-header__pills">
      <% if @units_without_rules.any? %>
        <span class="aim-count-pill aim-count-pill--warn" title="<%= @units_without_rules.join(', ') %>">
          ⚠ <%= pluralize(@units_without_rules.size, 'BU') %> with no rules
        </span>
      <% end %>
      <span class="aim-count-pill"><%= pluralize(@rules.size, 'rule') %></span>
      <%= link_to 'Load a file', new_aim_coding_import_path, class: 'btn approve compact' %>
      <%= link_to 'Imports', aim_coding_imports_path, class: 'btn compact' %>
    </div>
  </header>

  <div class="aim-people-toolbar">
    <%= form_with url: aim_coding_rules_path, method: :get, local: true, class: 'aim-people-toolbar__filters' do %>
      <%= select_tag :agency, options_for_select(@agencies, @agency), aria: { label: 'Agency' } %>
      <%= select_tag :unit, options_for_select(@units, @unit), include_blank: 'All budget units', aria: { label: 'Budget unit' } %>
      <%= select_tag :show, options_for_select([['In effect', 'in_effect'], ['All, retired too', 'all']], @show), aria: { label: 'Show' } %>
      <button type="submit" class="btn compact">Apply</button>
    <% end %>
    <%= render 'aim/invoices/search_box', placeholder: 'Search vendor, BDO, object, program…', empty: 'No rule matches.' %>
  </div>

  <% if @rules.empty? %>
    <section class="aim-panel aim-empty-state"><p>No rules yet. Load a file to start.</p></section>
  <% else %>
    <section class="aim-panel aim-queue-panel">
      <table class="submission-table aim-queue-table aim-rules-table">
        <thead>
          <tr>
            <th>BU</th><th>Vendor</th><th>Customer #</th><th>BDO / DO</th><th>Object</th><th>Program</th>
            <th>Activity</th><th>Function</th><th>Fund</th><th>In effect</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% @rules.each do |rule| %>
            <% search = [rule.budget_unit, rule.vendor_name, rule.customer_number, rule.encumbrance, rule.object_code, rule.program,
                         rule.activity, rule.function_code, rule.fund, rule.ma_number, rule.vendor_code].compact.join(' ') %>
            <tr data-aim-queue-filter-target="row" data-search="<%= search %>" class="<%= 'is-missing' unless rule.in_effect? %>">
              <td><%= rule.budget_unit %></td>
              <td class="is-strong"><%= link_to rule.vendor_name, aim_coding_rule_path(rule) %>
                <% if rule.warnings.present? %><span class="badge is-denied" title="<%= rule.warnings %>">unvalidated</span><% end %></td>
              <td><%= rule.customer_number || '—' %></td>
              <td><%= rule.encumbrance || '—' %></td>
              <td><%= rule.object_code || '—' %></td>
              <td><%= rule.program || '—' %></td>
              <td><%= rule.activity || '—' %></td>
              <td><%= rule.function_code || '—' %></td>
              <td><%= rule.fund || '—' %></td>
              <td><%= l(rule.effective_from, format: :short) %><%= " – #{l(rule.effective_until, format: :short)}" if rule.effective_until %></td>
              <td class="action-buttons"><%= link_to 'Open', aim_coding_rule_path(rule), class: 'btn secondary compact' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
</div>
