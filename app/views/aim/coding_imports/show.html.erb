<%# One import (item b.3): the report; Apply with any accepted rows while
    previewed; Undo once applied. %>
<% r = @report.with_indifferent_access %>
<div class="aim-page">
  <header class="aim-page-header">
    <div>
      <h1 class="aim-page-title"><%= @import.file_name %></h1>
      <p class="aim-page-subtitle">
        <%= @import.agency %> · <%= @import.imported_by %> · <%= @import.created_at.in_time_zone.strftime('%m/%d/%y %H:%M') %> ·
        <span class="badge <%= { 'applied' => 'is-approved', 'previewed' => 'is-pending', 'undone' => 'is-cancelled' }[@import.status] %>"><%= @import.status %></span>
        <% if @import.applied? %>· <%= @import.loaded_count %> loaded, <%= @import.refused_count %> refused, <%= @import.retired_count %> earlier rules replaced<% end %>
      </p>
    </div>
    <%= link_to 'Back to Imports', aim_coding_imports_path, class: 'btn compact' %>
  </header>

  <%= form_with url: apply_aim_coding_import_path(@import), method: :post, local: true do %>
    <section class="aim-panel">
      <% if r[:all_rows] %>
        <p>
          <strong><%= r[:rows] %></strong> rows:
          <strong><%= r[:adds] %></strong> new, <strong><%= r[:edits] %></strong> changing a rule,
          <strong><%= r[:unchanged] %></strong> already loaded, <strong><%= r[:refused] %></strong> refused.
          <% if r[:unknown_columns].present? %>Columns not understood: <%= r[:unknown_columns].join(', ') %>.<% end %>
        </p>
        <nav class="aim-people-toolbar__views" aria-label="Show rows">
          <% { nil => ['All', r[:rows]], 'add' => ['New', r[:adds]], 'edit' => ['Edit', r[:edits]],
               'unchanged' => ['Same', r[:unchanged]], 'refused' => ['Refused', r[:refused]] }.each do |kind, (label, count)| %>
            <%= link_to "#{label} (#{count})", aim_coding_import_path(@import, only: kind),
                        class: "btn compact #{@only == kind ? 'active' : 'ghost'}" %>
          <% end %>
        </nav>
      <% else %>
        <p>
          <strong><%= r[:rows] %></strong> rows: <strong><%= r[:loadable] %></strong> loaded, <strong><%= r[:refused] %></strong> refused.
          <span class="aim-coding__help">Row detail is not kept for an import made from the command line.</span>
        </p>
      <% end %>

      <% if r[:all_rows].present? %>
        <div class="billing-type-audit-table-wrapper">
          <table class="submission-table aim-queue-table aim-import-preview">
            <thead>
              <tr>
                <th>Row</th><th>Outcome</th><th>Vendor</th><th>Cust #</th><th>BU</th><th>BDO / DO</th><th>MA #</th>
                <th>Vendor code</th><th>Fund</th><th>Object</th><th>Activity</th><th>Function</th><th>Program</th><th>Notes</th>
                <th><%= 'Load anyway' if @import.previewed? %></th>
              </tr>
            </thead>
            <tbody>
              <% r[:all_rows].each do |row| %>
                <% next if @only && row[:kind] != @only %>
                <% v = row[:values] %>
                <tr class="is-<%= row[:kind] %>">
                  <td><%= row[:row] %></td>
                  <td>
                    <strong><%= { 'add' => 'New', 'edit' => 'Edit', 'unchanged' => 'Same', 'refused' => 'Refused' }[row[:kind]] %></strong>
                    <% if row[:reasons].present? %><br><small><%= row[:reasons].join('; ') %></small><% end %>
                    <% if row[:notes].present? %><br><small><%= row[:notes].join('; ') %></small><% end %>
                  </td>
                  <% Aim::LookupReport::SHOWN.each do |f| %><td><%= v[f].presence || '—' %></td><% end %>
                  <td>
                    <% if row[:kind] == 'refused' && row[:acceptable] && @import.previewed? %>
                      <%= check_box_tag 'accept_rows[]', row[:row], false, id: "accept-#{row[:row]}", aria: { label: "Load row #{row[:row]} anyway" } %>
                    <% elsif row[:kind] == 'refused' && !row[:acceptable] %><small>cannot be a rule</small><% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% elsif r[:refused_rows].present? %>
        <h3 class="aim-fiscal-heading">Refused rows</h3>
        <table class="submission-table aim-queue-table">
          <thead><tr><th>Row</th><th>Vendor</th><th>Why</th><th><%= 'Load anyway' if @import.previewed? %></th></tr></thead>
          <tbody>
            <% r[:refused_rows].each do |row| %>
              <tr>
                <td><%= row[:row] %></td>
                <td class="is-strong"><%= row[:vendor].presence || '—' %></td>
                <td><%= row[:reasons].join('; ') %></td>
                <td>
                  <% if row[:acceptable] && @import.previewed? %>
                    <%= check_box_tag 'accept_rows[]', row[:row], false, id: "accept-#{row[:row]}", aria: { label: "Load row #{row[:row]} anyway" } %>
                  <% elsif !row[:acceptable] %><span class="aim-coding__help">cannot be a rule</span><% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <% if r[:accepted_rows].present? %>
        <h3 class="aim-fiscal-heading">Loaded with a warning</h3>
        <ul><% r[:accepted_rows].each do |row| %><li>Row <%= row[:row] %>: <%= row[:warnings].join('; ') %></li><% end %></ul>
      <% end %>

    </section>

    <div class="aim-form-actions">
      <div class="aim-action-group">
        <% if @import.previewed? %>
          <% question = if r[:refused].to_i.positive?
                          "#{pluralize(r[:refused], 'row')} will be refused (unless ticked). Load the other #{r[:loadable]} for #{@import.agency} anyway?"
                        else
                          "Load #{r[:loadable]} rules for #{@import.agency}?"
                        end %>
          <%= submit_tag 'Apply', class: 'btn approve',
                                  data: { turbo_confirm: question, confirm_title: r[:refused].to_i.positive? ? 'Some rows are refused' : 'Load the file',
                                          confirm_label: 'Load' } %>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if @import.previewed? %>
    <section class="aim-panel aim-import-retry">
      <%= form_with url: aim_coding_imports_path, method: :post, multipart: true, local: true, class: 'aim-inline-form' do %>
        <strong>Fixed the file?</strong>
        <%= hidden_field_tag :agency, @import.agency, id: nil %>
        <%= hidden_field_tag :effective, @import.effective_option, id: nil %>
        <%= hidden_field_tag :effective_date, @import.effective_from, id: nil %>
        <%= hidden_field_tag :default_unit, @import.default_unit, id: nil %>
        <%= hidden_field_tag :replaces, @import.id, id: nil %>
        <%= file_field_tag :file, accept: '.csv,text/csv', required: true, aria: { label: 'Corrected CSV file' } %>
        <%= submit_tag 'Read it again', class: 'btn secondary compact' %>
      <% end %>
    </section>
  <% end %>
  <div class="aim-action-group">
    <% if @import.applied? %>
      <%= button_to 'Undo this import', undo_aim_coding_import_path(@import), method: :post, class: 'btn deny',
                    data: { turbo_confirm: 'Undo? Its rules are retired and the ones it replaced come back.', confirm_label: 'Undo' } %>
    <% else %>
      <%= button_to 'Delete this import', aim_coding_import_path(@import), method: :delete, class: 'btn deny',
                    data: { turbo_confirm: 'Delete this import? It loaded nothing that is still in effect.', confirm_label: 'Delete' } %>
    <% end %>
  </div>
</div>
