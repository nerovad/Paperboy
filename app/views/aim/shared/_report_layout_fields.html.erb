<%# A Fiscal report's layout (#131, Aim::ReportLayout): format, and the
    columns ticked, ordered and named. A group's Default and its saved
    templates use the same fields. Locals: layout, title. %>
<fieldset>
  <legend><%= title %>: format</legend>
  <div class="aim-agency-group-columns">
    <% Aim::ReportLayout::EXPORT_FORMATS.each do |format, label| %>
      <label><%= radio_button_tag :export_format, format, layout.export_format == format %> <%= label %></label>
    <% end %>
  </div>
</fieldset>

<fieldset>
  <legend><%= title %>: columns</legend>
  <p class="aim-agency-group-meta">
    Tick the columns the report has. Drag ⠿ to put them in the report's order, left to right.
    Type a header to rename a column in the report; leave it blank to keep AIM's name.
  </p>
  <ol class="aim-column-order" data-controller="aim-column-order">
    <% chosen = layout.export_column_list %>
    <% layout.export_column_order.each_with_index do |column, index| %>
      <li class="aim-column-order__item">
        <span class="aim-column-order__handle" title="Drag to move" aria-hidden="true">⠿</span>
        <label><%= check_box_tag 'export_columns[]', column, chosen.include?(column), id: "column-#{index}" %> <%= column %></label>
        <%= text_field_tag "export_headers[#{column}]", layout.export_headers[column], placeholder: 'Header in the report',
                           class: 'aim-column-order__header', aria: { label: "Header for #{column}" } %>
      </li>
    <% end %>
  </ol>
</fieldset>
