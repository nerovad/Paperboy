<%# An invoice's coding line as fields (item b.2), the chart-of-accounts
    lists as dropdowns; used by the review page and the Fiscal page inside
    their forms. Locals: line, coa (Aim::CoaCodes), read_only. %>
<% searchable = %w[object_code activity program fund] %>
<div class="aim-fields aim-fiscal-grid">
  <div class="aim-field">
    <%= label_tag 'coding_line_encumbrance', aim_coding_field_label('encumbrance') %>
    <%= text_field_tag 'coding_line[encumbrance]', line.encumbrance, id: 'coding_line_encumbrance', disabled: read_only,
                       placeholder: 'BDO_4640…', autocomplete: 'off' %>
  </div>
  <% %w[ma_number vendor_code org_number].each do |field| %>
    <div class="aim-field">
      <%= label_tag "coding_line_#{field}", aim_coding_field_label(field) %>
      <%= text_field_tag "coding_line[#{field}]", line.public_send(field), id: "coding_line_#{field}", disabled: read_only, autocomplete: 'off' %>
    </div>
  <% end %>
  <% Aim::CoaCodes::OPTION_LISTS.keys.each do |field| %>
    <% options = coa.options(field) %>
    <div class="aim-field">
      <%= label_tag "coding_line_#{field}", aim_coding_field_label(field) %>
      <% if options.empty? %>
        <%= text_field_tag "coding_line[#{field}]", line.public_send(field), id: "coding_line_#{field}", disabled: read_only, autocomplete: 'off' %>
      <% else %>
        <%= select_tag "coding_line[#{field}]",
                       options_for_select(options + ([[line.public_send(field), line.public_send(field)]] if line.public_send(field).present? && options.none? { |_, v| v == line.public_send(field) }).to_a, line.public_send(field)),
                       include_blank: '—', id: "coding_line_#{field}", disabled: read_only,
                       data: (searchable.include?(field) ? { controller: 'aim-grouped-search', aim_grouped_search_placeholder_value: 'Search code or name…' } : {}) %>
      <% end %>
    </div>
  <% end %>
</div>
