<%# An invoice's coding line as fields (item b.2), the chart-of-accounts
    lists as plain dropdowns (the search widget cramps in this grid; typing
    a code in a select jumps to it); used by the review page and the Fiscal page inside
    their forms, and the coding rule page. Locals: line, coa (Aim::CoaCodes),
    read_only; prefix (the form scope, default coding_line). %>
<% prefix = local_assigns.fetch(:prefix, 'coding_line') %>
<div class="aim-fields aim-fiscal-grid">
  <div class="aim-field">
    <%= label_tag "#{prefix}_encumbrance", aim_coding_field_label('encumbrance') %>
    <%= text_field_tag "#{prefix}[encumbrance]", line.encumbrance, id: "#{prefix}_encumbrance", disabled: read_only,
                       placeholder: 'BDO_4640…', autocomplete: 'off' %>
  </div>
  <% %w[ma_number vendor_code org_number].each do |field| %>
    <div class="aim-field">
      <%= label_tag "#{prefix}_#{field}", aim_coding_field_label(field) %>
      <%= text_field_tag "#{prefix}[#{field}]", line.public_send(field), id: "#{prefix}_#{field}", disabled: read_only, autocomplete: 'off' %>
    </div>
  <% end %>
  <% (Aim::CodingLine::CODING_FIELDS & Aim::CoaCodes::OPTION_LISTS.keys).each do |field| %>
    <% options = coa.options(field) %>
    <div class="aim-field">
      <%= label_tag "#{prefix}_#{field}", aim_coding_field_label(field) %>
      <% if options.empty? %>
        <%= text_field_tag "#{prefix}[#{field}]", line.public_send(field), id: "#{prefix}_#{field}", disabled: read_only, autocomplete: 'off' %>
      <% else %>
        <%= select_tag "#{prefix}[#{field}]",
                       options_for_select(options + ([[line.public_send(field), line.public_send(field)]] if line.public_send(field).present? && options.none? { |_, v| v == line.public_send(field) }).to_a, line.public_send(field)),
                       include_blank: '—', id: "#{prefix}_#{field}", disabled: read_only %>
      <% end %>
    </div>
  <% end %>
</div>
