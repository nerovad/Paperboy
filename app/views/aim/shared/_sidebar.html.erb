<%# app/views/aim/shared/_sidebar.html.erb
    Sidebar for the Automated Invoice Management app. The app switcher header is shared with
    every other app; everything below it is this app's own navigation. AIM v2: the queues
    are the invoice rows' states, counted from the database. %>
<div class="sidebar aim-sidebar">
  <%= render "shared/app_switcher" %>

  <nav class="aim-links">
    <% if can_use_app_feature?("aim", "dashboard") %>
      <%= link_to "Dashboard", aim_dashboard_path,
                  class: "nav-link#{' active' if current_page?(aim_dashboard_path)}" %>
    <% end %>

    <%= link_to "Upload Invoices", new_aim_upload_path,
                class: "nav-link#{' active' if current_page?(new_aim_upload_path)}" %>

    <% if aim_queue_access? %>
      <div class="sidebar-section-label">Queues</div>
      <% Aim::Invoice::QUEUES.each do |queue, config| %>
        <% queue_path = aim_invoices_path(queue: queue) %>
        <%= link_to queue_path, class: "nav-link#{' active' if current_page?(queue_path)}" do %>
          <span><%= config[:label] %></span>
          <span class="sidebar-count <%= config[:css_class].delete_prefix('aim-card-') %>">
            <%= @aim_queue_counts.fetch(queue, 0) %>
          </span>
        <% end %>
      <% end %>

      <div class="sidebar-section-label">Vendors</div>
      <%= link_to "Vendor Aliases", aim_vendor_aliases_path,
                  class: "nav-link#{' active' if current_page?(aim_vendor_aliases_path)}" %>
      <%= link_to "Vendor Rules", aim_vendor_rules_path,
                  class: "nav-link#{' active' if current_page?(aim_vendor_rules_path)}" %>
    <% end %>
  </nav>
</div>
