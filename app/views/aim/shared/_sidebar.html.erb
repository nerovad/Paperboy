<%# app/views/aim/shared/_sidebar.html.erb
    Sidebar for Automated Invoice Management, grouped the way Production's is:
    AIM (open by default), Queues, Vendors, Admin. A group stays open while you
    are anywhere inside it -- an invoice opened from a queue keeps Queues open.
    The counts are filled in after the page draws (aim_counts_controller). %>
<% in_queues = controller_name == "invoices" %>
<% in_vendors = %w[vendor_aliases vendor_rules].include?(controller_name) %>
<div class="sidebar aim-sidebar" data-controller="aim-counts" data-aim-counts-url-value="<%= aim_counts_path %>">
  <%= render "shared/app_switcher" %>

  <nav class="aim-links">
    <details class="nav-group" <%= "open" unless in_queues || in_vendors || controller_name == "admin" %>>
      <summary><span class="nav-group-label">AIM</span></summary>
      <% if can_use_app_feature?("aim", "dashboard") %>
        <%= link_to "Dashboard", aim_dashboard_path,
                    class: "nav-link#{' active' if current_page?(aim_dashboard_path)}" %>
      <% end %>
      <% if aim_has_queue? %>
        <%= link_to aim_my_queue_path, class: "nav-link#{' active' if current_page?(aim_my_queue_path)}" do %>
          <span>My Queue</span>
          <span class="sidebar-count warning" data-aim-count="my_queue" data-hide-zero hidden></span>
        <% end %>
      <% end %>
      <%= link_to "Upload Invoices", new_aim_upload_path,
                  class: "nav-link#{' active' if current_page?(new_aim_upload_path)}" %>
    </details>

    <% if aim_queue_access? %>
      <details class="nav-group" <%= "open" if in_queues %>>
        <summary><span class="nav-group-label">Queues</span></summary>
        <% Aim::Invoice::QUEUES.each do |queue, config| %>
          <% queue_path = aim_invoices_path(queue: queue) %>
          <%= link_to queue_path, class: "nav-link#{' active' if in_queues && params[:queue].to_s == queue}" do %>
            <span><%= config[:label] %></span>
            <span class="sidebar-count <%= config[:css_class].delete_prefix('aim-card-') %>" data-aim-count="<%= queue %>">…</span>
          <% end %>
        <% end %>
      </details>

      <details class="nav-group" <%= "open" if in_vendors %>>
        <summary><span class="nav-group-label">Vendors</span></summary>
        <%= link_to "Vendor Aliases", aim_vendor_aliases_path,
                    class: "nav-link#{' active' if current_page?(aim_vendor_aliases_path)}" %>
        <%= link_to "Vendor Rules", aim_vendor_rules_path,
                    class: "nav-link#{' active' if current_page?(aim_vendor_rules_path)}" %>
      </details>

      <details class="nav-group" <%= "open" if controller_name == "admin" %>>
        <summary><span class="nav-group-label">Admin</span></summary>
        <%= link_to "Users & Queues", aim_admin_path,
                    class: "nav-link#{' active' if current_page?(aim_admin_path)}" %>
      </details>
    <% end %>
  </nav>
</div>
