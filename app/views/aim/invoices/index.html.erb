<div class="aim-page">
  <header class="aim-page-header">
    <div>
      <h1 class="aim-page-title"><%= aim_queue_label(@queue) %></h1>
      <p class="aim-page-subtitle"><%= aim_queue_description(@queue) %></p>
    </div>

    <span class="aim-count-pill"><%= pluralize(@invoices.length, 'invoice') %></span>
  </header>

  <% if @queue == 'needs_review' && @reason_counts.present? %>
    <nav class="aim-reason-filters" aria-label="Filter by reason">
      <%= link_to "All (#{@reason_counts.values.sum})", aim_invoices_path(queue: @queue),
                  class: "btn compact#{@review_reason.blank? ? ' active' : ' ghost'}" %>
      <% @reason_counts.sort_by { |reason, _| reason.to_s }.each do |reason, count| %>
        <%= link_to "#{aim_review_reason_label(reason)} (#{count})", aim_invoices_path(queue: @queue, review_reason: reason),
                    class: "btn compact#{@review_reason == reason ? ' active' : ' ghost'}" %>
      <% end %>
    </nav>
  <% end %>

  <% if @invoices.empty? %>
    <section class="aim-panel aim-empty-state">
      <p>Nothing is in this queue.</p>
    </section>
  <% else %>
    <% if @groups %>
      <%# People's queues: one group per owner, collapsed until opened, with the count in the heading. %>
      <div data-controller="aim-move-modal">
      <% @groups.each do |owner, invoices| %>
        <details class="aim-owner-group">
          <summary>
            <span class="aim-owner-group__name"><%= owner == Aim::Invoice::SHARED_QUEUE ? 'Shared queue' : owner %></span>
            <span class="aim-count-pill"><%= pluralize(invoices.size, 'invoice') %></span>
          </summary>
          <section class="aim-panel aim-queue-panel">
            <%= render 'rows', invoices: invoices, movable: true %>
          </section>
        </details>
      <% end %>
      <%= render 'move_modal', choices: @move_choices %>
      </div>
    <% else %>
      <section class="aim-panel aim-queue-panel">
        <%= render 'rows', invoices: @invoices, movable: false %>
      </section>
    <% end %>
  <% end %>
</div>
