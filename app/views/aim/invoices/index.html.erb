<%= tag.div class: 'aim-page', data: aim_paged_list_data(aim_queue_filter_reason_value: params[:reason]) do %>
  <header class="aim-page-header">
    <div>
      <h1 class="aim-page-title"><%= aim_queue_label(@queue) %></h1>
      <p class="aim-page-subtitle"><%= aim_queue_description(@queue) %></p>
    </div>

    <div class="aim-page-header__pills">
      <%= render 'aim/shared/managing' %>
      <span class="aim-count-pill"><%= pluralize(@invoices.length, 'invoice') %></span>
    </div>
  </header>

  <% if @archive %>
    <%= render 'aim/shared/archive_search', url: aim_invoices_path, field: :queue, current: @queue, shown: @invoices.length,
                                            statuses: Aim::ArchiveSearch::QUEUES.map { |queue| [aim_queue_label(queue), queue] } %>
  <% end %>
  <%= render 'aim/invoices/search_box' %>

  <% if @queue == 'needs_review' && @reason_counts.present? %>
    <%# The reasons narrow the list in place (aim_queue_filter_controller#pickReason). %>
    <nav class="aim-reason-filters" aria-label="Filter by reason">
      <button type="button" class="btn compact active" data-reason="" data-aim-queue-filter-target="reason"
              data-action="aim-queue-filter#pickReason">All (<%= @reason_counts.values.sum %>)</button>
      <% @reason_counts.sort_by { |reason, _| reason.to_s }.each do |reason, count| %>
        <button type="button" class="btn compact ghost" data-reason="<%= reason %>" data-aim-queue-filter-target="reason"
                data-action="aim-queue-filter#pickReason"><%= aim_review_reason_label(reason) %> (<%= count %>)</button>
      <% end %>
    </nav>
  <% end %>

  <% if @invoices.empty? %>
    <section class="aim-panel aim-empty-state">
      <p><%= if @acknowledging then 'Nothing to acknowledge. Search older invoices finds the rest.'
             elsif @archive then @archive.nothing
             else 'Nothing is in this queue.'
             end %></p>
    </section>
  <% else %>
    <% if @sections %>
      <%# BU, then its shared queue and each person, then invoices: collapsed until opened. %>
      <div class="aim-list-frame" data-controller="aim-move-modal" data-aim-move-modal-bulk-url-value="<%= reassign_many_aim_invoices_path(queue: @queue) %>">
        <%= render 'aim/invoices/bulk_bar' %>
        <div class="aim-list-scroll" data-aim-queue-filter-target="scroll">
          <%= render 'aim/shared/bu_sections', sections: @sections, people_tools: false %>
        </div>
        <%= render 'aim/shared/list_pager' %>
        <%= render 'move_modal' %>
      </div>
    <% elsif @queue == 'received' %>
      <%# Waiting for AI (#192): hold invoices from the AI, release them, or take them from it. %>
      <div class="aim-list-frame" data-controller="aim-waiting">
        <%= form_with url: waiting_many_aim_invoices_path(queue: @queue), method: :patch, id: 'aim-waiting-form',
                      class: 'aim-bulk-bar aim-waiting-bar', data: { turbo: false } do %>
          <%= hidden_field_tag :bulk_action, '', id: nil %>
          <span class="aim-waiting-bar__count">Selected: <strong data-aim-waiting-target="count">0</strong></span>
          <% [['hold_ai', 'Hold', 'btn compact', 'Hold them in Waiting for AI? The AI leaves them until the hold is released, and stops any it is reading.'],
              ['release_hold', 'Release to the AI', 'btn approve compact', 'Take them off hold? The AI reads them next.'],
              ['skip_ai', 'Skip the AI', 'btn warning compact', 'The AI will not read them: to Action Needed, flagged Manual Data Entry Needed.']].each do |value, label, css, confirm| %>
            <button type="submit" value="<%= value %>" class="<%= css %>" disabled data-aim-waiting-target="button"
                    data-action="aim-waiting#submit" data-label="<%= label %>" data-confirm="<%= confirm %>"><%= label %></button>
          <% end %>
          <%# Reject and Delete ask why in a dialog, as on an invoice's page (aim_reason_controller). %>
          <span data-controller="aim-reason">
            <button type="button" class="btn deny compact" disabled data-aim-waiting-target="button" data-action="aim-reason#open"
                    data-value="reject" data-commit="Reject" data-title="Reject the selected invoices">Reject</button>
            <%= render 'aim/invoices/reject_modal', reasons: Aim::RejectReason.offered_for(aim_managing_group), name: 'bulk_action' %>
          </span>
          <span data-controller="aim-reason">
            <button type="button" class="btn deny compact" disabled data-aim-waiting-target="button" data-action="aim-reason#open"
                    data-value="delete" data-commit="Delete" data-title="Delete the selected invoices">Delete</button>
            <%= render 'aim/shared/reason_modal', id: 'aim-waiting-delete', name: 'bulk_action', value: 'delete', submit: 'Delete',
                                                  placeholder: 'Why delete them? Kept on each invoice.' %>
          </span>
        <% end %>
        <section class="aim-panel aim-queue-panel" data-aim-queue-filter-target="scroll">
          <%= render 'rows', invoices: @invoices, movable: false, waiting: true %>
        </section>
        <%= render 'aim/shared/list_pager' %>
      </div>
    <% elsif @acknowledging %>
      <%# Rejected and Deleted (#169): what nobody has acknowledged yet. %>
      <div class="aim-list-frame" data-controller="aim-acknowledge">
        <%= form_with url: acknowledge_aim_invoices_path(queue: @queue), method: :patch, id: 'aim-acknowledge-form',
                      class: 'aim-bulk-bar', data: { turbo: false } do %>
          <button type="submit" class="btn approve compact" disabled data-aim-acknowledge-target="button"><span>Acknowledge selected (<span data-aim-acknowledge-target="count">0</span>)</span></button>
        <% end %>
        <section class="aim-panel aim-queue-panel" data-aim-queue-filter-target="scroll">
          <%= render 'rows', invoices: @invoices, movable: false, acknowledging: true %>
        </section>
        <%= render 'aim/shared/list_pager' %>
      </div>
    <% else %>
      <div class="aim-list-frame">
        <section class="aim-panel aim-queue-panel" data-aim-queue-filter-target="scroll">
          <%= render 'rows', invoices: @invoices, movable: false %>
        </section>
        <%= render 'aim/shared/list_pager' %>
      </div>
    <% end %>
  <% end %>
<% end %>
