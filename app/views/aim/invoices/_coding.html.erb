<%# The invoice's coding (item b.2), inside the review form: the rules to
    choose from when several match, and the fields themselves, from the COA's
    lists, for a person to correct or type when no rule fits. %>
<section class="aim-coding">
  <h3>Coding</h3>
  <% if @coding_candidates.present? %>
    <p class="aim-coding__help">
      <%= pluralize(@coding_candidates.size, 'coding rule') %> for this vendor<%= @coding_level == :agency ? ' in other BUs; none is for this BU, so check the BDO' : ' in this BU' %>.
      <%= 'One is named on the invoice and is ticked.' if @coding_hinted.one? %> Pick one, or enter the coding below.
    </p>
    <ul class="aim-coding__choices">
      <% @coding_candidates.each do |rule| %>
        <li class="<%= 'is-hinted' if @coding_hinted.include?(rule) %>">
          <label>
            <%= radio_button_tag :coding_rule_id, rule.id, @coding_hinted.one? && @coding_hinted.include?(rule), disabled: @read_only %>
            <% @coding_differing.each do |field| %>
              <span class="aim-coding__choice-field"><small><%= aim_coding_field_label(field) %></small> <%= rule.public_send(field).presence || '—' %></span>
            <% end %>
            <% if @coding_hinted.include?(rule) %><span class="badge is-approved">on the invoice</span><% end %>
          </label>
        </li>
      <% end %>
    </ul>
    <% unless @read_only %>
      <%= submit_tag 'Use this coding', name: 'commit', class: 'btn approve compact', data: { turbo: false } %>
    <% end %>
  <% elsif @coding_lines.any? %>
    <% line = @coding_lines.first %>
    <p class="aim-coding__help">
      <%= { 'rule' => 'From the coding rules', 'person' => "Set by #{line.set_by}", 'fiscal' => "Set by Fiscal (#{line.set_by})" }[line.source] %><%= " (#{line.coding_rule.vendor_name}, #{line.coding_rule.encumbrance})" if line.coding_rule %>.
      <% if line.warnings.present? %><span class="badge is-denied" title="<%= line.warnings %>">unvalidated</span><% end %>
    </p>
  <% elsif @invoice.coded? %>
    <p class="aim-coding__help">No coding rule matches <%= @invoice.vendor_name.presence || 'this vendor' %> in <%= @invoice.budget_unit.presence || 'its BU' %>. Enter it here, or leave it for Fiscal.</p>
  <% else %>
    <p class="aim-coding__help">Looked up once the AI has read the invoice.</p>
  <% end %>
  <%= render 'aim/shared/coding_fields', line: @coding_line, coa: @coa, read_only: @read_only %>
</section>
