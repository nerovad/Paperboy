<%# The Batch Split review. Replaces editing the manifest by hand and dragging
    the folder onto the MOVE_FOLDERS_HERE_TO_SPLIT shortcut. Plan step 5.7c.
    The PDF editor's "New invoice starts here" fills the pages (#192,
    aim_split_editor_controller). %>
<section class="aim-split-editor" aria-labelledby="aim-split-heading" data-controller="aim-split-editor">
  <h3 id="aim-split-heading">Which pages are which invoice?</h3>
  <p class="aim-split-help">
    <% pages = " (#{pluralize(@split_page_count, 'page')})" if @split_page_count %>
    <%= @split_by_hand ? "This PDF#{pages} holds more than one invoice." : "The AI thinks this PDF#{pages} holds more than one invoice." %>
    Click the page each invoice starts on and press <strong>New invoice starts here</strong>, or type pages like
    <code>1-3, 5</code>. Every page belongs to one invoice; clear a row to drop it.
  </p>

  <% if @split_plan&.errors.present? %>
    <div class="aim-split-errors" role="alert">
      <ul>
        <% @split_plan.errors.each do |error| %>
          <li><%= error %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p class="aim-split-pending" role="status" hidden data-aim-split-editor-target="pending">
    Edit PDF has changes not yet applied. The split cuts the PDF as applied, so press <strong>Apply changes</strong>
    before approving it; the pages above are numbered as they will be then.
  </p>

  <table class="aim-split-table">
    <thead>
      <tr>
        <th scope="col">#</th>
        <th scope="col">Vendor</th>
        <th scope="col">Invoice #</th>
        <th scope="col">Pages</th>
      </tr>
    </thead>
    <tbody data-aim-split-editor-target="rows">
      <% rows = @split_rows.to_a + Array.new(2) { Aim::SplitPlan::Row.new } %>
      <% rows.each_with_index do |row, index| %>
        <tr>
          <td><%= index + 1 %></td>
          <td>
            <%= text_field_tag "split[#{index}][vendor_name]", row.vendor_name,
                               disabled: @read_only, aria: { label: "Invoice #{index + 1} vendor" } %>
          </td>
          <td>
            <%= text_field_tag "split[#{index}][invoice_number]", row.invoice_number,
                               disabled: @read_only, aria: { label: "Invoice #{index + 1} invoice number" } %>
          </td>
          <td>
            <%= text_field_tag "split[#{index}][pages_text]", row.pages_text,
                               placeholder: 'e.g. 1-3, 5', disabled: @read_only, data: { aim_split_editor_target: 'pages' },
                               aria: { label: "Invoice #{index + 1} pages" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% unless @read_only %>
    <button type="button" class="btn compact aim-split-add" data-action="aim-split-editor#addRow">+ Add an invoice</button>
  <% end %>
</section>
