<%# Move several invoices at once: tick them, then Move selected. %>
<div class="aim-bulk-bar">
  <button type="button" class="btn reassign compact" disabled
          data-aim-move-modal-target="bulkButton" data-action="aim-move-modal#openMany">
    Move selected (<span data-aim-move-modal-target="bulkCount">0</span>)
  </button>
</div>
