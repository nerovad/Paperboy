<%# Asks why before Reject, Delete or Send Back. It sits inside the review
    form, so the reason and the action are posted with the form itself
    (aim_reason_controller sets which action). The reason goes into the
    invoice's Notes and its history. %>
<div class="pb-modal-backdrop" data-aim-reason-target="backdrop" hidden>
  <div class="pb-modal" role="dialog" aria-modal="true" aria-labelledby="aim-reason-title">
    <div class="pb-modal__header">
      <h3 id="aim-reason-title" data-aim-reason-target="title">Why?</h3>
      <button type="button" class="pb-modal__close" data-action="aim-reason#close" aria-label="Close">✕</button>
    </div>
    <div class="pb-modal__body">
      <div class="form-group">
        <label for="aim-reason-text">Reason</label>
        <textarea id="aim-reason-text" name="reason" class="form-control" rows="3"
                  placeholder="Briefly explain why" data-aim-reason-target="reason" disabled></textarea>
      </div>
      <div class="pb-modal__actions">
        <button type="button" class="btn" data-action="aim-reason#close">Cancel</button>
        <button type="submit" name="commit" class="btn deny" data-aim-reason-target="submit">Confirm</button>
      </div>
    </div>
  </div>
</div>
