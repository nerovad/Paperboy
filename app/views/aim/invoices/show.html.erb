<div class="aim-page">
  <header class="aim-page-header">
    <div>
      <%= link_to 'Back to Queue', aim_invoices_path(queue: @queue), class: 'aim-kicker' %>
      <h1 class="aim-page-title"><%= @invoice_id %></h1>
      <p class="aim-page-subtitle"><%= aim_queue_label(@queue) %> review</p>
    </div>
  </header>

  <div class="aim-document-layout">
    <section class="aim-panel aim-document-panel">
      <div class="aim-panel-header">
        <h2 class="aim-panel-title">Document Preview</h2>
      </div>

      <div class="aim-pdf-shell" data-pdf-url="<%= pdf_aim_invoice_path(@invoice_id, queue: @queue) %>">
        <iframe class="aim-pdf-frame"
                src="<%= pdf_aim_invoice_path(@invoice_id, queue: @queue) %>"
                title="Invoice PDF preview"></iframe>

        <div id="aim-ocr-canvas-viewer" class="aim-pdf-canvas-viewer">
          <div id="loading-indicator" class="aim-ocr-status">Loading OCR pages...</div>
        </div>
      </div>
    </section>

    <%= form_with url: aim_invoice_path(@invoice_id, queue: @queue),
                  method: :patch,
                  local: true,
                  class: 'aim-panel aim-metadata-form' do |form| %>
      <div class="aim-panel-header">
        <h2 class="aim-panel-title">Metadata Extraction</h2>
      </div>

      <div class="aim-form-scroll">
        <% if ['action_needed', 'low_confidence_review'].include?(@queue) && @ticket_content.present? %>
          <section class="aim-ticket">
            <h3>AI Failure Ticket</h3>
            <pre><%= @ticket_content %></pre>
          </section>
        <% end %>

        <div class="aim-fields">
          <% fields = @metadata.keys.any? ? @metadata.keys : ['BU', 'Submitter', 'VendorName', 'InvoiceTotal', 'InvoiceNumber', 'InvoiceDate', 'Status'] %>
          <% excluded_fields = ['BoundingBoxes', 'ConfidenceScores', 'OriginalText'] %>
          <% excluded_fields << 'NormalizedVendor' if @queue == 'vendor_review' %>

          <% fields.each do |key| %>
            <% next if excluded_fields.include?(key) %>

            <div class="aim-field-row">
              <div class="aim-field">
                <%= form.label "metadata[#{key}]", aim_metadata_label(key) %>

                <% if @metadata[key].is_a?(Array) && key == 'Invoices' %>
                  <div class="aim-split-summary">
                    <p>AI Suggested Splits</p>
                    <ul>
                      <% @metadata[key].each_with_index do |split, index| %>
                        <li>
                          <strong>Invoice <%= index + 1 %>:</strong>
                          Pages <%= Array(split['pages']).join(', ') %>
                          <br>
                          <span>Vendor: <%= split['vendor_name'] || 'Unknown' %>, Invoice: <%= split['invoice_number'] || 'N/A' %></span>
                        </li>
                      <% end %>
                    </ul>
                    <div class="aim-review-note">Visual splitting will be added in the next AIM integration phase.</div>
                  </div>
                <% else %>
                  <%= form.text_field "metadata[#{key}]",
                                      value: (@metadata[key].is_a?(Hash) || @metadata[key].is_a?(Array) ? @metadata[key].to_json : @metadata[key]) %>
                <% end %>
              </div>

              <% unless @metadata[key].is_a?(Array) && key == 'Invoices' %>
                <button type="button"
                        class="btn secondary compact btn-ocr"
                        data-ocr-target-name="metadata[<%= key %>]">OCR</button>
              <% end %>
            </div>
          <% end %>

          <% if @queue == 'vendor_review' %>
            <% selected_vendor_name = @metadata['NormalizedVendor'].presence %>
            <% official_vendor_options = @official_vendor_names.to_a.compact %>
            <% if selected_vendor_name.present? && official_vendor_options.exclude?(selected_vendor_name) %>
              <% official_vendor_options << selected_vendor_name %>
            <% end %>
            <% official_vendor_option_tags = [['Select official vendor', '']] %>
            <% official_vendor_options.each do |vendor_name| %>
              <% official_vendor_option_tags << [vendor_name, vendor_name] %>
            <% end %>

            <section class="aim-vendor-review">
              <div class="aim-vendor-review-fields">
                <div class="aim-field">
                  <%= form.label 'metadata[NormalizedVendor]', 'Match to Official Vendor Name' %>
                  <%= select_tag(
                    'metadata[NormalizedVendor]',
                    options_for_select(official_vendor_option_tags, selected_vendor_name),
                    id: 'aim-official-vendor-select',
                    class: 'aim-vendor-select',
                    data: { aim_vendor_select: true }
                  ) %>
                </div>

                <div class="aim-field-row">
                  <div class="aim-field">
                    <%= label_tag 'normalized_vendor_new', 'New Official Vendor Name' %>
                    <%= text_field_tag 'normalized_vendor_new',
                                       nil,
                                       autocomplete: 'off',
                                       placeholder: 'Type only when adding a new official vendor' %>
                  </div>

                  <button type="button"
                          class="btn secondary compact btn-ocr"
                          data-ocr-target-name="normalized_vendor_new">OCR</button>
                </div>

                <div class="aim-vendor-alias-preview">
                  <span><%= @metadata['VendorName'].presence || 'Unknown vendor' %></span>
                  <span>maps to</span>
                  <span>the selected or new official vendor</span>
                </div>
              </div>
            </section>
          <% end %>
        </div>
      </div>

      <div class="aim-form-actions">
        <div class="aim-action-group">
          <%= form.submit 'Unclaim', class: 'btn ghost' %>
        </div>

        <div class="aim-action-group">
          <%= form.submit 'Save Changes', class: 'btn secondary' %>

          <% if @queue == 'action_needed' %>
            <%= form.submit 'Reject',
                            data: { turbo_confirm: 'Reject this invoice and send it to the rejected folder?' },
                            class: 'btn deny' %>
            <%= form.submit 'Send to Approval',
                            data: { turbo_confirm: 'Route this invoice to User Approval?' },
                            class: 'btn approve' %>
          <% elsif @queue == 'low_confidence_review' %>
            <%= form.submit 'Reject',
                            data: { turbo_confirm: 'Reject this invoice and send it to the rejected folder?' },
                            class: 'btn deny' %>
            <%= form.submit 'Send to SQL Queue',
                            data: { turbo_confirm: 'Save these XML index fields and send this folder to the SQL queue?' },
                            class: 'btn approve' %>
          <% elsif @queue == 'vendor_review' %>
            <%= form.submit 'Learn Alias',
                            data: { turbo_confirm: 'Send this vendor alias to the learner queue?' },
                            class: 'btn warning' %>
          <% end %>

          <%= link_to 'Retry AI Processing',
                      retry_aim_invoice_path(@invoice_id, queue: @queue),
                      data: {
                        turbo_method: :post,
                        turbo_confirm: 'Send this original document back to the Reprocess Queue?'
                      },
                      class: 'btn warning' %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

<script>
  (function() {
    if (window.pdfjsLib) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
    }

    function initAimPdfReview() {
      const shell = document.querySelector(".aim-pdf-shell");
      if (!shell || shell.dataset.initialized === "true") return;
      shell.dataset.initialized = "true";

      const pdfUrl = shell.dataset.pdfUrl;
      const frame = shell.querySelector(".aim-pdf-frame");
      const canvasViewer = document.getElementById("aim-ocr-canvas-viewer");
      const loadingIndicator = document.getElementById("loading-indicator");
      let activeOcrTargetName = null;
      let activeOcrButton = null;
      let pdfDocument = null;
      let isRendered = false;

      function showNativeViewer() {
        frame.classList.remove("is-hidden");
        canvasViewer.classList.remove("is-active", "ocr-mode");
      }

      function showOcrViewer() {
        frame.classList.add("is-hidden");
        canvasViewer.classList.add("is-active");
      }

      async function ensurePdfRendered() {
        showOcrViewer();
        if (isRendered) return;

        pdfDocument = await pdfjsLib.getDocument(pdfUrl).promise;
        if (loadingIndicator) loadingIndicator.remove();
        canvasViewer.querySelectorAll(".aim-pdf-page").forEach((element) => element.remove());

        for (let pageNumber = 1; pageNumber <= pdfDocument.numPages; pageNumber += 1) {
          const page = await pdfDocument.getPage(pageNumber);
          const pageElement = document.createElement("div");
          pageElement.className = "aim-pdf-page";

          const canvas = document.createElement("canvas");
          const context = canvas.getContext("2d");
          const viewport = page.getViewport({ scale: 1.25 });

          canvas.height = viewport.height;
          canvas.width = viewport.width;

          pageElement.appendChild(canvas);
          canvasViewer.appendChild(pageElement);

          await page.render({ canvasContext: context, viewport: viewport }).promise;
          setupOcrDrawing(pageElement, canvas);
        }

        isRendered = true;
      }

      function deactivateOcrMode() {
        if (activeOcrButton) {
          activeOcrButton.classList.remove("active-ocr");
          activeOcrButton.innerText = "OCR";
        }

        activeOcrTargetName = null;
        activeOcrButton = null;
        canvasViewer.classList.remove("ocr-mode");
        showNativeViewer();
      }

      async function activateOcrMode(targetName, button) {
        if (activeOcrButton) {
          activeOcrButton.classList.remove("active-ocr");
          activeOcrButton.innerText = "OCR";
        }

        activeOcrTargetName = targetName;
        activeOcrButton = button;
        button.classList.add("active-ocr");
        button.innerText = "Cancel";

        await ensurePdfRendered();
        canvasViewer.classList.add("ocr-mode");
      }

      function setupOcrDrawing(pageElement, canvas) {
        let isDrawing = false;
        let startX = 0;
        let startY = 0;
        let selectionBox = null;

        pageElement.addEventListener("mousedown", (event) => {
          if (!activeOcrTargetName) return;

          isDrawing = true;
          const rect = pageElement.getBoundingClientRect();
          startX = event.clientX - rect.left;
          startY = event.clientY - rect.top;

          selectionBox = document.createElement("div");
          selectionBox.className = "aim-ocr-selection";
          selectionBox.style.left = startX + "px";
          selectionBox.style.top = startY + "px";
          pageElement.appendChild(selectionBox);
        });

        pageElement.addEventListener("mousemove", (event) => {
          if (!isDrawing || !selectionBox) return;

          const rect = pageElement.getBoundingClientRect();
          const currentX = event.clientX - rect.left;
          const currentY = event.clientY - rect.top;
          const left = Math.min(startX, currentX);
          const top = Math.min(startY, currentY);
          const width = Math.abs(startX - currentX);
          const height = Math.abs(startY - currentY);

          selectionBox.style.left = left + "px";
          selectionBox.style.top = top + "px";
          selectionBox.style.width = width + "px";
          selectionBox.style.height = height + "px";
        });

        pageElement.addEventListener("mouseup", (event) => {
          if (!isDrawing) return;
          isDrawing = false;

          const rect = pageElement.getBoundingClientRect();
          const endX = event.clientX - rect.left;
          const endY = event.clientY - rect.top;
          const x = Math.min(startX, endX);
          const y = Math.min(startY, endY);
          const width = Math.abs(startX - endX);
          const height = Math.abs(startY - endY);

          if (selectionBox) selectionBox.remove();
          selectionBox = null;

          if (width > 5 && height > 5) {
            performOcrOnArea(canvas, pageElement, x, y, width, height);
          }
        });
      }

      async function performOcrOnArea(canvas, pageElement, x, y, width, height) {
        const targetName = activeOcrTargetName;
        const inputElement = document.getElementsByName(targetName)[0];

        if (!inputElement) {
          deactivateOcrMode();
          return;
        }

        const scaleX = canvas.width / pageElement.clientWidth;
        const scaleY = canvas.height / pageElement.clientHeight;
        const tempCanvas = document.createElement("canvas");

        tempCanvas.width = width * scaleX;
        tempCanvas.height = height * scaleY;
        tempCanvas
          .getContext("2d")
          .drawImage(canvas, x * scaleX, y * scaleY, tempCanvas.width, tempCanvas.height, 0, 0, tempCanvas.width, tempCanvas.height);

        try {
          const result = await Tesseract.recognize(tempCanvas.toDataURL("image/png"), "eng");
          inputElement.value = result.data.text.trim();
          inputElement.dispatchEvent(new Event("input", { bubbles: true }));
          inputElement.dispatchEvent(new Event("change", { bubbles: true }));
        } catch (error) {
          console.error("Tesseract OCR failed:", error);
        }

        deactivateOcrMode();
      }

      document.querySelectorAll(".btn-ocr").forEach((button) => {
        button.addEventListener("click", async (event) => {
          event.preventDefault();
          const targetName = button.getAttribute("data-ocr-target-name");

          if (activeOcrTargetName === targetName) {
            deactivateOcrMode();
          } else {
            await activateOcrMode(targetName, button);
          }
        });
      });
    }

    document.addEventListener("turbo:load", initAimPdfReview);
    if (document.readyState === "interactive" || document.readyState === "complete") {
      initAimPdfReview();
    }
  })();
</script>
