<%# The review page, over the row. AIM v2: the fields are the invoice's
    columns, the PDF is read from the store, and every button is a move of
    the row's state. %>
<% state = @invoice.state %>
<% viewer_email = session.dig(:user, 'email') || session.dig('user', 'email') %>
<div class="aim-page aim-review-page"
     data-controller="aim-ocr"
     data-aim-ocr-pdf-url-value="<%= pdf_aim_invoice_path(@invoice.batch_id, queue: @queue) %>">
  <header class="aim-page-header">
    <div class="aim-review-heading">
      <%= link_to 'Back to Queue', aim_invoices_path(queue: @queue), class: 'aim-kicker' %>
      <h1 class="aim-page-title"><%= @invoice.batch_id %></h1>
      <span class="aim-page-subtitle"><%= aim_state_label(state) %></span>
      <% if @invoice.review_reason.present? %>
        <span class="badge is-denied"><%= aim_review_reason_label(@invoice.review_reason) %></span>
      <% end %>
    </div>
  </header>

  <% if @read_only %>
    <div class="aim-readonly-banner" role="alert">
      <span class="aim-readonly-banner__mark" aria-hidden="true">!</span>
      <div>
        <strong>Read only — changes to this invoice cannot be saved.</strong>
        <% if @claimed_by_other %>
          <p><%= @claim_holder %> claimed this invoice and is reviewing it now. Review actions are hidden until it is unclaimed.</p>
        <% else %>
          <p>This invoice is finished (<%= aim_state_label(state).downcase %>) and cannot be changed.</p>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="aim-document-layout">
    <section class="aim-panel aim-document-panel">
      <div class="aim-panel-header">
        <h2 class="aim-panel-title">Document Preview</h2>
      </div>

      <% if @pdf_present %>
        <div class="aim-pdf-shell" data-pdf-url="<%= pdf_aim_invoice_path(@invoice.batch_id, queue: @queue) %>">
          <iframe class="aim-pdf-frame"
                  src="<%= "#{pdf_aim_invoice_path(@invoice.batch_id, queue: @queue)}#zoom=page-fit" %>"
                  title="Invoice PDF preview"></iframe>

          <div id="aim-ocr-canvas-viewer" class="aim-pdf-canvas-viewer">
            <div id="loading-indicator" class="aim-ocr-status">Loading OCR pages...</div>
          </div>
        </div>
      <% else %>
        <div class="aim-empty-state">
          <p>The PDF is not in the store.</p>
        </div>
      <% end %>
    </section>

    <%= form_with url: aim_invoice_path(@invoice.batch_id, queue: @queue),
                  method: :patch,
                  local: true,
                  class: 'aim-panel aim-metadata-form' do |form| %>
      <div class="aim-panel-header">
        <h2 class="aim-panel-title">Invoice</h2>
      </div>

      <div class="aim-form-scroll">
        <% if @invoice.review_note.present? %>
          <section class="aim-ticket">
            <h3><%= aim_review_reason_label(@invoice.review_reason.presence || 'note') %></h3>
            <pre><%= @invoice.review_note %></pre>
          </section>
        <% end %>

        <div class="aim-fields">
          <% if state == 'needs_split' %>
            <%= render 'aim/invoices/split_editor' %>
          <% else %>
            <% if @invoice.extracted_vendor_name.present? %>
              <div class="aim-field-row">
                <div class="aim-field">
                  <%= label_tag 'aim_extracted_vendor_name', aim_field_label('extracted_vendor_name') %>
                  <%= text_field_tag 'aim_extracted_vendor_name', @invoice.extracted_vendor_name,
                                     readonly: true, class: 'aim-readonly-field' %>
                </div>
              </div>
            <% end %>

            <% Aim::Invoice::EDITABLE_FIELDS.each do |field| %>
              <div class="aim-field-row">
                <div class="aim-field">
                  <%= form.label "invoice[#{field}]", aim_field_label(field) %>
                  <% if field == 'document_type' %>
                    <%= form.select "invoice[#{field}]",
                                    options_for_select(Aim::Invoice::DOCUMENT_TYPES, @invoice.document_type),
                                    { include_blank: 'Not set' }, disabled: @read_only %>
                  <% elsif field == 'notes' %>
                    <%= form.text_area "invoice[#{field}]", value: @invoice.notes, rows: 3, disabled: @read_only %>
                  <% else %>
                    <%= form.text_field "invoice[#{field}]",
                                        value: @invoice.public_send(field),
                                        disabled: @read_only %>
                  <% end %>
                </div>
                <% unless @read_only || %w[document_type notes].include?(field) %>
                  <button type="button"
                          class="btn secondary compact btn-ocr"
                          data-ocr-target-name="invoice[<%= field %>]">OCR</button>
                <% end %>
              </div>
            <% end %>

            <% if @invoice.review_reason == 'unknown_vendor' && !@read_only %>
              <section class="aim-vendor-review">
                <div class="aim-vendor-review-fields">
                  <div class="aim-field">
                    <%= label_tag 'normalized_vendor', 'Match to Official Vendor Name' %>
                    <%= select_tag 'normalized_vendor',
                                   options_for_select([['Select official vendor', '']] + @official_vendor_names.map { |name| [name, name] }, @invoice.vendor_name),
                                   id: 'aim-official-vendor-select', class: 'aim-vendor-select' %>
                  </div>
                  <div class="aim-field-row">
                    <div class="aim-field">
                      <%= label_tag 'normalized_vendor_new', 'New Official Vendor Name' %>
                      <%= text_field_tag 'normalized_vendor_new', nil, autocomplete: 'off',
                                         placeholder: 'Type only when adding a new official vendor' %>
                    </div>
                    <button type="button" class="btn secondary compact btn-ocr" data-ocr-target-name="normalized_vendor_new">OCR</button>
                  </div>
                  <div class="aim-vendor-alias-preview">
                    <span><%= @invoice.extracted_vendor_name.presence || 'Unknown vendor' %></span>
                    <span>maps to</span>
                    <span>the selected or new official vendor</span>
                  </div>
                </div>
              </section>
            <% end %>
          <% end %>
        </div>

        <% if @events.present? %>
          <section class="aim-ticket aim-history">
            <h3>History</h3>
            <ul>
              <% @events.each do |event| %>
                <li>
                  <%= event.created_at.strftime('%m/%d/%y %H:%M') %>
                  <%= event.from_state.present? ? "#{aim_state_label(event.from_state)} → " : '' %><%= aim_state_label(event.to_state) %>
                  by <%= event.actor %><%= " — #{event.note}" if event.note.present? %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>

      <div class="aim-form-actions">
        <% if @read_only %>
          <div class="aim-action-group">
            <%= link_to 'Return to Queue', aim_invoices_path(queue: @queue), class: 'btn' %>
          </div>
        <% else %>
          <div class="aim-action-group aim-review-action-strip">
            <%= form.submit 'Unclaim', class: 'btn ghost' %>
            <% unless state == 'needs_split' %>
              <%= form.submit 'Save Changes', class: 'btn secondary' %>
            <% end %>

            <% if state == 'needs_review' %>
              <% if @invoice.review_reason == 'unknown_vendor' %>
                <%= form.submit 'Learn & Retry AI',
                                data: { turbo_confirm: 'Save this alias and send the document back through AI extraction?' },
                                class: 'btn warning' %>
                <%= form.submit 'Learn & Send to Approval',
                                data: { turbo_confirm: 'Save this alias and send the invoice for approval?' },
                                class: 'btn approve' %>
              <% end %>
              <%= form.submit 'Send to Approval',
                              data: { turbo_confirm: 'Send this invoice to its owner for approval?' },
                              class: 'btn approve' %>
              <%= form.submit 'Approve',
                              data: { turbo_confirm: 'Approve this invoice now and send it to billing and Laserfiche?' },
                              class: 'btn approve' %>
              <%= form.submit 'Retry AI',
                              data: { turbo_confirm: 'Send this document back through AI extraction?' },
                              class: 'btn warning' %>
            <% elsif state == 'ready_for_approval' %>
              <%= form.submit 'Approve',
                              data: { turbo_confirm: 'Approve this invoice and send it to billing and Laserfiche?' },
                              class: 'btn approve' %>
              <%= form.submit 'Send Back',
                              data: { turbo_confirm: 'Send this invoice back to AIM review?' },
                              class: 'btn warning' %>
            <% elsif state == 'needs_split' %>
              <%= form.submit 'Approve Split',
                              data: {
                                turbo_confirm: 'Split this PDF into the invoices above? Each goes through extraction on its own.',
                                confirm_title: 'Approve split',
                                confirm_label: 'Approve Split'
                              },
                              class: 'btn approve' %>
              <%= form.submit 'Process as One Invoice',
                              data: {
                                turbo_confirm: 'Treat this PDF as a single invoice and send it through extraction without splitting?',
                                confirm_title: 'Process as one invoice',
                                confirm_label: 'Process as One'
                              },
                              class: 'btn warning' %>
            <% elsif state == 'failed' %>
              <%= form.submit 'Retry AI',
                              data: { turbo_confirm: 'Send this document back through AI extraction?' },
                              class: 'btn warning' %>
              <%= form.submit 'Retry Export',
                              data: { turbo_confirm: 'Try the export to billing and Laserfiche again?' },
                              class: 'btn approve' %>
            <% end %>

            <% if @invoice.can_move_to?('rejected') %>
              <%= form.submit 'Reject',
                              data: { turbo_confirm: 'Reject this invoice and put a copy in the rejected folder for the submitter?',
                                      confirm_title: 'Reject invoice', confirm_label: 'Reject' },
                              class: 'btn deny' %>
            <% end %>
            <% if @invoice.can_move_to?('deleted') %>
              <%= form.submit 'Delete',
                              data: { turbo_confirm: 'Delete this invoice? A copy is kept in the deleted folder.',
                                      confirm_title: 'Delete invoice', confirm_label: 'Delete' },
                              class: 'btn deny' %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
