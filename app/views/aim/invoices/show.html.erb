<%# The review page, over the row. AIM v2: the fields are the invoice's
    columns, the PDF is read from the store, and every button is a move of
    the row's state. %>
<% state = @invoice.state %>
<% viewer_email = session.dig(:user, 'email') || session.dig('user', 'email') %>
<%# While you work the invoice, the page keeps its working lock (aim-presence). %>
<div class="aim-page aim-review-page"
     data-controller="aim-ocr<%= ' aim-presence' unless @read_only %>"
     data-aim-ocr-pdf-url-value="<%= pdf_aim_invoice_path(@invoice.batch_id, queue: @queue) %>"
     <% unless @read_only %>
       data-aim-presence-lock-url-value="<%= lock_aim_invoice_path(@invoice.batch_id, queue: @queue) %>"
       data-aim-presence-unlock-url-value="<%= unlock_aim_invoice_path(@invoice.batch_id, queue: @queue) %>"
     <% end %>>
  <%# The notices (#160): built first, so the header can show a chip for
      each; their panels drop down from the header over the page, so the PDF
      keeps its height (aim_notices_controller). %>
  <% notices = capture do %>
  <%# Duplicates (#131, #160): the possible duplicate beside its original, and
      either end of a replacement. %>
  <%= render 'duplicate_banner' if @invoice.duplicate_of %>
  <% if @invoice.replaces %>
    <div class="aim-readonly-banner aim-notice-panel aim-manual-banner" role="status" id="<%= aim_notice_id('Replacement') %>" hidden
         data-aim-notices-target="panel">
      <span class="aim-readonly-banner__mark" aria-hidden="true">↻</span>
      <div><%= aim_notice_heading('Replacement', mark: '↻', tone: :info) %><p>Replaces <%= link_to @invoice.replaces.batch_id, aim_invoice_path(@invoice.replaces.batch_id) %>.</p></div>
    </div>
  <% end %>
  <% if (newer = @invoice.replaced_by) %>
    <div class="aim-readonly-banner aim-notice-panel aim-manual-banner" role="status" id="<%= aim_notice_id('Replaced') %>" hidden
         data-aim-notices-target="panel">
      <span class="aim-readonly-banner__mark" aria-hidden="true">↻</span>
      <div><%= aim_notice_heading('Replaced', mark: '↻', tone: :info) %><p>Replaced by <%= link_to newer.batch_id, aim_invoice_path(newer.batch_id) %>.</p></div>
    </div>
  <% end %>
  <% if @invoice.awaiting_second_approval? %>
    <%# The high-dollar second approval (#131). %>
    <div class="aim-readonly-banner aim-notice-panel aim-manual-banner" role="status" id="<%= aim_notice_id('Second approval') %>" hidden
         data-aim-notices-target="panel">
      <span class="aim-readonly-banner__mark" aria-hidden="true">2</span>
      <div>
        <%= aim_notice_heading('Second approval', mark: '2', tone: :info) %>
        <p>
          First approved by <%= Aim::FiscalExport.approver_names([@invoice.first_approved_by]).fetch(@invoice.first_approved_by.downcase, @invoice.first_approved_by) %>
          on <%= @invoice.first_approved_at.in_time_zone.strftime('%m/%d/%Y %H:%M') %>. Over the BU's amount, so it waits for
          <%= @invoice.second_approval_setting&.second_approver_name || 'its second approver' %>.
        </p>
      </div>
    </div>
  <% end %>
  <% if @invoice.manual_entry %>
    <%# Manual Data Entry Needed (#131): typed in by hand, not by the AI. %>
    <div class="aim-readonly-banner aim-notice-panel aim-manual-banner" role="status" id="<%= aim_notice_id('Manual Data Entry Needed') %>" hidden
         data-aim-notices-target="panel">
      <span class="aim-readonly-banner__mark" aria-hidden="true">✎</span>
      <div>
        <%= aim_notice_heading('Manual Data Entry Needed', mark: '✎', tone: :info) %>
        <p>The AI has not read this invoice. Type the details in from the PDF and save<%= "; still needed: #{@invoice.missing_for_a_user.to_sentence}" unless @invoice.ready_for_a_user? %>.</p>
      </div>
    </div>
  <% end %>

  <%# Sent back (#160): a person sent it back for review, saying why. %>
  <% if state == 'needs_review' && @invoice.review_reason == 'sent_back' %>
    <% who, sent_at = aim_sent_back_by(@invoice) %>
    <div class="aim-readonly-banner aim-notice-panel" role="alert" id="<%= aim_notice_id('Sent back') %>" hidden
         data-aim-notices-target="panel">
      <span class="aim-readonly-banner__mark" aria-hidden="true">↩</span>
      <div>
        <%= aim_notice_heading('Sent back', mark: '↩', tone: :alert) %>
        <p>
          <% if who %>By <%= who %>, <%= sent_at.strftime('%m/%d/%Y %-I:%M %p') %>: <% end %>
          <%= @invoice.review_note.presence || 'no reason given' %>
        </p>
      </div>
    </div>
  <% end %>

  <% if @read_only %>
    <div class="aim-readonly-banner aim-notice-panel" role="alert" id="<%= aim_notice_id('Read only') %>" hidden
         data-aim-notices-target="panel">
      <span class="aim-readonly-banner__mark" aria-hidden="true">!</span>
      <div>
        <%= aim_notice_heading('Read only', mark: '!', tone: :alert) %>
        <% if @claimed_by_other %>
          <p><%= @claim_holder %> is working on this invoice. You can view it, but not change it until they are done.</p>
        <% elsif @invoice.terminal? %>
          <p>This invoice is finished (<%= aim_state_label(state).downcase %>) and cannot be changed.
            <% if @invoice.acknowledged_at %>Acknowledged by <%= @invoice.acknowledged_by %> on <%= l(@invoice.acknowledged_at.to_date, format: :long) %>.<% end %></p>
        <% else %>
          <p>This invoice is in <%= aim_owner_label(@invoice.assigned_to.presence || "#{@invoice.budget_unit} shared") %>.
             <%= 'Claim it to move it to your queue and work it.' if @claimable %></p>
        <% end %>
      </div>
      <%# A notice's buttons sit at its right, as on every notice (#160). %>
      <% restore = @invoice.restorable? && aim_queue_access? %>
      <% claim = @claimable && !@claimed_by_other %>
      <% acknowledge = @invoice.acknowledgeable? && aim_queue_access? %>
      <% if restore || claim || acknowledge %>
        <div class="aim-readonly-banner__actions">
          <% if acknowledge %>
            <%# Seen, and fine: off the Rejected or Deleted list for everyone (#169). %>
            <%= button_to 'Acknowledge', acknowledge_aim_invoices_path(queue: @queue), method: :patch,
                          params: { 'ids[]' => @invoice.batch_id }, class: 'btn compact', form: { data: { turbo: false } },
                          title: 'Seen, and fine: take it off the list' %>
          <% end %>
          <% if restore %>
            <%= form_with url: restore_aim_invoice_path(@invoice.batch_id, queue: @queue), method: :post, local: true,
                          class: 'aim-restore-form', data: { controller: 'aim-reason', turbo: false } do %>
              <button type="button" class="btn take-back compact" data-action="aim-reason#open" data-variant="approve"
                      data-value="restore_to_needs_review" data-commit="Restore to Action Needed" data-title="Restore to Action Needed">Restore to Action Needed</button>
              <button type="button" class="btn take-back compact" data-action="aim-reason#open" data-variant="approve"
                      data-value="restore_to_ready_for_approval" data-commit="Restore to Ready for Approval" data-title="Restore to Ready for Approval">Restore to Ready for Approval</button>
              <%= render 'aim/shared/reason_modal', id: 'aim-restore' %>
            <% end %>
          <% end %>
          <% if claim %>
            <%= button_to 'Claim', claim_aim_invoice_path(@invoice.batch_id, queue: @queue), method: :post,
                          class: 'btn take-back compact',
                          data: { turbo: false, turbo_confirm: 'Move this invoice to your queue?' } %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <% end %>
  <header class="aim-page-header aim-review-header" data-controller="aim-notices">
    <div class="aim-review-heading">
      <%= link_to 'Back to Queue', queue_return_path, class: 'aim-kicker' %>
      <h1 class="aim-page-title"><%= @invoice.batch_id %></h1>
      <span class="aim-page-subtitle"><%= aim_state_label(state) %></span>
      <%# A reason with a notice of its own shows as that notice's chip. %>
      <% if state == 'needs_review' && @invoice.review_reason.present? && !%w[duplicate sent_back].include?(@invoice.review_reason) %>
        <span class="badge is-denied"><%= aim_review_reason_label(@invoice.review_reason) %></span>
      <% end %>
      <%= render 'aim/shared/notice_chips' %>
      <%# Working a shared-queue invoice locks it only while you are in it; Claim moves it to your queue. %>
      <% if @claimable && !@read_only %>
        <%= button_to 'Claim', claim_aim_invoice_path(@invoice.batch_id, queue: @queue), method: :post,
                      class: 'btn take-back compact', form_class: 'aim-claim-form',
                      data: { turbo: false, turbo_confirm: 'Move this invoice to your queue?' } %>
      <% end %>
    </div>
    <div class="aim-notice-tray"><%= notices %></div>
  </header>

  <div class="aim-document-layout">
    <section class="aim-panel aim-document-panel">
      <div class="aim-panel-header">
        <h2 class="aim-panel-title">Document Preview</h2>
      </div>

      <% if @pdf_present %>
        <div class="aim-pdf-shell" data-pdf-url="<%= pdf_aim_invoice_path(@invoice.batch_id, queue: @queue) %>">
          <iframe class="aim-pdf-frame"
                  src="<%= "#{pdf_aim_invoice_path(@invoice.batch_id, queue: @queue)}#zoom=page-fit" %>"
                  title="Invoice PDF preview"></iframe>

          <div id="aim-ocr-canvas-viewer" class="aim-pdf-canvas-viewer">
            <div id="loading-indicator" class="aim-ocr-status">Loading OCR pages...</div>
          </div>
        </div>
      <% else %>
        <div class="aim-empty-state">
          <p>The PDF is not in the store.</p>
        </div>
      <% end %>
    </section>

    <%# Save Changes redraws this panel alone, so the PDF keeps its place;
        every other button leaves the frame for the whole page. %>
    <%= turbo_frame_tag 'aim-review-panel', target: '_top', class: 'aim-review-frame' do %>
    <%= form_with url: aim_invoice_path(@invoice.batch_id, queue: @queue),
                  method: :patch,
                  local: true, id: 'aim-invoice-form',
                  class: 'aim-panel aim-metadata-form',
                  data: { controller: 'aim-reason aim-money', action: 'submit->aim-money#check' } do |form| %>
      <div class="aim-panel-header">
        <h2 class="aim-panel-title">Invoice</h2>
      </div>

      <div class="aim-form-scroll">
        <%= render 'aim/shared/frame_flash' %>
        <%# Duplicate and Sent back have chips of their own in the header (#160). %>
        <% if @invoice.review_note.present? && !%w[duplicate sent_back].include?(@invoice.review_reason) %>
          <section class="aim-ticket is-folded" data-controller="aim-banner">
            <%= aim_notice_title(aim_review_reason_label(@invoice.review_reason.presence || 'note'), element: :h3) %>
            <pre><%= @invoice.review_note %></pre>
          </section>
        <% end %>

        <div class="aim-fields">
          <% if state == 'needs_split' %>
            <%= render 'aim/invoices/split_editor' %>
          <% else %>
            <% if @invoice.extracted_vendor_name.present? %>
              <div class="aim-field-row">
                <div class="aim-field">
                  <%= label_tag 'aim_extracted_vendor_name', aim_field_label('extracted_vendor_name') %>
                  <%= text_field_tag 'aim_extracted_vendor_name', @invoice.extracted_vendor_name,
                                     readonly: true, class: 'aim-readonly-field' %>
                </div>
              </div>
            <% end %>

            <% (Aim::Invoice::EDITABLE_FIELDS + %w[submitter]).each do |field| %>
              <div class="aim-field-row">
                <div class="aim-field">
                  <%= form.label "invoice[#{field}]", aim_field_label(field) + (Aim::Invoice::REQUIRED_FOR_A_USER.key?(field) || field == 'document_type' ? ' *' : '') %>
                  <% if field == 'document_type' %>
                    <%= form.select "invoice[#{field}]",
                                    options_for_select(Aim::Invoice::DOCUMENT_TYPES, @invoice.document_type),
                                    { include_blank: 'Not set' }, disabled: @read_only %>
                  <% elsif field == 'notes' %>
                    <%= form.text_area "invoice[#{field}]", value: @invoice.notes, rows: 3, disabled: @read_only %>
                  <% elsif field == 'submitter' %>
                    <%= text_field_tag 'aim_submitter', @invoice.submitter, readonly: true, class: 'aim-readonly-field',
                                       title: 'Who sent the invoice in; it stays as recorded' %>
                  <% else %>
                    <%# An amount is checked before the form is sent (aim-money, #166). %>
                    <%= form.text_field "invoice[#{field}]",
                                        value: @invoice.typed_value(field),
                                        disabled: @read_only,
                                        data: (Aim::Invoice::MONEY_FIELDS.include?(field) ? { aim_money_target: 'field', label: aim_field_label(field) } : {}) %>
                  <% end %>
                </div>
                <% unless @read_only || %w[document_type notes submitter].include?(field) %>
                  <button type="button"
                          class="btn secondary compact btn-ocr"
                          data-ocr-target-name="invoice[<%= field %>]">OCR</button>
                <% end %>
              </div>
            <% end %>

            <% if @invoice.review_reason == 'unknown_vendor' && !@read_only %>
              <section class="aim-vendor-review">
                <div class="aim-vendor-review-fields">
                  <div class="aim-field">
                    <%= label_tag 'normalized_vendor', 'Match to Official Vendor Name' %>
                    <%= select_tag 'normalized_vendor',
                                   options_for_select([['Select official vendor', '']] + @official_vendor_names.map { |name| [name, name] }, @invoice.vendor_name),
                                   id: 'aim-official-vendor-select', class: 'aim-vendor-select',
                                   data: { controller: 'aim-grouped-search', aim_grouped_search_placeholder_value: 'Type part of the vendor name…' } %>
                  </div>
                  <div class="aim-field-row">
                    <div class="aim-field">
                      <%= label_tag 'normalized_vendor_new', 'New Official Vendor Name' %>
                      <%= text_field_tag 'normalized_vendor_new', nil, autocomplete: 'off',
                                         placeholder: 'Type only when adding a new official vendor' %>
                    </div>
                    <button type="button" class="btn secondary compact btn-ocr" data-ocr-target-name="normalized_vendor_new">OCR</button>
                  </div>
                  <div class="aim-vendor-alias-preview">
                    <span><%= @invoice.extracted_vendor_name.presence || 'Unknown vendor' %></span>
                    <span>maps to</span>
                    <span>the selected or new official vendor</span>
                  </div>
                </div>
              </section>
            <% end %>
          <% end %>
        </div>

        <%= render 'coding' unless state == 'needs_split' %>

        <%= render 'aim/shared/history', events: @events %>
      </div>

      <div class="aim-form-actions">
        <% if @read_only %>
          <div class="aim-action-group">
            <%= link_to 'Return to Queue', queue_return_path, class: 'btn' %>
          </div>
        <% else %>
          <div class="aim-action-group aim-review-action-strip">
            <% unless state == 'needs_split' %>
              <%= form.button 'Save Changes', name: 'invoice_action', value: 'save', class: 'btn secondary',
                                              data: { turbo_frame: 'aim-review-panel' } %>
            <% end %>

            <% if state == 'needs_review' %>
              <% if @invoice.review_reason == 'unknown_vendor' %>
                <%= form.button 'Learn & Retry AI', name: 'invoice_action', value: 'learn_and_retry',
                                data: { turbo_confirm: 'Save this vendor match and have the AI read the invoice again?' },
                                class: 'btn warning' %>
                <%= form.button 'Learn & Send to Approval', name: 'invoice_action', value: 'learn_and_send',
                                data: { turbo_confirm: 'Save this vendor match and send the invoice for approval?' },
                                class: 'btn approve' %>
              <% end %>
              <%= form.button 'Send to Approval', name: 'invoice_action', value: 'send_to_approval',
                              data: { turbo_confirm: 'Send this invoice to its owner for approval?' },
                              class: 'btn approve' %>
              <%= form.button 'Retry AI', name: 'invoice_action', value: 'retry_ai',
                              data: { turbo_confirm: 'Have the AI read this invoice again?' },
                              class: 'btn warning' %>
            <% elsif state == 'ready_for_approval' %>
              <% second = @invoice.needs_second_approval?(current_user&.employee_id) %>
              <%= form.button second ? 'Approve (first of two)' : 'Approve', name: 'invoice_action', value: 'approve',
                              data: { turbo_confirm: second ? "It is over the BU's amount: approve it and send it to #{@invoice.second_approval_setting.second_approver_name} for a second approval?" : 'Approve this invoice and send it to billing and Fiscal?' },
                              class: 'btn approve' %>
              <% if @invoice.awaiting_second_approval? && @invoice.second_approver?(current_user&.employee_id, staff: aim_queue_access?) %>
                <button type="button" class="btn warning" data-action="aim-reason#open"
                        data-value="return_to_first" data-commit="Return" data-title="Return to the first approver">Return to first approver</button>
              <% end %>
              <button type="button" class="btn warning" data-action="aim-reason#open"
                      data-value="send_back" data-commit="Send Back" data-title="Send back to AIM review">Send Back</button>
            <% elsif state == 'needs_split' %>
              <%= form.button 'Approve Split', name: 'invoice_action', value: 'approve_split',
                              data: {
                                turbo_confirm: 'Split this PDF into the invoices above? The AI reads each one.',
                                confirm_title: 'Approve split',
                                confirm_label: 'Approve Split'
                              },
                              class: 'btn approve' %>
              <%= form.button 'Process as One Invoice', name: 'invoice_action', value: 'process_as_one',
                              data: {
                                turbo_confirm: 'Keep this PDF as one invoice and have the AI read it?',
                                confirm_title: 'Process as one invoice',
                                confirm_label: 'Process as One'
                              },
                              class: 'btn warning' %>
            <% elsif state == 'failed' %>
              <%= form.button 'Retry AI', name: 'invoice_action', value: 'retry_ai',
                              data: { turbo_confirm: 'Have the AI read this invoice again?' },
                              class: 'btn warning' %>
              <%= form.button 'Retry Export', name: 'invoice_action', value: 'retry_export',
                              data: { turbo_confirm: 'Try sending it to billing again?' },
                              class: 'btn approve' %>
            <% end %>

            <% if aim_queue_access? && @invoice.sendable? %>
              <%# Send to a queue (#131): AIM Admins, from anywhere in the pipeline. %>
              <span data-controller="aim-reason">
                <button type="button" class="btn reassign" data-action="aim-reason#open" data-variant="approve"
                        data-value="send_to_queue" data-commit="Send" data-title="Send to a queue">Send to a queue</button>
                <%= render 'aim/invoices/send_to_queue_modal' %>
              </span>
            <% end %>
            <% if @invoice.can_move_to?('rejected') %>
              <%# Reject has its own dialog (#131): a list of reasons and guidance. %>
              <span data-controller="aim-reason">
                <button type="button" class="btn deny" data-action="aim-reason#open"
                        data-value="reject" data-commit="Reject" data-title="Reject invoice">Reject</button>
                <%= render 'aim/invoices/reject_modal' %>
              </span>
            <% end %>
            <% if @invoice.can_move_to?('deleted') && aim_queue_access? %>
              <button type="button" class="btn deny" data-action="aim-reason#open"
                      data-value="delete" data-commit="Delete" data-title="Delete invoice">Delete</button>
            <% end %>
          </div>
        <% end %>
      </div>
      <%= render 'aim/shared/reason_modal' unless @read_only %>
    <% end %>
    <% end %>
  </div>
</div>
