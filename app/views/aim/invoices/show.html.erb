<div class="aim-page aim-review-page"
     data-controller="aim-ocr"
     data-aim-ocr-pdf-url-value="<%= pdf_aim_invoice_path(@invoice_id, queue: @queue) %>">
  <header class="aim-page-header">
    <div class="aim-review-heading">
      <%= link_to 'Back to Queue', aim_invoices_path(queue: @queue), class: 'aim-kicker' %>
      <h1 class="aim-page-title"><%= @invoice_id %></h1>
      <span class="aim-page-subtitle"><%= aim_queue_label(@queue) %> review</span>
    </div>
  </header>

  <% if @read_only %>
    <div class="aim-readonly-banner" role="alert">
      <span class="aim-readonly-banner__mark" aria-hidden="true">!</span>
      <div>
        <strong>Read only — changes to this invoice cannot be saved.</strong>
        <p>
          The queue folder could not be written to. Unless this invoice was already claimed, no one
          has it reserved and someone else may open it at the same time. Review actions are hidden
          until the queue share is writable again.
        </p>
      </div>
    </div>
  <% end %>

  <div class="aim-document-layout">
    <section class="aim-panel aim-document-panel">
      <div class="aim-panel-header">
        <h2 class="aim-panel-title">Document Preview</h2>
      </div>

      <div class="aim-pdf-shell" data-pdf-url="<%= pdf_aim_invoice_path(@invoice_id, queue: @queue) %>">
        <iframe class="aim-pdf-frame"
                src="<%= "#{pdf_aim_invoice_path(@invoice_id, queue: @queue)}#zoom=page-fit" %>"
                title="Invoice PDF preview"></iframe>

        <div id="aim-ocr-canvas-viewer" class="aim-pdf-canvas-viewer">
          <div id="loading-indicator" class="aim-ocr-status">Loading OCR pages...</div>
        </div>
      </div>
    </section>

    <%= form_with url: aim_invoice_path(@invoice_id, queue: @queue),
                  method: :patch,
                  local: true,
                  class: 'aim-panel aim-metadata-form' do |form| %>
      <div class="aim-panel-header">
        <h2 class="aim-panel-title">Metadata Extraction</h2>
      </div>

      <div class="aim-form-scroll">
        <% if ['action_needed', 'low_confidence_review'].include?(@queue) && @ticket_content.present? %>
          <section class="aim-ticket">
            <h3>AI Failure Ticket</h3>
            <pre><%= @ticket_content %></pre>
          </section>
        <% end %>

        <div class="aim-fields">
          <% fields = @metadata.keys.any? ? @metadata.keys : ['BU', 'Submitter', 'VendorName', 'InvoiceTotal', 'InvoiceNumber', 'InvoiceDate', 'Status'] %>
          <% excluded_fields = ['BoundingBoxes', 'ConfidenceScores', 'OriginalText'] %>
          <% if @queue == 'vendor_review' %>
            <% excluded_fields += aim_vendor_review_hidden_fields %>

            <div class="aim-field-row">
              <div class="aim-field">
                <%= label_tag 'aim_extracted_vendor_name', 'AI-Extracted Vendor Name' %>
                <%= text_field_tag 'aim_extracted_vendor_name',
                                   @extracted_vendor_name.presence || 'Unknown vendor',
                                   readonly: true,
                                   class: 'aim-readonly-field' %>
              </div>
            </div>
          <% end %>

          <% fields.each do |key| %>
            <% next if excluded_fields.include?(key) %>

            <div class="aim-field-row">
              <div class="aim-field">
                <%= form.label "metadata[#{key}]", aim_metadata_label(key) %>

                <% if @metadata[key].is_a?(Array) && key == 'Invoices' %>
                  <div class="aim-split-summary">
                    <p>AI Suggested Splits</p>
                    <ul>
                      <% @metadata[key].each_with_index do |split, index| %>
                        <li>
                          <strong>Invoice <%= index + 1 %>:</strong>
                          Pages <%= Array(split['pages']).join(', ') %>
                          <br>
                          <span>Vendor: <%= split['vendor_name'] || 'Unknown' %>, Invoice: <%= split['invoice_number'] || 'N/A' %></span>
                        </li>
                      <% end %>
                    </ul>
                    <div class="aim-review-note">Visual splitting will be added in the next AIM integration phase.</div>
                  </div>
                <% else %>
                  <%= form.text_field "metadata[#{key}]",
                                      value: (@metadata[key].is_a?(Hash) || @metadata[key].is_a?(Array) ? @metadata[key].to_json : @metadata[key]) %>
                <% end %>
              </div>

              <% unless @metadata[key].is_a?(Array) && key == 'Invoices' %>
                <button type="button"
                        class="btn secondary compact btn-ocr"
                        data-ocr-target-name="metadata[<%= key %>]">OCR</button>
              <% end %>
            </div>
          <% end %>

          <% if @queue == 'vendor_review' %>
            <% selected_vendor_name = @metadata['NormalizedVendor'].presence %>
            <% official_vendor_options = @official_vendor_names.to_a.compact %>
            <% if selected_vendor_name.present? && official_vendor_options.exclude?(selected_vendor_name) %>
              <% official_vendor_options << selected_vendor_name %>
            <% end %>
            <% official_vendor_option_tags = [['Select official vendor', '']] %>
            <% official_vendor_options.each do |vendor_name| %>
              <% official_vendor_option_tags << [vendor_name, vendor_name] %>
            <% end %>

            <section class="aim-vendor-review">
              <div class="aim-vendor-review-fields">
                <div class="aim-field">
                  <%= form.label 'metadata[NormalizedVendor]', 'Match to Official Vendor Name' %>
                  <%= select_tag(
                    'metadata[NormalizedVendor]',
                    options_for_select(official_vendor_option_tags, selected_vendor_name),
                    id: 'aim-official-vendor-select',
                    class: 'aim-vendor-select',
                    data: { aim_vendor_select: true }
                  ) %>
                </div>

                <div class="aim-field-row">
                  <div class="aim-field">
                    <%= label_tag 'normalized_vendor_new', 'New Official Vendor Name' %>
                    <%= text_field_tag 'normalized_vendor_new',
                                       nil,
                                       autocomplete: 'off',
                                       placeholder: 'Type only when adding a new official vendor' %>
                  </div>

                  <button type="button"
                          class="btn secondary compact btn-ocr"
                          data-ocr-target-name="normalized_vendor_new">OCR</button>
                </div>

                <div class="aim-vendor-alias-preview">
                  <span><%= @extracted_vendor_name.presence || 'Unknown vendor' %></span>
                  <span>maps to</span>
                  <span>the selected or new official vendor</span>
                </div>
              </div>
            </section>
          <% end %>
        </div>
      </div>

      <div class="aim-form-actions">
        <% if @read_only %>
          <%# Nothing here can be saved, so offer the only action that works. %>
          <div class="aim-action-group">
            <%= link_to 'Return to Queue', aim_invoices_path(queue: @queue), class: 'btn' %>
          </div>
        <% else %>
          <div class="aim-action-group aim-review-action-strip">
            <%= form.submit 'Unclaim', class: 'btn ghost' %>
            <%= form.submit 'Save Changes', class: 'btn secondary' %>

            <% if @queue == 'action_needed' %>
              <%= form.submit 'Reject',
                              data: { turbo_confirm: 'Reject this invoice and send it to the rejected folder?' },
                              class: 'btn deny' %>
              <%= form.submit 'Send to Approval',
                              data: { turbo_confirm: 'Route this invoice to User Approval?' },
                              class: 'btn approve' %>
            <% elsif @queue == 'low_confidence_review' %>
              <%= form.submit 'Reject',
                              data: { turbo_confirm: 'Reject this invoice and send it to the rejected folder?' },
                              class: 'btn deny' %>
              <%= form.submit 'Send to SQL Queue',
                              data: { turbo_confirm: 'Save these XML index fields and send this folder to the SQL queue?' },
                              class: 'btn approve' %>
            <% elsif @queue == 'vendor_review' %>
              <%= form.submit 'Learn & Continue',
                              data: {
                                turbo_confirm: 'Save this alias and continue without rerunning AI vision?'
                              },
                              class: 'btn approve' %>
              <%= form.submit 'Learn & Retry AI',
                              data: {
                                turbo_confirm: 'Save this alias and send the document back through AI vision?'
                              },
                              class: 'btn warning' %>
              <%= button_tag 'Check Duplicates *',
                             type: 'button',
                             disabled: true,
                             title: 'Future AIM workflow step; not active yet.',
                             class: 'btn ghost aim-placeholder-action' %>
              <%= button_tag 'Run Vendor/BU Lookup *',
                             type: 'button',
                             disabled: true,
                             title: 'Future AIM workflow step; not active yet.',
                             class: 'btn ghost aim-placeholder-action' %>
              <%= button_tag 'Send to Manual Processing *',
                             type: 'button',
                             disabled: true,
                             title: 'Future AIM workflow step; not active yet.',
                             class: 'btn ghost aim-placeholder-action' %>
            <% end %>

            <%= link_to 'Retry AI Processing',
                        retry_aim_invoice_path(@invoice_id, queue: @queue),
                        data: {
                          turbo_method: :post,
                          turbo_confirm: 'Send this original document back to the Reprocess Queue?'
                        },
                        class: 'btn warning' %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
