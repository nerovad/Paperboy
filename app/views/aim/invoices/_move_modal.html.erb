<%# The Move dialog for a queue page: one modal, opened for the invoice whose
    Move button was pressed (aim_move_modal_controller sets the form's action
    and title). The person is found the way the COA employee lookup finds one, by employee id. %>
<div class="pb-modal-backdrop" data-aim-move-modal-target="backdrop" hidden>
  <div class="pb-modal pb-modal--dropdown" role="dialog" aria-modal="true" aria-labelledby="aim-move-title">
    <div class="pb-modal__header">
      <h3 id="aim-move-title" data-aim-move-modal-target="title">Move invoice</h3>
      <button type="button" class="pb-modal__close" data-action="aim-move-modal#close" aria-label="Close">✕</button>
    </div>
    <div class="pb-modal__body">
      <%# The action is set per invoice when the dialog opens, so the form carries
          the session's token rather than one bound to this placeholder URL. %>
      <%= form_with url: '#', method: :patch, authenticity_token: form_authenticity_token,
                    data: { aim_move_modal_target: 'form', turbo: false } do |form| %>
        <div data-aim-move-modal-target="ids"></div>
        <fieldset class="form-group aim-owner-choice" data-controller="aim-owner-choice">
          <legend>Move to</legend>
          <label><%= radio_button_tag :destination, 'person', true, data: { action: 'aim-owner-choice#update' } %> A person</label>
          <label><%= radio_button_tag :destination, 'shared', false, data: { action: 'aim-owner-choice#update' } %> The invoice's budget unit shared queue</label>
          <% unit_options = aim_move_unit_options %>
          <% if unit_options.any? %>
            <label><%= radio_button_tag :destination, 'other_unit', false, data: { action: 'aim-owner-choice#update' } %> Another budget unit's shared queue</label>
          <% end %>
          <div class="aim-owner-choice__picker" data-aim-owner-choice-target="picker">
            <%= render 'aim/shared/grouped_person_select', name: :owner, label: 'Move to',
                                                            target: 'aim-move-modal-target=person' %>
          </div>
          <% if unit_options.any? %>
            <div class="aim-owner-choice__picker" data-aim-owner-choice-target="unit" hidden>
              <%= select_tag :budget_unit, grouped_options_for_select(unit_options), include_blank: 'Pick a budget unit…',
                             aria: { label: 'Budget unit' } %>
              <p class="aim-owner-choice__note">This changes the invoice's budget unit, and so the BU that billing charges.</p>
            </div>
          <% end %>
        </fieldset>
        <div class="pb-modal__actions">
          <button type="button" class="btn" data-action="aim-move-modal#close">Cancel</button>
          <button type="submit" class="btn reassign">Move</button>
        </div>
      <% end %>
    </div>
  </div>
</div>
