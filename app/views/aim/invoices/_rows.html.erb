<%# One queue table. With `movable`, the last column is a checkbox: tick one
    invoice or several, then Move selected (aim_move_modal_controller). With
    `acknowledging` (Rejected and Deleted, #169), the same for Acknowledge
    selected (aim_acknowledge_controller), and each row has its own button. %>
<% acknowledging = local_assigns.fetch(:acknowledging, false) %>
<% viewer = session.dig(:user, 'email') || session.dig('user', 'email') %>
<%# How long each has waited where it is (#170); finished ones are not waiting. %>
<% waiting = Aim::Waiting.since(invoices) %>
<% stale_days = Aim::Waiting.stale_days %>
<table class="submission-table aim-queue-table aim-queue-table--review">
  <thead>
    <tr>
      <th>Action</th>
      <th>Vendor</th>
      <th>Invoice #</th>
      <th>Type</th>
      <th>Budget Unit</th>
      <th>Submitter</th>
      <th>Owner</th>
      <th>Date</th>
      <th>Total</th>
      <th>Status</th>
      <% if movable %>
        <th class="aim-select-cell">
          <label class="aim-select-all">
            <input type="checkbox" aria-label="Select all shown" data-action="aim-move-modal#selectAll"> Move
          </label>
        </th>
      <% end %>
      <% if acknowledging %>
        <th class="aim-select-cell">
          <label class="aim-select-all">
            <input type="checkbox" aria-label="Select all to acknowledge" data-action="aim-acknowledge#selectAll"> All
          </label>
        </th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% invoices.each do |invoice| %>
      <% badge_class, badge_text = aim_status_badge(invoice, viewer) %>
      <% locked = invoice.claimed_by_other?(viewer) %>
      <%# The batch id names the row in billing. It is too long for a column, so it rides on the row as a tooltip. %>
      <% search = [invoice.vendor_name, invoice.extracted_vendor_name, invoice.invoice_number, invoice.budget_unit,
                   invoice.submitter, invoice.assigned_to, invoice.document_type, invoice.invoice_total,
                   aim_invoice_date(invoice.invoice_date), invoice.order_number, invoice.customer_number,
                   invoice.batch_id].compact.join(' ') %>
      <tr class="<%= 'is-locked' if locked %>" title="<%= invoice.batch_id %>"
          data-aim-queue-filter-target="row" data-search="<%= search %>" data-reason="<%= aim_filter_reason(invoice) %>">
        <td class="action-buttons">
          <% if locked || invoice.terminal? %>
            <%= link_to 'View', aim_invoice_path(invoice.batch_id, queue: @queue),
                        data: { turbo: false }, class: 'btn secondary compact' %>
          <% else %>
            <%= link_to invoice.held_by?(viewer) ? 'Resume Review' : 'Open',
                        aim_invoice_path(invoice.batch_id, queue: @queue),
                        data: { turbo: false }, class: 'btn approve compact' %>
          <% end %>
          <% if invoice.acknowledgeable? && aim_queue_access? %>
            <%= button_to 'Acknowledge', acknowledge_aim_invoices_path(queue: @queue), method: :patch,
                          params: { 'ids[]' => invoice.batch_id }, form: { class: 'aim-row-form', data: { turbo: false } },
                          class: 'btn compact', title: 'Seen, and fine: take it off this list' %>
          <% end %>
        </td>
        <td class="is-strong"><%= invoice.vendor_name.presence || invoice.extracted_vendor_name.presence || 'N/A' %></td>
        <td><%= invoice.invoice_number.presence || 'N/A' %></td>
        <td><%= invoice.document_type.presence || 'N/A' %></td>
        <td><%= invoice.budget_unit.presence || 'N/A' %></td>
        <td><%= invoice.submitter.presence || 'N/A' %></td>
        <td><%= invoice.assigned_to.presence || 'Shared' %></td>
        <td><%= aim_invoice_date(invoice.invoice_date) || 'N/A' %></td>
        <td class="aim-total"><%= aim_currency(invoice.invoice_total) || 'N/A' %></td>
        <td>
          <span class="badge <%= badge_class %>"><%= badge_text %></span>
          <% if invoice.awaiting_second_approval? %><span class="badge is-scheduled">Second approval</span><% end %>
          <% if invoice.manual_entry %><span class="badge is-pending" title="The AI has not read it">Manual Data Entry Needed</span><% end %>
          <% if (started = waiting[invoice.id]) && (days = Aim::Waiting.days(started)).positive? %>
            <span class="badge <%= days >= stale_days ? 'is-denied' : 'is-scheduled' %>"
                  title="Waiting here since <%= started.strftime('%B %-d, %Y') %><%= '; stale' if days >= stale_days %>"><%= pluralize(days, 'day') %></span>
          <% end %>
          <%= aim_duplicate_pill(invoice) %>
          <% if invoice.pdf_purged_at %>
            <span class="badge is-canceled" title="Purged on <%= invoice.pdf_purged_at.strftime('%B %-d, %Y') %>">PDF purged</span>
          <% end %>
          <% if invoice.acknowledged_at %>
            <span class="badge is-scheduled" title="by <%= invoice.acknowledged_by %> on <%= invoice.acknowledged_at.strftime('%B %-d, %Y') %>">Acknowledged</span>
          <% end %>
        </td>
        <% if movable %>
          <td class="aim-select-cell">
            <input type="checkbox" value="<%= invoice.batch_id %>" data-budget-unit="<%= invoice.budget_unit %>" aria-label="Select <%= invoice.invoice_number.presence || invoice.batch_id %>"
                   data-aim-move-modal-target="check" data-action="aim-move-modal#count">
          </td>
        <% end %>
        <% if acknowledging %>
          <td class="aim-select-cell">
            <input type="checkbox" name="ids[]" value="<%= invoice.batch_id %>" form="aim-acknowledge-form"
                   aria-label="Select <%= invoice.invoice_number.presence || invoice.batch_id %>"
                   data-aim-acknowledge-target="check" data-action="aim-acknowledge#count">
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
