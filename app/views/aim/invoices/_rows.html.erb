<%# One queue table. With `movable`, each row offers Move to: another person's
    queue of the same BU, or the shared queue (Ready for Approval). %>
<% viewer = session.dig(:user, 'email') || session.dig('user', 'email') %>
<table class="submission-table aim-queue-table aim-queue-table--review">
  <thead>
    <tr>
      <th>Action</th>
      <th>Vendor</th>
      <th>Invoice #</th>
      <th>Type</th>
      <th>Budget Unit</th>
      <th>Submitter</th>
      <th>Owner</th>
      <th>Date</th>
      <th>Total</th>
      <th>Status</th>
      <% if movable %><th>Move to</th><% end %>
    </tr>
  </thead>
  <tbody>
    <% invoices.each do |invoice| %>
      <% badge_class, badge_text = aim_status_badge(invoice, viewer) %>
      <% locked = invoice.claimed_by_other?(viewer) %>
      <%# The batch id names the row in billing. It is too long for a column, so it rides on the row as a tooltip. %>
      <tr class="<%= 'is-locked' if locked %>" title="<%= invoice.batch_id %>">
        <td class="action-buttons">
          <% if locked || invoice.terminal? %>
            <%= link_to 'View', aim_invoice_path(invoice.batch_id, queue: @queue),
                        data: { turbo: false }, class: 'btn secondary compact' %>
          <% else %>
            <%= link_to invoice.held_by?(viewer) ? 'Resume Review' : 'Review Invoice',
                        aim_invoice_path(invoice.batch_id, queue: @queue),
                        data: { turbo: false }, class: 'btn approve compact' %>
          <% end %>
        </td>
        <td class="is-strong"><%= invoice.vendor_name.presence || invoice.extracted_vendor_name.presence || 'N/A' %></td>
        <td><%= invoice.invoice_number.presence || 'N/A' %></td>
        <td><%= invoice.document_type.presence || 'N/A' %></td>
        <td><%= invoice.budget_unit.presence || 'N/A' %></td>
        <td><%= invoice.submitter.presence || 'N/A' %></td>
        <td><%= invoice.assigned_to.presence || 'Shared' %></td>
        <td><%= aim_invoice_date(invoice.invoice_date) || 'N/A' %></td>
        <td class="aim-total"><%= aim_currency(invoice.invoice_total) || 'N/A' %></td>
        <td><span class="badge <%= badge_class %>"><%= badge_text %></span></td>
        <% if movable %>
          <td>
            <% choices = (@owner_choices&.fetch(invoice.budget_unit, nil) || [Aim::Invoice::SHARED_QUEUE]) - [invoice.queue_owner] %>
            <%= form_with url: reassign_aim_invoice_path(invoice.batch_id, queue: @queue), method: :patch,
                          class: 'aim-move-form', data: { turbo: false } do |form| %>
              <%= form.select :owner,
                              options_for_select(choices.map { |name| [name == Aim::Invoice::SHARED_QUEUE ? 'Shared queue' : name, name] }),
                              {}, aria: { label: "Move #{invoice.invoice_number.presence || invoice.batch_id} to" } %>
              <%= form.submit 'Move', class: 'btn reassign compact',
                              data: { turbo_confirm: 'Move this invoice to the selected queue?' } %>
            <% end %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
