<%# The Fiscal stage (item f): one list per status, as one list or grouped by
    budget unit. The Report Queue and Exported tick invoices for the report. %>
<% selectable = aim_fiscal_exportable?(@status) %>
<div class="aim-page" data-controller="aim-queue-filter">
  <header class="aim-page-header">
    <div>
      <h1 class="aim-page-title"><%= Aim::FiscalRecord::STATUS_LABELS[@status] %></h1>
      <p class="aim-page-subtitle"><%= aim_fiscal_description(@status) %></p>
    </div>
    <span class="aim-count-pill"><%= pluralize(@records.size, 'invoice') %></span>
  </header>

  <% if @records.empty? %>
    <section class="aim-panel aim-empty-state"><p>Nothing here.</p></section>
  <% else %>
    <div class="aim-people-toolbar">
      <nav class="aim-people-toolbar__views" aria-label="View">
        <%= link_to 'All', aim_fiscal_path(status: @status, view: 'all'), class: "btn compact #{@view == 'all' ? 'active' : 'ghost'}" %>
        <%= link_to 'By BU', aim_fiscal_path(status: @status, view: 'bu'), class: "btn compact #{@view == 'bu' ? 'active' : 'ghost'}" %>
      </nav>
      <%= render 'aim/invoices/search_box', placeholder: 'Search vendor, invoice #, BU, check #, pay doc, approver…' %>
    </div>

    <% if selectable %>
      <%= form_with url: aim_fiscal_export_path, method: :post, local: true, class: 'aim-fiscal-export',
                    data: { turbo: false } do %>
        <div class="aim-fiscal-export__bar">
          <button type="submit" class="btn approve compact">
            <%= @status == 'ready' ? 'Download report (CSV)' : 'Download again (CSV)' %>
          </button>
          <span class="aim-fiscal-export__hint">
            <%= @status == 'ready' ? 'Reported invoices move to Exported. Refresh after the download.' : 'They stay in Exported.' %>
          </span>
        </div>
        <%= render 'list', selectable: selectable %>
      <% end %>
    <% else %>
      <%= render 'list', selectable: selectable %>
    <% end %>
  <% end %>
</div>
