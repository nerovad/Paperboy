<%# Hold asks why. It sits inside the Fiscal form, so the reason is posted
    with it (aim_reason_controller). %>
<div class="pb-modal-backdrop" data-aim-reason-target="backdrop" hidden>
  <div class="pb-modal" role="dialog" aria-modal="true" aria-labelledby="aim-hold-title">
    <div class="pb-modal__header">
      <h3 id="aim-hold-title" data-aim-reason-target="title">Put on hold</h3>
      <button type="button" class="pb-modal__close" data-action="aim-reason#close" aria-label="Close">✕</button>
    </div>
    <div class="pb-modal__body">
      <div class="form-group">
        <label for="aim-hold-reason">Reason</label>
        <textarea id="aim-hold-reason" name="reason" class="form-control" rows="3"
                  placeholder="What is it waiting on?" data-aim-reason-target="reason" disabled></textarea>
      </div>
      <div class="pb-modal__actions">
        <button type="button" class="btn" data-action="aim-reason#close">Cancel</button>
        <button type="submit" name="commit" class="btn deny" data-aim-reason-target="submit">Hold</button>
      </div>
    </div>
  </div>
</div>
