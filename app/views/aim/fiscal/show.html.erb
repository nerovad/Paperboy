<%# The Fiscal page for one approved invoice (item f): the PDF, the invoice's
    fields and Fiscal's, all editable until archived. History opens on request. %>
<% status = @record.status %>
<% read_only = status == 'archived' %>
<%# The pay doc number comes back from VCFMS after the upload; a check number does not (DocuShare's own records, 2026-09-28). %>
<% missing = [('pay doc number' if @record.pay_doc_number.blank?)].compact %>
<%# What the invoice's agency group requires before archive (#131): Archive refuses without it. %>
<% required_missing = @record.missing_for_archive(@group).map { |field| aim_fiscal_field_label(field) } %>
<div class="aim-page aim-review-page">
  <%# The notices are chips in the header that drop down over the page, as on
      the review page (#160). %>
  <% notices = capture do %>
    <%# A duplicate that went on to Fiscal (#160), beside its original. %>
    <%= render 'aim/invoices/duplicate_banner' if @invoice.duplicate_of %>
    <% if @invoice.manual_entry %>
      <%# Straight to Fiscal (#131): Fiscal types it in; then it exports. %>
      <div class="aim-readonly-banner aim-notice-panel aim-manual-banner" role="status" id="<%= aim_notice_id('Manual Data Entry Needed') %>" hidden
           data-aim-notices-target="panel">
        <span class="aim-readonly-banner__mark" aria-hidden="true">✎</span>
        <div>
          <%= aim_notice_heading('Manual Data Entry Needed', mark: '✎', tone: :info) %>
          <p>Uploaded straight to Fiscal: type the details in from the PDF and save<%= "; still needed: #{@invoice.missing_for_a_user.to_sentence}" unless @invoice.ready_for_a_user? %>. It is billed and filed once they are in.</p>
        </div>
      </div>
    <% end %>
    <% if status == 'on_hold' && @record.hold_reason.present? %>
      <div class="aim-readonly-banner aim-notice-panel" role="alert" id="<%= aim_notice_id('On hold') %>" hidden data-aim-notices-target="panel">
        <span class="aim-readonly-banner__mark" aria-hidden="true">!</span>
        <div><%= aim_notice_heading('On hold', mark: '!') %><p><%= @record.hold_reason %></p></div>
      </div>
    <% end %>
  <% end %>
  <header class="aim-page-header aim-review-header" data-controller="aim-notices">
    <div class="aim-review-heading">
      <%= link_to 'Back to Fiscal', fiscal_return_path, class: 'aim-kicker' %>
      <h1 class="aim-page-title"><%= @invoice.vendor_name.presence || @invoice.handle %> · <%= @invoice.invoice_number %></h1>
      <%= aim_fiscal_badge(@record) %>
      <% @record.tag_list.each do |tag| %><span class="badge is-scheduled"><%= tag %></span><% end %>
      <%= render 'aim/shared/notice_chips' %>
    </div>
    <div class="aim-notice-tray"><%= notices %></div>
  </header>

  <div class="aim-document-layout">
    <%# Swap or edit the PDF here (#181), until Fiscal archives it. %>
    <% pdf_editable = Aim::PdfVersions.editable?(@invoice) %>
    <%= tag.section class: 'aim-panel aim-document-panel',
                    data: (pdf_editable ? aim_pdf_editor_data(@invoice) : {}) do %>
      <div class="aim-panel-header">
        <h2 class="aim-panel-title">Document</h2>
        <% if pdf_editable %>
          <button type="button" class="btn edit compact" data-aim-pdf-editor-target="openButton" data-action="aim-pdf-editor#open">Edit PDF</button>
          <%= render 'aim/pdf_edits/finish', invoice: @invoice, from: 'fiscal' %>
        <% end %>
      </div>
      <div class="aim-document-view" data-aim-pdf-editor-target="viewer">
      <% if @pdf_present %>
        <div class="aim-pdf-shell">
          <iframe class="aim-pdf-frame" src="<%= "#{pdf_aim_fiscal_invoice_path(@invoice.batch_id)}#zoom=page-fit" %>"
                  title="Invoice PDF"></iframe>
        </div>
      <% else %>
        <div class="aim-empty-state"><p>The PDF is not in the store.</p></div>
      <% end %>
      </div>
      <%= render 'aim/pdf_edits/workspace', invoice: @invoice, from: 'fiscal' if pdf_editable %>
    <% end %>

    <%= turbo_frame_tag 'aim-fiscal-panel', target: '_top', class: 'aim-review-frame' do %>
    <%= form_with url: aim_fiscal_invoice_path(@invoice.batch_id), method: :patch, local: true,
                  class: 'aim-panel aim-metadata-form', data: { controller: 'aim-reason' } do %>
      <div class="aim-panel-header">
        <h2 class="aim-panel-title">Fiscal</h2>
      </div>

      <div class="aim-form-scroll">
        <%= render 'aim/shared/frame_flash' %>
        <dl class="aim-fiscal-facts">
          <dt>AIM #</dt><dd title="<%= @invoice.batch_id %>"><%= @invoice.handle %></dd>
          <dt>File name</dt><dd><%= @record.title %></dd>
          <dt>Approved</dt><dd><%= @stamp || '—' %></dd>
          <dt>Stamp</dt>
          <dd><%= if @record.stamped_at then 'On the PDF'
                  elsif @record.stamp_error then "Could not be added: #{@record.stamp_error}"
                  else 'Being added; refresh in a minute' end %>
            <% if @record.stamped_at && @record.stamp_warnings.present? %>
              <span class="badge is-pending" title="The stamp layout needed a safety net on this PDF">Fitted: <%= @record.stamp_warnings %></span>
            <% end %></dd>
          <dt>Owner</dt><dd><%= @invoice.assigned_to.presence || 'Shared' %></dd>
        </dl>

        <h3 class="aim-fiscal-heading">Invoice</h3>
        <div class="aim-fields aim-fiscal-grid">
          <% Aim::FiscalRecord::INVOICE_FIELDS.each do |field| %>
            <div class="aim-field">
              <%= label_tag "invoice_#{field}", aim_field_label(field) %>
              <% if field == 'document_type' %>
                <%= select_tag "invoice[#{field}]", options_for_select(Aim::Invoice::DOCUMENT_TYPES, @invoice.document_type),
                               id: "invoice_#{field}", disabled: read_only %>
              <% elsif field == 'invoice_date' %>
                <%= date_field_tag "invoice[#{field}]", @invoice.invoice_date, id: "invoice_#{field}", disabled: read_only %>
              <% else %>
                <%= text_field_tag "invoice[#{field}]", @invoice.public_send(field), id: "invoice_#{field}", disabled: read_only %>
              <% end %>
            </div>
          <% end %>
        </div>

        <h3 class="aim-fiscal-heading">Coding</h3>
        <% if @line.warnings.present? %>
          <p class="aim-coding__help"><span class="badge is-denied">unvalidated</span> <%= @line.warnings %></p>
        <% end %>
        <%= render 'aim/shared/coding_fields', line: @line, coa: @coa, read_only: read_only %>
        <p class="aim-coding__source">
          <%= { 'rule' => 'From the coding rules.', 'person' => "Picked by #{@line.set_by}.", 'fiscal' => "Set by Fiscal (#{@line.set_by})." }[@line.source] if @line.persisted? %>
          <%= 'No coding rule matched; type it here.' if !@line.persisted? && @invoice.coded? %>
        </p>

        <h3 class="aim-fiscal-heading">Payment</h3>
        <div class="aim-fields aim-fiscal-grid">
          <% Aim::FiscalRecord::EDITABLE_FIELDS.each do |field| %>
            <div class="aim-field<%= ' aim-fiscal-grid__wide' if %w[tags description].include?(field) %>">
              <%= label_tag "fiscal_record_#{field}", aim_fiscal_field_label(field) + (@group&.required_field_list&.include?(field) ? ' (needed to archive)' : '') %>
              <% case field %>
              <% when 'tags' %>
                <%= text_field_tag 'fiscal_record[tags]', @record.tags, id: 'fiscal_record_tags', disabled: read_only,
                                   list: 'aim-fiscal-tag-suggestions', autocomplete: 'off',
                                   placeholder: 'Anything you like, separated by commas' %>
                <datalist id="aim-fiscal-tag-suggestions">
                  <% (@group&.tag_suggestion_list || Aim::FiscalRecord::TAG_SUGGESTIONS).each do |tag| %><option value="<%= tag %>"></option><% end %>
                </datalist>
              <% when 'check_date' %>
                <%= date_field_tag 'fiscal_record[check_date]', @record.check_date, id: 'fiscal_record_check_date', disabled: read_only %>
              <% when 'description' %>
                <%= text_area_tag 'fiscal_record[description]', @record.description, id: 'fiscal_record_description', rows: 2,
                                  disabled: read_only, placeholder: 'Added after the approval stamp in the report' %>
              <% else %>
                <%= text_field_tag "fiscal_record[#{field}]", @record.public_send(field), id: "fiscal_record_#{field}",
                                   disabled: read_only %>
              <% end %>
            </div>
          <% end %>
        </div>

        <% if @reports.any? %>
          <%# The saved reports this invoice was in (#131). %>
          <h3 class="aim-fiscal-heading">Reports</h3>
          <p class="aim-coding__source">
            <%= safe_join(@reports.map { |r| link_to("#{r.number} (#{r.created_at.in_time_zone.strftime('%m/%d/%Y')})", aim_fiscal_report_path(r)) }, ', ') %>
          </p>
        <% end %>

        <%= render 'aim/shared/history', events: @events %>
      </div>

      <div class="aim-form-actions">
        <div class="aim-action-group aim-review-action-strip">
          <% if read_only %>
            <%= link_to 'Back to Fiscal', fiscal_return_path, class: 'btn compact' %>
          <% else %>
            <%# As the review page (#182, #187): the second actions, Save, then the main one. %>
            <% if status == 'on_hold' %>
              <%= button_tag 'Release', name: 'fiscal_action', value: 'release', class: 'btn take-back compact' %>
            <% end %>
            <% if status == 'ready' %>
              <%= button_tag 'Back to Fiscal Queue', name: 'fiscal_action', value: 'back_to_review', class: 'btn warning compact' %>
            <% end %>
            <% if @record.can_move_to?('on_hold') %>
              <button type="button" class="btn warning compact" data-action="aim-reason#open"
                      data-value="hold" data-commit="Hold" data-title="Put on hold">Hold</button>
            <% end %>
            <%= button_tag 'Save', name: 'fiscal_action', value: 'save', class: 'btn compact',
                                   data: { turbo_frame: 'aim-fiscal-panel' } %>
            <% if @record.can_move_to?('ready') %>
              <%= button_tag 'Add to Report Queue', name: 'fiscal_action', value: 'make_ready', class: 'btn approve compact',
                                                    data: { turbo_confirm: 'Add this invoice to the Report Queue?',
                                                            confirm_label: 'Add' } %>
            <% end %>
            <% if status == 'exported' %>
              <%# Check and pay doc numbers come back after payment, so Archive is where a gap matters. %>
              <%= button_tag 'Archive', name: 'fiscal_action', value: 'archive', class: 'btn approve compact',
                                        disabled: required_missing.any?,
                                        title: ("#{@group.name} needs #{required_missing.to_sentence} before archive" if required_missing.any?),
                                        data: { turbo_confirm: missing.any? ? "There is no #{missing.join(' or ')} yet. Archive it anyway?" : 'Archive this invoice? It is finished after this.',
                                                confirm_label: 'Archive' } %>
              <% if required_missing.any? %>
                <span class="aim-fiscal-export__hint">Fill in <%= required_missing.to_sentence %> and save to archive.</span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
      <%= render 'aim/shared/reason_modal', id: 'aim-hold', title: 'Put on hold', placeholder: 'What is it waiting on?',
                                            submit: 'Hold', name: 'fiscal_action', value: 'hold',
                                            suggestions: @group&.hold_reason_list unless read_only %>
    <% end %>
    <% end %>
  </div>
</div>
