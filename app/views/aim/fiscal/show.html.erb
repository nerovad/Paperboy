<%# The Fiscal page for one approved invoice (item f): the PDF, the invoice's
    fields and Fiscal's, all editable until archived. History opens on request. %>
<% status = @record.status %>
<% read_only = status == 'archived' %>
<%# The pay doc number comes back from VCFMS after the upload; a check number does not (DocuShare's own records, 2026-09-28). %>
<% missing = [('pay doc number' if @record.pay_doc_number.blank?)].compact %>
<div class="aim-page aim-review-page">
  <header class="aim-page-header">
    <div class="aim-review-heading">
      <%= link_to 'Back to Fiscal', fiscal_return_path, class: 'aim-kicker' %>
      <h1 class="aim-page-title"><%= @invoice.vendor_name.presence || @invoice.batch_id %> · <%= @invoice.invoice_number %></h1>
      <%= aim_fiscal_badge(@record) %>
      <% @record.tag_list.each do |tag| %><span class="badge is-scheduled"><%= tag %></span><% end %>
    </div>
  </header>

  <% if status == 'on_hold' && @record.hold_reason.present? %>
    <div class="aim-readonly-banner" role="alert">
      <span class="aim-readonly-banner__mark" aria-hidden="true">!</span>
      <div><strong>On hold</strong><p><%= @record.hold_reason %></p></div>
    </div>
  <% end %>

  <div class="aim-document-layout">
    <section class="aim-panel aim-document-panel">
      <div class="aim-panel-header">
        <h2 class="aim-panel-title">Document</h2>
      </div>
      <% if @pdf_present %>
        <div class="aim-pdf-shell">
          <iframe class="aim-pdf-frame" src="<%= "#{pdf_aim_fiscal_invoice_path(@invoice.batch_id)}#zoom=page-fit" %>"
                  title="Invoice PDF"></iframe>
        </div>
      <% else %>
        <div class="aim-empty-state"><p>The PDF is not in the store.</p></div>
      <% end %>
    </section>

    <%= form_with url: aim_fiscal_invoice_path(@invoice.batch_id), method: :patch, local: true,
                  class: 'aim-panel aim-metadata-form', data: { controller: 'aim-reason' } do %>
      <div class="aim-panel-header">
        <h2 class="aim-panel-title">Fiscal</h2>
      </div>

      <div class="aim-form-scroll">
        <dl class="aim-fiscal-facts">
          <dt>File name</dt><dd><%= @record.title %></dd>
          <dt>Approved</dt><dd><%= @stamp || '—' %></dd>
          <dt>Stamp</dt>
          <dd><%= if @record.stamped_at then 'On the PDF'
                  elsif @record.stamp_error then "Could not be added: #{@record.stamp_error}"
                  else 'Being added; refresh in a minute' end %></dd>
          <dt>Owner</dt><dd><%= @invoice.assigned_to.presence || 'Shared' %></dd>
        </dl>

        <h3 class="aim-fiscal-heading">Invoice</h3>
        <div class="aim-fields aim-fiscal-grid">
          <% Aim::FiscalRecord::INVOICE_FIELDS.each do |field| %>
            <div class="aim-field">
              <%= label_tag "invoice_#{field}", aim_field_label(field) %>
              <% if field == 'document_type' %>
                <%= select_tag "invoice[#{field}]", options_for_select(Aim::Invoice::DOCUMENT_TYPES, @invoice.document_type),
                               id: "invoice_#{field}", disabled: read_only %>
              <% elsif field == 'invoice_date' %>
                <%= date_field_tag "invoice[#{field}]", @invoice.invoice_date, id: "invoice_#{field}", disabled: read_only %>
              <% else %>
                <%= text_field_tag "invoice[#{field}]", @invoice.public_send(field), id: "invoice_#{field}", disabled: read_only %>
              <% end %>
            </div>
          <% end %>
        </div>

        <h3 class="aim-fiscal-heading">Payment and coding</h3>
        <div class="aim-fields aim-fiscal-grid">
          <% Aim::FiscalRecord::EDITABLE_FIELDS.each do |field| %>
            <div class="aim-field<%= ' aim-fiscal-grid__wide' if %w[tags description].include?(field) %>">
              <%= label_tag "fiscal_record_#{field}", aim_fiscal_field_label(field) %>
              <% case field %>
              <% when 'tags' %>
                <%= text_field_tag 'fiscal_record[tags]', @record.tags, id: 'fiscal_record_tags', disabled: read_only,
                                   list: 'aim-fiscal-tag-suggestions', autocomplete: 'off',
                                   placeholder: 'Anything you like, separated by commas' %>
                <datalist id="aim-fiscal-tag-suggestions">
                  <% Aim::FiscalRecord::TAG_SUGGESTIONS.each do |tag| %><option value="<%= tag %>"></option><% end %>
                </datalist>
              <% when 'check_date' %>
                <%= date_field_tag 'fiscal_record[check_date]', @record.check_date, id: 'fiscal_record_check_date', disabled: read_only %>
              <% when 'description' %>
                <%= text_area_tag 'fiscal_record[description]', @record.description, id: 'fiscal_record_description', rows: 2,
                                  disabled: read_only, placeholder: 'Added after the approval stamp in the report' %>
              <% else %>
                <%= text_field_tag "fiscal_record[#{field}]", @record.public_send(field), id: "fiscal_record_#{field}",
                                   disabled: read_only %>
              <% end %>
            </div>
          <% end %>
        </div>

        <% if @events.present? %>
          <details class="aim-fiscal-history">
            <summary>History (<%= @events.size %>)</summary>
            <ul>
              <% @events.each do |event| %>
                <li>
                  <%= event.created_at.in_time_zone.strftime('%m/%d/%y %H:%M') %>
                  <% if event.to_state.present? %>
                    <%= event.from_state.present? ? "#{aim_state_label(event.from_state)} → " : '' %><%= aim_state_label(event.to_state) %>
                  <% end %>
                  by <%= event.actor %><%= " — #{event.note}" if event.note.present? %>
                </li>
              <% end %>
            </ul>
          </details>
        <% end %>
      </div>

      <div class="aim-form-actions">
        <div class="aim-action-group aim-review-action-strip">
          <% if read_only %>
            <%= link_to 'Back to Fiscal', fiscal_return_path, class: 'btn' %>
          <% else %>
            <%= submit_tag 'Save', class: 'btn secondary' %>
            <% if @record.can_move_to?('ready') %>
              <%= submit_tag 'Add to Report Queue', class: 'btn approve',
                                                    data: { turbo_confirm: 'Add this invoice to the Report Queue?',
                                                            confirm_label: 'Add' } %>
            <% end %>
            <% if status == 'on_hold' %>
              <%= submit_tag 'Release', class: 'btn take-back' %>
            <% end %>
            <% if status == 'ready' %>
              <%= submit_tag 'Back to Fiscal Queue', class: 'btn warning' %>
            <% end %>
            <% if @record.can_move_to?('on_hold') %>
              <button type="button" class="btn warning" data-action="aim-reason#open"
                      data-commit="Hold" data-title="Put on hold">Hold</button>
            <% end %>
            <% if status == 'exported' %>
              <%# Check and pay doc numbers come back after payment, so Archive is where a gap matters. %>
              <%= submit_tag 'Archive', class: 'btn approve',
                                        data: { turbo_confirm: missing.any? ? "There is no #{missing.join(' or ')} yet. Archive it anyway?" : 'Archive this invoice? It is finished after this.',
                                                confirm_label: 'Archive' } %>
            <% end %>
          <% end %>
        </div>
      </div>
      <%= render 'hold_modal' unless read_only %>
    <% end %>
  </div>
</div>
