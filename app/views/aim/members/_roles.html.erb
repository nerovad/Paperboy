<%# A person's budget units and their role in each (item a.2). The home unit
    comes from GSABSS and cannot be taken away; the rest are granted here.
    AIM Admin is the aim_admin group, set in ACL. %>
<%# AIM admins change everything; a BU Admin adds and takes away their own BUs only. %>
<% full = aim_managed_units.nil? %>
<% mine = ->(unit) { full || aim_managed_units.include?(unit) } %>
<% rows = @budget_units.index_by(&:budget_unit) %>
<% extra = @budget_units.reject { |row| row.budget_unit == @home_unit } %>
<h2 class="aim-profile-heading" id="roles">Roles &amp; budget units</h2>
<section class="aim-panel aim-profile-roles">
  <table class="submission-table aim-queue-table aim-people-table">
    <thead>
      <tr>
        <th>Budget unit</th>
        <th>Role</th>
        <th title="Whether they pick up this BU's unowned invoices">Shared queue</th>
        <th class="aim-people-table__actions" aria-label="Actions"></th>
      </tr>
    </thead>
    <tbody>
      <% if @home_unit %>
        <% home_row = rows[@home_unit] %>
        <tr class="<%= 'is-hidden-unit' if home_row&.hidden %>">
          <td class="is-strong"><%= @units.label(@home_unit) %></td>
          <td><%= if home_row&.hidden then 'Hidden' elsif home_row&.bu_admin then 'BU Admin' else 'User' end %></td>
          <td><%= render 'shared_queue_cell', employee_id: @employee_id, unit: @home_unit, row: home_row, can_change: mine.call(@home_unit) %></td>
          <td class="aim-people-table__actions">
            <div class="aim-profile-roles__buttons">
              <% if !full %>
              <% elsif home_row&.hidden %>
                <%= button_to 'Show', aim_member_budget_unit_path(@employee_id, home_row), method: :patch,
                              params: { hidden: '0' }, class: 'btn compact' %>
              <% else %>
                <% if home_row&.bu_admin %>
                  <%= button_to 'Remove BU Admin', aim_member_budget_unit_path(@employee_id, home_row), method: :patch,
                                params: { bu_admin: '0' }, class: 'btn compact' %>
                <% else %>
                  <%= button_to 'Make BU Admin', aim_member_budget_units_path(@employee_id), method: :post,
                                params: { budget_unit: @home_unit, bu_admin: '1' }, class: 'btn compact' %>
                <% end %>
                <%= button_to 'Hide', home_row ? aim_member_budget_unit_path(@employee_id, home_row) : aim_member_budget_units_path(@employee_id),
                              method: home_row ? :patch : :post, params: { budget_unit: @home_unit, hidden: '1' },
                              data: { turbo_confirm: "Hide #{@home_unit} from #{name}? They will see nothing in it until it is shown again.",
                                      confirm_label: 'Hide' },
                              class: 'btn compact', title: 'Their home unit, from GSABSS: it cannot be taken away, only hidden' %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      <% extra.each do |row| %>
        <tr>
          <td class="is-strong"><%= @units.label(row.budget_unit) %></td>
          <td><%= row.bu_admin ? 'BU Admin' : 'User' %></td>
          <td><%= render 'shared_queue_cell', employee_id: @employee_id, unit: row.budget_unit, row: row, can_change: mine.call(row.budget_unit) %></td>
          <td class="aim-people-table__actions">
            <div class="aim-profile-roles__buttons">
              <% if full %>
                <%= button_to row.bu_admin ? 'Remove BU Admin' : 'Make BU Admin',
                              aim_member_budget_unit_path(@employee_id, row), method: :patch,
                              params: { bu_admin: row.bu_admin ? '0' : '1' }, class: 'btn compact' %>
              <% end %>
              <% if full || (mine.call(row.budget_unit) && !row.bu_admin) %>
                <%= button_to 'Take away', aim_member_budget_unit_path(@employee_id, row), method: :delete,
                              data: { turbo_confirm: "Take #{row.budget_unit} away from #{name}?", confirm_label: 'Take away' },
                              class: 'btn deny compact' %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @home_unit.nil? && extra.empty? %>
        <tr><td colspan="4">No budget units yet.</td></tr>
      <% end %>
    </tbody>
  </table>

  <%= form_with url: aim_member_budget_units_path(@employee_id), method: :post, local: true, class: 'aim-inline-form' do %>
    <% taken = [@home_unit, *extra.map(&:budget_unit)] %>
    <% offered = @units.all.map(&:unit).reject { |unit| taken.include?(unit) || !mine.call(unit) } %>
    <%= select_tag :budget_unit, grouped_options_for_select(@units.grouped_options(only: offered)),
                   include_blank: 'Add a budget unit…', aria: { label: 'Budget unit to add' } %>
    <% if full %>
      <label><%= check_box_tag :bu_admin, '1', false %> as BU Admin</label>
    <% end %>
    <button type="submit" class="btn approve compact">Add</button>
  <% end %>
</section>
