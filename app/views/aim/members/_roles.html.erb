<%# A person's budget units and where they are BU Admin (item a.2). The home
    unit comes from GSABSS; the rest are granted here. AIM Admin and AIM Staff
    are groups, managed under ACL. %>
<% labels = @unit_options.to_h(&:reverse) %>
<% rows = @budget_units.index_by(&:budget_unit) %>
<% extra = @budget_units.reject { |row| row.budget_unit == @home_unit } %>
<h2 class="aim-profile-heading" id="roles">Roles &amp; budget units</h2>
<section class="aim-panel aim-queue-panel">
  <table class="submission-table aim-queue-table aim-people-table">
    <thead>
      <tr>
        <th>Budget unit</th>
        <th>How</th>
        <th>BU Admin</th>
        <th class="aim-people-table__actions" aria-label="Actions"></th>
      </tr>
    </thead>
    <tbody>
      <% if @home_unit %>
        <% home_row = rows[@home_unit] %>
        <tr>
          <td class="is-strong"><%= labels.fetch(@home_unit, @home_unit) %></td>
          <td>Home unit, from GSABSS</td>
          <td>
            <% if home_row&.bu_admin %>
              <%= button_to 'BU Admin ✓', aim_member_budget_unit_path(@employee_id, home_row), method: :patch,
                            params: { bu_admin: '0' }, class: 'btn compact active',
                            title: "Stop #{name} being BU Admin of #{@home_unit}" %>
            <% else %>
              <%= button_to 'Make BU Admin', aim_member_budget_units_path(@employee_id), method: :post,
                            params: { budget_unit: @home_unit, bu_admin: '1' }, class: 'btn compact ghost' %>
            <% end %>
          </td>
          <td></td>
        </tr>
      <% end %>
      <% extra.each do |row| %>
        <tr>
          <td class="is-strong"><%= labels.fetch(row.budget_unit, row.budget_unit) %></td>
          <td>Added<%= " by #{row.granted_by}" if row.granted_by.present? %></td>
          <td>
            <%= button_to row.bu_admin ? 'BU Admin ✓' : 'Make BU Admin', aim_member_budget_unit_path(@employee_id, row),
                          method: :patch, params: { bu_admin: row.bu_admin ? '0' : '1' },
                          class: "btn compact #{row.bu_admin ? 'active' : 'ghost'}" %>
          </td>
          <td class="aim-people-table__actions">
            <%= button_to 'Take away', aim_member_budget_unit_path(@employee_id, row), method: :delete,
                          data: { turbo_confirm: "Take #{row.budget_unit} away from #{name}?", confirm_label: 'Take away' },
                          class: 'btn deny compact' %>
          </td>
        </tr>
      <% end %>
      <% if @home_unit.nil? && extra.empty? %>
        <tr><td colspan="4">No budget units yet.</td></tr>
      <% end %>
    </tbody>
  </table>

  <%= form_with url: aim_member_budget_units_path(@employee_id), method: :post, local: true, class: 'aim-inline-form' do %>
    <% taken = [@home_unit, *extra.map(&:budget_unit)] %>
    <%= select_tag :budget_unit, options_for_select(@unit_options.reject { |_, unit| taken.include?(unit) }),
                   include_blank: 'Add a budget unit…', aria: { label: 'Budget unit to add' } %>
    <label><%= check_box_tag :bu_admin, '1', false %> as BU Admin</label>
    <button type="submit" class="btn approve compact">Add</button>
  <% end %>
  <p class="aim-profile-note">AIM Admin and AIM Staff are the <code>aim_admin</code> and <code>aim_staff</code> groups, set under ACL.</p>
</section>
