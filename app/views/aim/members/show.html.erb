<% name = @employee ? "#{@employee.first_name} #{@employee.last_name}".squish : "Employee #{@employee_id}" %>
<div class="aim-page">
  <header class="aim-page-header">
    <div>
      <h1 class="aim-page-title"><%= name %>'s queue</h1>
      <p class="aim-page-subtitle">
        Employee <%= @employee_id %><%= " · Unit #{@employee.unit}" if @employee&.unit.present? %>.
        <%= 'No longer in GSABSS. ' unless @employee %>The open invoices <%= name %> owns. Move them to another person or to their budget unit's shared queue.
      </p>
    </div>
    <span class="aim-count-pill"><%= pluralize(@invoices.length, 'invoice') %></span>
  </header>

  <% if @invoices.empty? %>
    <section class="aim-panel aim-empty-state">
      <p><%= name %> owns no open invoices now.</p>
    </section>
  <% else %>
    <div data-controller="aim-move-modal" data-aim-move-modal-bulk-url-value="<%= reassign_many_aim_invoices_path %>">
      <%= render 'aim/invoices/bulk_bar' %>
      <section class="aim-panel aim-queue-panel">
        <%= render 'aim/invoices/rows', invoices: @invoices, movable: true %>
      </section>
      <%= render 'aim/invoices/move_modal' %>
    </div>
  <% end %>

  <section class="aim-panel aim-delete-panel" id="delete">
    <h2>Delete from AIM</h2>
    <% if @member.nil? %>
      <p><%= name %> works AIM through an AIM group. To end that, remove them from the group under ACL.</p>
    <% elsif @invoices.any? %>
      <p>To delete <%= name %> from AIM, move every invoice above first.</p>
    <% else %>
      <p>Deleting takes <%= name %> off the AIM list for good. Their history stays. To confirm, type their employee ID.</p>
      <%= form_with url: aim_member_path(@employee_id), method: :delete, local: true, class: 'aim-inline-form',
                    data: { turbo_confirm: "Delete #{name} from AIM? This cannot be undone.",
                            confirm_title: 'Delete from AIM', confirm_label: 'Yes, delete' } do %>
        <%= text_field_tag :confirm_employee_id, nil, placeholder: "Employee ID #{@employee_id}", autocomplete: 'off',
                           required: true, pattern: Regexp.escape(@employee_id.to_s),
                           aria: { label: "Type #{@employee_id} to confirm" } %>
        <button type="submit" class="btn deny">Delete from AIM</button>
      <% end %>
    <% end %>
  </section>

  <p><%= link_to 'Back to Users & Queues', aim_admin_path, class: 'btn compact' %></p>
</div>
