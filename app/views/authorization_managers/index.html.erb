<!-- app/views/authorization_managers/index.html.erb -->
<div class="form-header">
  <h1>Authorization Console Managers</h1>
</div>

<div class="form-wrapper authorization-console" data-controller="confirm-modal">
  <p class="help-text">
    A manager can add, edit and remove a department's authorized approvers for
    parking permits, badges and keys, and can add or remove that department's
    other managers.
  </p>

  <div class="console-filters">
    <%= form_with url: authorization_managers_path, method: :get, data: { turbo: false, controller: "auto-submit" } do %>
      <% if @departments.size > 1 %>
        <div class="filter-group" data-controller="choices">
          <label>Budget Unit</label>
          <%= select_tag :filter_department,
                options_for_select(
                  @departments.map { |d| ["#{d.department_id} - #{d.long_name}", d.department_id] },
                  @department_filter
                ),
                multiple: true,
                class: "form-control",
                data: { choices_target: "select", action: "change->auto-submit#submit", placeholder: "Budget Units with managers" } %>
        </div>
      <% end %>

      <div class="filter-group" data-controller="choices">
        <label>Manager</label>
        <%= select_tag :filter_manager,
              options_for_select(@manager_filter_options, @manager_filter),
              multiple: true,
              class: "form-control",
              data: { choices_target: "select", action: "change->auto-submit#submit", placeholder: "All Managers" } %>
      </div>
    <% end %>
  </div>

  <div class="department-header">
    <%= link_to "Back to Console", authorization_console_index_path, class: "btn" %>
  </div>

  <%# Everything below scrolls. The wrapper is a fixed-height column, so a list
      left outside this region is cut off at the bottom of the window. %>
  <div class="approvers-scroll">
  <%= form_with url: authorization_managers_path, method: :post, data: { turbo: false } do %>
    <div class="form-group" data-controller="choices">
      <%= label_tag :department_id, "Budget Unit" %>
      <%= select_tag :department_id,
            options_for_select(@departments.map { |d| ["#{d.department_id} - #{d.long_name}", d.department_id] }),
            prompt: (@departments.one? ? nil : "Select Budget Unit"),
            class: "form-control",
            required: true,
            data: { choices_target: "select" } %>
    </div>

    <div class="form-group" data-controller="choices">
      <%= label_tag :employee_id, "Employee" %>
      <%= select_tag :employee_id,
            options_for_select(@candidates.map { |e| [e[:name], e[:id]] }),
            prompt: "Select Employee",
            class: "form-control",
            required: true,
            data: { choices_target: "select", placeholder: "Search for an employee..." } %>
    </div>

    <div class="form-actions">
      <%= submit_tag "Add Manager", class: "btn approve" %>
    </div>
  <% end %>

  <div class="approvers-list">
    <% if @listed_departments.empty? %>
      <div class="empty-state">
        <p><%= @department_filter.any? || @manager_filter.any? ? "No managers match these filters." : "No managers have been assigned yet." %></p>
      </div>
    <% end %>

    <% @listed_departments.each do |department| %>
      <% managers = @managers_by_department.fetch(department.department_id.to_s, []) %>
      <div class="approver-card">
        <div class="approver-header">
          <h3><%= department.department_id %> - <%= department.long_name %></h3>
        </div>

        <div class="approvals-list">
          <% if managers.empty? %>
            <div class="approval-item">
              <div class="approval-details">No managers assigned.</div>
            </div>
          <% end %>

          <% managers.each do |manager| %>
            <% name = @employee_names[manager.employee_id] || "Employee #{manager.employee_id}" %>
            <div class="approval-item">
              <div class="approval-details">
                <strong><%= name %></strong>
                <div class="detail-row">
                  <span class="label">Added:</span>
                  <span class="value">
                    <%= manager.created_at&.strftime("%Y-%m-%d") %><%= " by #{manager.assigned_by}" if manager.assigned_by.present? %>
                  </span>
                </div>
              </div>

              <div class="approval-actions">
                <button type="button"
                        class="btn deny"
                        data-action="click->confirm-modal#open"
                        data-delete-path="<%= authorization_manager_path(manager) %>"
                        data-confirm-title="Remove Manager"
                        data-confirm-message="Remove <%= name %> as a manager of <%= department.long_name %>?">
                  Remove
                </button>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  </div>

  <%= render "shared/confirm_modal" %>
</div>
