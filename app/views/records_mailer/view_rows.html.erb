<%# app/views/records_mailer/view_rows.html.erb %>
<% sender_name = [@sender['first_name'], @sender['last_name']].compact_blank.join(' ').presence || 'A colleague' %>
<div style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  <h2 style="margin: 0 0 16px; color: #004976;"><%= @table.label %></h2>

  <p><%= sender_name %> sent you <%= pluralize(@row_count, 'row') %> from the <%= @table.label %> table in Paperboy.</p>

  <% if @note.present? %>
    <%= simple_format(@note, style: 'margin: 0 0 16px; padding: 12px 15px; background-color: #f8f9fa; border-left: 4px solid #0d6efd;') %>
  <% end %>

  <p>
    The rows are in the attached CSV (<%= @filename %>).<br>
    <strong>View:</strong> <%= @view_description %>
  </p>

  <p style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #dee2e6; color: #6c757d; font-size: 12px;">
    This is an automated message from Paperboy - Ventura County GSA.<% if @sender['email'].present? %>
    Replies go to <%= @sender['email'] %>.<% end %>
  </p>
</div>
