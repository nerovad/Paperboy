<%= render "data_runner/shared/dsl_header" %>
<%= render "data_runner/shared/hot_menu" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">Reference folder</p>
    <h2>Monthly Exports</h2>
  </div>
</div>

<% if @reference_error %>
  <section class="card">
    <p><%= @reference_error %></p>
  </section>
<% else %>
  <section class="card table-wrap">
    <table>
      <thead>
        <tr><th>Name</th><th>Type</th><th>Size</th><th>Modified</th></tr>
      </thead>
      <tbody>
        <% @reference_entries.each do |entry| %>
          <tr>
            <td><%= entry.name %></td>
            <td><%= entry.directory ? "Folder" : "File" %></td>
            <td><%= number_to_human_size(entry.size) if entry.size %></td>
            <td><%= l(entry.modified, format: :short) %></td>
          </tr>
        <% end %>
        <% if @reference_entries.empty? %>
          <tr><td colspan="4">The folder is empty.</td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
