<% percent = run.total_count.zero? ? 100 : (run.completed_count * 100.0 / run.total_count).round %>
<div class="group-run-progress" data-group-run-status="<%= run.status %>">
  <div class="group-run-progress__summary">
    <div>
      <h2><%= run.status == "queued" ? "Preparing refresh" : "#{run.completed_count} of #{run.total_count} DSLs completed" %></h2>
      <% running_dsls = run.items.select { |item| item.status == "running" }.sort_by(&:position).map(&:dsl_name) %>
      <% if running_dsls.any? %><p>Running: <strong><%= running_dsls.to_sentence %></strong></p><% end %>
      <% if run.active? %><p>You may leave this page. Processing will continue.</p><% end %>
    </div>
    <span class="group-run-progress__percent"><%= percent %>%</span>
  </div>
  <progress max="<%= run.total_count %>" value="<%= run.completed_count %>"><%= percent %>%</progress>

  <% if run.finished? %>
    <p class="group-run-progress__result <%= run.status %>">
      <%= run.status == "succeeded" ? "Refresh completed successfully." : "Refresh completed with #{run.failed_count} failed DSLs." %>
    </p>
  <% end %>

  <ol class="group-run-items">
    <% run.items.sort_by(&:position).each do |item| %>
      <li class="group-run-item <%= item.status %>">
        <span class="group-run-item__state" aria-hidden="true"><%= { "pending" => "○", "running" => "→", "succeeded" => "✓", "failed" => "✕" }.fetch(item.status) %></span>
        <span><%= item.dsl_name %></span>
        <span class="group-run-item__label">
          <%= item.status.humanize %>
          <% if item.duration_ms %>
            · <%= number_with_precision(item.duration_ms / 1000.0, precision: 1, strip_insignificant_zeros: true) %>s
          <% end %>
        </span>
      </li>
    <% end %>
  </ol>

  <% if run.active? %>
    <div class="group-run-progress__actions">
      <% if run.group_name == Billing::DataRefresh::GROUP_RUN_NAME %>
        <%= button_to "Restart interrupted refresh", restart_billing_data_refresh_path,
                      params: { run_id: run.id }, method: :post, class: "btn warning",
                      data: { turbo_confirm: "Restart this refresh? Only continue if processing was interrupted. The current run will be marked failed." } %>
      <% else %>
        <%= button_to "Restart interrupted refresh",
                      data_runner_refresh_dsl_group_path(run.group_name, restart: 1),
                      method: :post, class: "btn warning",
                      data: { turbo_confirm: "Restart this refresh? Only continue if processing was interrupted. The current run will be marked failed." } %>
      <% end %>
    </div>
  <% end %>

  <% if run.finished? %>
    <div class="group-run-progress__actions">
      <% if run.status == "failed" %>
        <% if run.group_name == Billing::DataRefresh::GROUP_RUN_NAME %>
          <%= button_to "Restart refresh", restart_billing_data_refresh_path,
                        params: { run_id: run.id }, method: :post, class: "btn approve",
                        data: { turbo_confirm: "Restart the Billing data refresh?" } %>
        <% else %>
          <%= button_to "Restart refresh", data_runner_refresh_dsl_group_path(run.group_name),
                        method: :post, class: "btn approve",
                        data: { turbo_confirm: "Restart the #{run.group_name.humanize} refresh?" } %>
        <% end %>
      <% end %>
      <%= link_to "View log", data_runner_run_path(run.run_id), class: "btn pdf" %>
      <% if run.group_name == Billing::DataRefresh::GROUP_RUN_NAME %>
        <%= link_to "Return to Billing", billing_data_refresh_path, class: "btn" %>
      <% else %>
        <%= link_to "Return to group", data_runner_root_path(group: run.group_name), class: "btn" %>
      <% end %>
    </div>
  <% end %>
</div>
