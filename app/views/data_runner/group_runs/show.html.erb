<div class="page-heading">
  <div>
    <p class="eyebrow"><%= @run.group_name == Billing::DataRefresh::GROUP_RUN_NAME ? "Billing" : "Group refresh" %></p>
    <h1><%= @run.group_name == Billing::DataRefresh::GROUP_RUN_NAME ? "Data refresh" : @run.group_name.humanize %></h1>
  </div>
  <% if @run.group_name == Billing::DataRefresh::GROUP_RUN_NAME %>
    <%= link_to "Back to Billing", billing_data_refresh_path, class: "btn" %>
  <% else %>
    <%= link_to "Back to group", data_runner_root_path(group: @run.group_name), class: "btn" %>
  <% end %>
</div>

<section class="group-run" data-controller="group-run"
         data-group-run-url-value="<%= status_data_runner_group_run_path(@run) %>">
  <div data-group-run-target="content">
    <%= render "progress", run: @run %>
  </div>
</section>
