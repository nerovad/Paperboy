<div class="page-heading">
  <div>
    <p class="eyebrow">Group refresh</p>
    <h1><%= @run.group_name.humanize %></h1>
  </div>
  <%= link_to "Back to group", data_runner_root_path(group: @run.group_name), class: "btn" %>
</div>

<section class="progress-tracker" data-controller="progress-tracker"
         data-progress-tracker-url-value="<%= status_data_runner_group_run_path(@run) %>">
  <div data-progress-tracker-target="content">
    <%= render "shared/progress_tracker", **progress_tracker_locals(@run) %>
  </div>
</section>
