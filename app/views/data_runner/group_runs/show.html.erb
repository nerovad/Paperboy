<div class="page-heading">
  <div>
    <p class="eyebrow">Group refresh</p>
    <h1><%= @run.group_name.humanize %></h1>
  </div>
  <%= link_to "Back to group", data_runner_root_path(group: @run.group_name), class: "btn" %>
</div>

<section class="group-run" data-controller="group-run"
         data-group-run-url-value="<%= status_data_runner_group_run_path(@run) %>">
  <div data-group-run-target="content">
    <%= render "progress", run: @run %>
  </div>
</section>
