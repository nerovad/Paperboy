<% title_id = "#{dsl.slug}-sop-title" %>
<div class="pb-modal-backdrop" data-sop-modal-target="backdrop"
     data-action="click->sop-modal#backdropClose" hidden>
  <div class="pb-modal" role="dialog" aria-modal="true"
       aria-labelledby="<%= title_id %>">
    <div class="pb-modal__header">
      <h3 id="<%= title_id %>"><%= dsl.sop.fetch(:title, "How to Download") %></h3>
      <button type="button" class="pb-modal__close" data-action="sop-modal#close" aria-label="Close">✕</button>
    </div>
    <div class="pb-modal__body dsl-sop">
      <% if dsl.sop[:source_system].present? %>
        <p>Download the source data from <strong><%= dsl.sop[:source_system] %></strong>.</p>
      <% end %>
      <ol>
        <% dsl.sop.fetch(:instructions).each do |instruction| %>
          <li><%= instruction %></li>
        <% end %>
      </ol>
    </div>
    <div class="pb-modal__actions">
      <button type="button" class="btn" data-action="sop-modal#close">Close</button>
      <% if dsl.sop[:reference_path].present? %>
        <%= link_to "Open", reference_data_runner_dsl_path(dsl.slug), class: "btn pdf",
                    target: "_blank", rel: "noopener" %>
      <% elsif dsl.sop[:reference_url].present? %>
        <%= link_to "Open", dsl.sop[:reference_url], class: "btn pdf",
                    target: "_blank", rel: "noopener" %>
      <% end %>
    </div>
  </div>
</div>
