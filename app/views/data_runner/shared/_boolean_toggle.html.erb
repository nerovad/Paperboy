<div class="data-refresh-boolean-toggle" role="radiogroup" aria-label="<%= aria_label %>">
  <%= radio_button_tag name, "1", checked, id: "#{id_prefix}_true",
                                            class: "data-refresh-boolean-toggle__input data-refresh-boolean-toggle__input--true" %>
  <%= label_tag "#{id_prefix}_true", "True", class: "data-refresh-boolean-toggle__option" %>
  <%= radio_button_tag name, "0", !checked, id: "#{id_prefix}_false",
                                             class: "data-refresh-boolean-toggle__input data-refresh-boolean-toggle__input--false" %>
  <%= label_tag "#{id_prefix}_false", "False", class: "data-refresh-boolean-toggle__option" %>
</div>
