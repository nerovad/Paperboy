<%= render "data_runner/shared/dsl_header" %>
<%= render "data_runner/shared/hot_menu" %>
<% if @output.kind.in?(%w[csv xlsx]) %>
  <% grid = @output.grid_table %>
  <% content_for :head do %>
    <%= javascript_include_tag "jquery3" %>
    <%= javascript_include_tag "datatables/jquery.dataTables" %>
  <% end %>
<% end %>
<% if @backup_output %>
  <div class="page-heading output-heading">
    <div class="inline-actions">
      <%= link_to "Close", backup_outputs_data_runner_dsl_path(@dsl.slug), class: "btn" %>
    </div>
  </div>
<% end %>

<% if @output.kind == "sql" %>
  <pre class="output highlighted-output"><%= syntax_highlight(@output.content, language: "sql") %></pre>
<% else %>
  <div class="output-grid">
    <section class="card output-table-wrap">
      <%= render "pfa/grid/table", columns: grid.columns, rows: grid.rows,
                 header: ->(column) { column.label },
                 cell: ->(column, row) { row[column.key] },
                 data_controller: "output-table",
                 table_class: "output-table datatable-output" %>
      <%= render "shared/series_pagination", pagy: @pagy %>
      <% if @pagy.nil? && @output.more? %>
        <div class="pagination-wrapper">
          <nav class="pagy series-nav" aria-label="Pages">
            <% if @output.page_number > 1 %>
              <%= link_to "<", output_data_runner_dsl_path(@dsl.slug, path: @output_relative_path,
                                                                      page: @output.page_number - 1),
                          aria: { label: "Previous" } %>
            <% end %>
            <%= link_to ">", output_data_runner_dsl_path(@dsl.slug, path: @output_relative_path,
                                                                    page: @output.page_number + 1),
                        aria: { label: "Next" } %>
          </nav>
          <p class="pagination-info">
            Showing <%= number_with_delimiter(@output.page_from) %>–<%= number_with_delimiter(@output.page_to) %>
          </p>
        </div>
      <% end %>
    </section>
  </div>
<% end %>

<% if @output.truncated? %>
  <p class="output-limit">
    <% if @output.kind == "sql" %>
      Preview limited to the first <%= number_with_delimiter(WorkflowOutputPresenter::MAX_TEXT_BYTES) %> characters.
    <% else %>
      Preview limited to the first <%= @output.max_rows %> rows.
    <% end %>
  </p>
<% end %>
