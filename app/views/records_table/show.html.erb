<div class="records-screen records-screen--grid" data-controller="records-export records-highlights records-email">
  <%= render "shared/work_tabs", active: :records %>

  <% toolbar = render 'records/toolbar', path: records_table_path(@table.slug), page: @page,
                      columns: @columns, filter_options: @filter_options %>

  <%# The 300A Summary totals the 300 Log, so it is reached from that table. %>
  <% if @table.slug == OshaReport.registry_slug && osha_300a_visible? %>
    <% actions = link_to 'OSHA 300A Summary', osha_300a_path, class: 'btn secondary' %>
  <% end %>

  <%= render 'records/grid', table: @table, page: @page, columns: @columns, rows: @records,
             title: @table.label, toolbar: toolbar, actions: actions, exportable: true, emailable: true,
             highlights: @highlights, highlight_counts: @highlight_counts, view_params: @view_params %>

  <%= render 'records/export_modal', table: @table, rows: @records,
             view_params: @view_params, schedules: @export_schedules %>

  <% if can_edit_record_table?(@table) %>
    <%= render 'records/highlight_rules_modal', table: @table, rules: @highlights.rules, view_params: @view_params %>
    <%= render 'records/email_modal', table: @table, rows: @records, view_params: @view_params,
               rules: @email_rules, contacts: @email_contacts, deliveries: @email_deliveries,
               open: params[:email] == 'open' %>
  <% end %>
</div>
