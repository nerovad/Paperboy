<%# app/views/report_mailer/record_export_paused.html.erb %>
<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background-color: #6c757d;
      color: white;
      padding: 20px;
      border-radius: 5px 5px 0 0;
    }
    .content {
      background-color: #f8f9fa;
      padding: 30px;
      border: 1px solid #dee2e6;
      border-top: none;
    }
    .info-box {
      background-color: white;
      border-left: 4px solid #6c757d;
      padding: 15px;
      margin: 20px 0;
    }
    .info-box h3 {
      margin-top: 0;
      color: #004976;
    }
    .footer {
      text-align: center;
      padding: 20px;
      color: #6c757d;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1 style="margin: 0;">Scheduled Export Paused</h1>
  </div>

  <div class="content">
    <p>Hello <%= @employee.first_name %>,</p>

    <p>
      Your scheduled export of <strong><%= @schedule.table_label %></strong> has been paused
      because you no longer have access to that table, or the table no longer exists. No file was sent.
    </p>

    <div class="info-box">
      <h3>Export Details</h3>
      <p><strong>Table:</strong> <%= @schedule.table_label %></p>
      <p><strong>View:</strong> <%= @schedule.view_description %></p>
      <p><strong>Schedule:</strong> <%= @schedule.schedule_description %> (Pacific Time)</p>
    </div>

    <p>
      If you should still have access, ask an administrator to restore it, then open the table under
      Records and resume the export.
    </p>
  </div>

  <div class="footer">
    <p>This is an automated message from Paperboy - Ventura County GSA</p>
    <p>Please do not reply to this email</p>
  </div>
</body>
</html>
