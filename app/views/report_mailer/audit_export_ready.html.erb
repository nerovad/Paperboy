<%# app/views/report_mailer/audit_export_ready.html.erb %>
<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background-color: #4caf50;
      color: white;
      padding: 20px;
      border-radius: 5px 5px 0 0;
    }
    .content {
      background-color: #f8f9fa;
      padding: 30px;
      border: 1px solid #dee2e6;
      border-top: none;
    }
    .info-box {
      background-color: white;
      border-left: 4px solid #0d6efd;
      padding: 15px;
      margin: 20px 0;
    }
    .info-box h3 {
      margin-top: 0;
      color: #004976;
    }
    .footer {
      text-align: center;
      padding: 20px;
      color: #6c757d;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1 style="margin: 0;">✓ Your Audit History Export is Ready</h1>
  </div>

  <div class="content">
    <p>Hello <%= @employee.first_name %>,</p>

    <p>The audit history you asked for has been compiled and is attached to this email.</p>

    <div class="info-box">
      <h3>Export Details</h3>
      <p><strong>Date Range:</strong> <%= @start_date.strftime('%B %d, %Y') %> to <%= @end_date.strftime('%B %d, %Y') %></p>
      <% @summary.each do |label, count| %>
        <p><strong><%= label %>:</strong> <%= number_with_delimiter(count) %> <%= 'entry'.pluralize(count) %></p>
      <% end %>
      <p><strong>Filename:</strong> <%= @filename %></p>
    </div>

    <p>
      <% if @filename.end_with?('.zip') %>
        The attached ZIP holds one CSV per history type — extract it and open each in your spreadsheet
        program.
      <% else %>
        The attached CSV opens directly in your spreadsheet program.
      <% end %>
      Every row names who made the change, when, and what it was before and after.
    </p>

    <p style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #dee2e6;">
      <strong>Need another export?</strong><br>
      Visit the Reports page in Paperboy to export a different date range or history type.
    </p>
  </div>

  <div class="footer">
    <p>This is an automated message from Paperboy - Ventura County GSA</p>
    <p>Please do not reply to this email</p>
  </div>
</body>
</html>
