<%# app/views/report_mailer/record_export_failed.html.erb %>
<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background-color: #dc3545;
      color: white;
      padding: 20px;
      border-radius: 5px 5px 0 0;
    }
    .content {
      background-color: #f8f9fa;
      padding: 30px;
      border: 1px solid #dee2e6;
      border-top: none;
    }
    .error-box {
      background-color: #fff3cd;
      border-left: 4px solid #dc3545;
      padding: 15px;
      margin: 20px 0;
    }
    .footer {
      text-align: center;
      padding: 20px;
      color: #6c757d;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1 style="margin: 0;">✗ Scheduled Export Failed</h1>
  </div>

  <div class="content">
    <p>Hello <%= @employee.first_name %>,</p>

    <p>We hit an error building your scheduled export. It will try again at its next run.</p>

    <div class="error-box">
      <h3>Error Details</h3>
      <p><strong>Table:</strong> <%= @schedule.table_label %></p>
      <p><strong>View:</strong> <%= @schedule.view_description %></p>
      <p><strong>Error Message:</strong></p>
      <code style="display: block; background-color: white; padding: 10px; margin-top: 10px; border: 1px solid #dee2e6;">
        <%= @error_message %>
      </code>
    </div>

    <p style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #dee2e6;">
      If this keeps happening, contact your system administrator with the error details above.
    </p>
  </div>

  <div class="footer">
    <p>This is an automated message from Paperboy - Ventura County GSA</p>
    <p>Please do not reply to this email</p>
  </div>
</body>
</html>
