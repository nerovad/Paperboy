<%# app/views/report_mailer/record_export_ready.html.erb %>
<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background-color: #4caf50;
      color: white;
      padding: 20px;
      border-radius: 5px 5px 0 0;
    }
    .content {
      background-color: #f8f9fa;
      padding: 30px;
      border: 1px solid #dee2e6;
      border-top: none;
    }
    .info-box {
      background-color: white;
      border-left: 4px solid #0d6efd;
      padding: 15px;
      margin: 20px 0;
    }
    .info-box h3 {
      margin-top: 0;
      color: #004976;
    }
    .footer {
      text-align: center;
      padding: 20px;
      color: #6c757d;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1 style="margin: 0;">✓ <%= @schedule.table_label %> Export</h1>
  </div>

  <div class="content">
    <p>Hello <%= @employee.first_name %>,</p>

    <% if @row_count.zero? %>
      <p>Your scheduled export ran, but no rows match its search and filters today. The attached CSV has the column headers only.</p>
    <% else %>
      <p>Your scheduled export is attached as a CSV.</p>
    <% end %>

    <div class="info-box">
      <h3>Export Details</h3>
      <p><strong>Table:</strong> <%= @schedule.table_label %></p>
      <p><strong>Rows:</strong> <%= @row_count %></p>
      <p><strong>View:</strong> <%= @schedule.view_description %></p>
      <p><strong>Schedule:</strong> <%= @schedule.schedule_description %> (Pacific Time)</p>
      <p><strong>Filename:</strong> <%= @filename %></p>
    </div>

    <p style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #dee2e6;">
      <strong>Want to change or stop this?</strong><br>
      Open the <%= @schedule.table_label %> table under Records in Paperboy and choose Export.
    </p>
  </div>

  <div class="footer">
    <p>This is an automated message from Paperboy - Ventura County GSA</p>
    <p>Please do not reply to this email</p>
  </div>
</body>
</html>
