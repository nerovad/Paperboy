<%# app/views/admin_tools/shared/_sidebar.html.erb
    Sidebar for the Admin Tools app. The app switcher header is shared with
    every other app; below it is one button per admin screen the current user
    is permitted to open. The list and its ACL filtering live in
    AdminToolsHelper#admin_tools_links, so order and labels stay in one place. %>
<div class="sidebar admin-tools-sidebar">
  <%= render "shared/app_switcher" %>

  <% active_key = current_admin_tool_key %>
  <% acl_groups = active_key == 'acl' ? acl_sidebar_groups : [] %>
  <nav class="admin-tools-links">
    <% admin_tools_links.each do |tool| %>
      <% if tool[:key] == 'acl' %>
        <details class="nav-group" <%= "open" if active_key == 'acl' %>>
          <summary><span class="nav-group-label"><%= tool[:label] %></span></summary>

          <details class="nav-group nav-group-nested" <%= "open" if controller_path == 'acl' && action_name == 'org_permissions' %>>
            <summary><span class="nav-group-label">Permissions</span></summary>
            <%= link_to 'Applications', acl_index_path(anchor: 'organization-permissions'), class: 'nav-link' %>

            <details class="nav-group nav-group-nested" <%= "open" if controller_path == 'acl' && action_name == 'org_permissions' %>>
              <summary><span class="nav-group-label">Application Features</span></summary>
              <% acl_sidebar_application_features.each do |feature| %>
                <%= link_to feature[:label], feature[:path], class: 'nav-link' %>
              <% end %>
            </details>
          </details>

          <%= link_to 'DAM Access Rules', acl_index_path(anchor: 'dam-access-rules'),
                      class: "nav-link#{' active' if controller_path == 'dam_access_rules'}" %>

          <details class="nav-group nav-group-nested" <%= "open" if acl_groups&.any? { |group| acl_sidebar_group_page?(group) } %>>
            <summary><span class="nav-group-label">Group Management</span></summary>
            <%= link_to 'Group Management', acl_index_path(anchor: 'group-management'), class: 'nav-link' %>
            <% acl_groups.each do |group| %>
              <%= link_to group.group_name, acl_path(group),
                          class: "nav-link#{' active' if acl_sidebar_group_page?(group)}" %>
            <% end %>
          </details>
        </details>
      <% elsif tool[:key] == 'manage_forms' %>
        <details class="nav-group" <%= "open" if active_key == 'manage_forms' %>>
          <summary><span class="nav-group-label"><%= tool[:label] %></span></summary>
          <%= link_to "Create Form", form_templates_path(create: true), class: "nav-link" %>
          <% admin_tools_form_templates.each do |template| %>
            <%= link_to template.name, edit_form_template_path(template),
                        class: "nav-link#{' active' if current_page?(edit_form_template_path(template))}" %>
          <% end %>
        </details>
      <% else %>
        <%= link_to tool[:label], tool[:path],
                    class: "nav-link#{' active' if tool[:key] == active_key}" %>
      <% end %>
    <% end %>
  </nav>
  <%= render "shared/sidebar_footer" %>
</div>
